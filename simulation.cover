    1: def _explain(commodity, district, fps_code, demand_pct, delay_days, inventory_pct,
                    baseline_daily, projected_daily, stock, stock_after_change,
                    stock_after_delay, coverage_projected, reorder_threshold, risk) -> str:
           """Deterministic, evidence-based explanation (the LLM fallback)."""
   26:     parts = []
   26:     scope = "At %s" % (fps_code or district or "the whole dataset")
   52:     parts.append("%s, a %d%% change in %s demand" % (
   26:         scope, demand_pct, commodity))
   26:     if baseline_daily is not None:
   48:         parts.append("moves projected daily consumption from %.1f to %.1f kg/day"
   24:                      % (baseline_daily, projected_daily))
   26:     if delay_days:
   14:         parts.append("and a %d-day supply delay consumes an additional "
   14:                      "%.1f kg of stock" % (delay_days,
    7:                                            (projected_daily or 0) * delay_days))
   26:     if coverage_projected is not None:
   24:         parts.append("projected inventory coverage is %.1f days" % coverage_projected)
           else:
    2:         parts.append("projected coverage cannot be calculated")
   26:     if reorder_threshold is not None and stock_after_delay is not None:
   24:         parts.append("(reorder threshold %.1f kg)" % reorder_threshold)
   26:     text = " ".join(parts) + ". This is a scenario result, not a prediction — "
   26:     if risk == "CRITICAL":
    7:         text += "the projected position is critical and requires immediate review."
   19:     elif risk == "WARNING":
   11:         text += "the projected position is a warning that warrants review."
           else:
    8:         text += "the projected position remains healthy."
   26:     return text
       
       
       # ---------------------------------------------------------------------------
       # History / detail (persisted scenarios only — real data is never changed)
       # ---------------------------------------------------------------------------
       
    1: def scenario_history(db_path: str = DEFAULT_DB_PATH, *, page: int = 1, per_page: int = 10) -> dict:
    2:     conn = open_db(db_path)
    2:     try:
    2:         total = conn.execute("SELECT COUNT(*) AS n FROM scenarios").fetchone()["n"]
    4:         rows = conn.execute(
    2:             "SELECT s.*, i.dataset_name, i.file_name, src.name AS source_name "
                   "FROM scenarios s "
                   "LEFT JOIN data_imports i ON i.id = s.data_import_id "
                   "LEFT JOIN data_sources src ON src.id = i.data_source_id "
                   "ORDER BY s.id DESC LIMIT :limit OFFSET :offset",
    2:             {"limit": per_page, "offset": (page - 1) * per_page},
               ).fetchall()
           finally:
    2:         conn.close()
       
    2:     entries = []
    5:     for row in rows:
    3:         r = dict(row)
    6:         entries.append({
    3:             "id": r["id"],
    3:             "scenario_id": r["scenario_id"],
    3:             "data_import_id": r["data_import_id"],
    3:             "dataset_name": r.get("dataset_name"),
    3:             "source_name": r.get("source_name"),
    3:             "entity_type": r.get("entity_type"),
    3:             "entity_id": r.get("entity_id"),
    3:             "commodity": r.get("commodity"),
    3:             "scenario_type": r.get("scenario_type"),
    3:             "risk": r.get("risk"),
    3:             "created_at": r["created_at"],
               })
    4:     return {"scenarios": entries, "total": total, "page": page, "per_page": per_page,
    2:             "pages": max(1, -(-total // per_page))}
       
       
    1: def scenario_detail(scenario_pk: int, db_path: str = DEFAULT_DB_PATH):
    2:     import json as _json
       
    2:     conn = open_db(db_path)
    2:     try:
    2:         row = get_scenario_by_id(conn, scenario_pk)
    2:         if row is None:
                   return None
    4:         imp = conn.execute(
    2:             "SELECT i.dataset_name, s.name AS source_name FROM data_imports i "
                   "JOIN data_sources s ON s.id = i.data_source_id WHERE i.id = :imp",
    2:             {"imp": row["data_import_id"]},
               ).fetchone()
           finally:
    2:         conn.close()
    2:     detail = dict(row)
    2:     detail["dataset_name"] = imp["dataset_name"] if imp else None
    2:     detail["source_name"] = imp["source_name"] if imp else None
    8:     for key in ("parameters", "results", "ai_interpretation"):
    6:         raw = detail.get(key)
    6:         detail[key] = _json.loads(raw) if raw else None
    2:     return detail
