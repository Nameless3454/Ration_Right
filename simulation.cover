    1: def _scope_clause(prefix: str, *, fps_code=None, district=None, commodity=None):
           """Parameterized WHERE fragment + params for entity/commodity scoping.
       
           ``prefix`` is the table alias ("t" for transactions, "i" for inventory);
           transactions are already filtered by import id by the caller.
           """
   54:     where = []
   54:     params = {}
   54:     if commodity:
   54:         where.append("LOWER(%s.commodity) = LOWER(:commodity)" % prefix)
   54:         params["commodity"] = commodity.strip()
   54:     if fps_code:
    4:         where.append("f.fps_code = :fps")
    4:         params["fps"] = fps_code.strip()
   54:     if district:
    4:         where.append("LOWER(f.district) = LOWER(:district)")
    4:         params["district"] = district.strip()
   54:     return (" AND " + " AND ".join(where)) if where else "", params
       
       
    1: def simulation_entities(import_id: int, db_path: str = DEFAULT_DB_PATH) -> dict:
           """Commodities / districts / FPS centers actually present in one import."""
    2:     conn = open_db(db_path)
    2:     try:
    8:         commodities = [r["commodity"] for r in conn.execute(
    2:             "SELECT DISTINCT commodity FROM ration_transactions "
                   "WHERE source_import_id = :imp AND commodity IS NOT NULL "
    2:             "ORDER BY commodity", {"imp": import_id})]
   10:         districts = [r["district"] for r in conn.execute(
    2:             "SELECT DISTINCT f.district FROM ration_transactions t "
                   "JOIN fps_centers f ON f.id = t.fps_center_id "
                   "WHERE t.source_import_id = :imp AND f.district IS NOT NULL "
    2:             "ORDER BY f.district", {"imp": import_id})]
   10:         fps = [r["fps_code"] for r in conn.execute(
    2:             "SELECT DISTINCT f.fps_code FROM ration_transactions t "
                   "JOIN fps_centers f ON f.id = t.fps_center_id "
                   "WHERE t.source_import_id = :imp AND f.fps_code IS NOT NULL "
    2:             "ORDER BY f.fps_code", {"imp": import_id})]
    8:         inv_commodities = [r["commodity"] for r in conn.execute(
    2:             "SELECT DISTINCT commodity FROM inventory "
                   "WHERE source_import_id = :imp AND commodity IS NOT NULL "
    2:             "ORDER BY commodity", {"imp": import_id})]
           finally:
    2:         conn.close()
    4:     for c in inv_commodities:
    2:         if c not in commodities:
                   commodities.append(c)
    2:     return {"commodities": sorted(commodities), "districts": districts, "fps": fps}
       
       
       # ---------------------------------------------------------------------------
       # Current situation (real baseline, scoped to one import)
