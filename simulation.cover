    1: def current_situation(import_id: int, db_path: str = DEFAULT_DB_PATH) -> dict:
           """Real current metrics for one import — reused from the DB, not faked.
       
           Inventory coverage reuses the Phase 5 formula (stock x 30 / monthly
           consumption) and thresholds (CRITICAL < 15 days, WARNING < 30 days).
           """
    2:     conn = open_db(db_path)
    2:     try:
    4:         inv = conn.execute(
    2:             "SELECT COALESCE(SUM(current_stock), 0) AS stock, "
                   " COALESCE(SUM(monthly_consumption), 0) AS monthly "
                   "FROM inventory WHERE source_import_id = :imp",
    2:             {"imp": import_id},
               ).fetchone()
    2:         stock, monthly = inv["stock"], inv["monthly"]
    2:         if monthly and monthly > 0:
    2:             coverage_days = round(stock * DAYS_PER_MONTH / monthly, 1)
               else:
                   coverage_days = None
       
    4:         risk_items = conn.execute(
    2:             "SELECT COALESCE(f.fps_code, 'Unknown') AS fps_code, "
                   " f.district, i.commodity, i.current_stock, i.monthly_consumption, "
                   " i.reorder_threshold "
                   "FROM inventory i LEFT JOIN fps_centers f ON f.id = i.fps_center_id "
                   "WHERE i.source_import_id = :imp ORDER BY i.current_stock",
    2:             {"imp": import_id},
               ).fetchall()
    2:         high_risk_fps = set()
    2:         high_risk_districts = set()
    2:         risk_levels = []
    6:         for r in risk_items:
    4:             days = None
    4:             if r["monthly_consumption"] and r["monthly_consumption"] > 0:
    4:                 days = r["current_stock"] * DAYS_PER_MONTH / r["monthly_consumption"]
    8:             below_threshold = (r["reorder_threshold"] is not None
    4:                                and r["current_stock"] < r["reorder_threshold"])
    4:             if days is not None and days < INVENTORY_CRITICAL_DAYS or below_threshold:
                       high_risk_fps.add(r["fps_code"])
                       if r["district"]:
                           high_risk_districts.add(r["district"])
                       risk_levels.append({
                           "fps_code": r["fps_code"], "district": r["district"],
                           "commodity": r["commodity"], "current_stock": r["current_stock"],
                           "days_remaining": round(days, 1) if days is not None else None,
                           "reorder_threshold": r["reorder_threshold"],
                       })
       
    4:         tx = conn.execute(
    2:             "SELECT COUNT(*) AS n, COALESCE(SUM(quantity), 0) AS qty, "
                   " MIN(transaction_date) AS d0, MAX(transaction_date) AS d1 "
                   "FROM ration_transactions WHERE source_import_id = :imp",
    2:             {"imp": import_id},
               ).fetchone()
           finally:
    2:         conn.close()
       
    2:     daily = round(monthly / DAYS_PER_MONTH, 2) if monthly else 0.0
    2:     return {
    2:         "inventory_stock_kg": round(stock, 2),
    2:         "monthly_consumption_kg": round(monthly, 2),
    2:         "average_daily_consumption_kg": daily,
    2:         "estimated_coverage_days": coverage_days,
    2:         "high_risk_fps": sorted(high_risk_fps),
    2:         "high_risk_districts": sorted(high_risk_districts),
    2:         "risk_items": risk_levels,
    2:         "transaction_count": tx["n"],
    2:         "total_quantity_kg": round(tx["qty"], 2),
    2:         "date_range": [tx["d0"], tx["d1"]] if tx["d0"] else None,
           }
       
       
