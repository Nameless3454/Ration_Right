    2:                     "required for a reliable forecast." % (months, MIN_FORECAST_PERIODS))
                   else:
                       enabled, reason = False, "Unknown analysis type."
   30:             types.append({"key": key, "label": t["label"], "kind": t["kind"],
   15:                           "enabled": enabled, "reason": reason})
           finally:
    4:         conn.close()
       
    6:     return {"ok": True, "dataset": dataset, "checks": checks, "types": types,
    3:             "generated_at": _now_iso()}
       
       
       # ---------------------------------------------------------------------------
       # Deterministic per-import insights (calculated, not AI)
