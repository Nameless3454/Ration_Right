    1:             ).fetchone()["n"]
    3:             inventory_count = conn.execute(
    1:                 "SELECT COUNT(*) AS n FROM inventory WHERE source_import_id = :imp",
    1:                 {"imp": data_import_id},
    1:             ).fetchone()["n"]
    3:             months = conn.execute(
    1:                 "SELECT COUNT(DISTINCT substr(transaction_date, 1, 7)) AS n "
                       "FROM ration_transactions WHERE source_import_id = :imp "
                       "AND transaction_date IS NOT NULL",
    1:                 {"imp": data_import_id},
    1:             ).fetchone()["n"]
    1:             dataset = {
    1:                 "dataset_name": imp.get("dataset_name"),
    1:                 "source_name": imp.get("source_name"),
    1:                 "data_import_id": data_import_id,
    1:                 "record_count": record_count,
    1:                 "valid_records": valid_count,
    1:                 "invalid_records": imp.get("failed_records") or 0,
    1:                 "duplicates": imp.get("duplicate_records") or 0,
    1:                 "transaction_count": tx_count,
    1:                 "inventory_count": inventory_count,
    1:                 "historical_months": months,
    1:                 "quality": round(valid_count / record_count * 100, 1) if record_count else None,
                   }
               else:
    4:             tx_count = len(_filter_synthetic(
    2:                 load_dataset(DEFAULT_DATASET_PATH)["transactions"], {}
                   ))
    2:             coords = tx_count  # the synthetic dataset always carries coordinates
    2:             inventory_count = 0
    8:             months = conn.execute(
    2:                 "SELECT COUNT(DISTINCT substr(transaction_date, 1, 7)) AS n "
                       "FROM ration_transactions WHERE source_import_id = :imp",
    2:                 {"imp": _synthetic_import_id(conn)},
    4:             ).fetchone()["n"] if _synthetic_import_id(conn) else 0
    2:             dataset = {
    2:                 "dataset_name": "Synthetic Demo Dataset",
    2:                 "source_name": "Synthetic Demo Dataset",
    2:                 "data_import_id": None,
    2:                 "record_count": tx_count,
    2:                 "valid_records": tx_count,
    2:                 "invalid_records": 0,
    2:                 "duplicates": 0,
    2:                 "transaction_count": tx_count,
    2:                 "inventory_count": 0,
    2:                 "historical_months": months,
    2:                 "quality": 100.0,
                   }
       
    3:         checks = {
    3:             "dataset_available": {"ok": True, "detail": dataset["dataset_name"]},
    6:             "valid_records": {"ok": dataset["valid_records"] > 0,
    3:                               "detail": "%d valid record(s)" % dataset["valid_records"]},
    6:             "sufficient_transactions": {"ok": tx_count >= MIN_TRANSACTIONS_FOR_AGENTS,
    6:                                         "detail": "%d transaction(s); %d required for agent analysis"
