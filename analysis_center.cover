    1: def _filter_synthetic(transactions: list, filters: dict) -> list:
           """Apply commodity/date filters to the synthetic transaction list."""
    5:     commodity = (filters.get("commodity") or "").strip().lower()
    5:     from_date = (filters.get("from_date") or "").strip()
    5:     to_date = (filters.get("to_date") or "").strip()
    5:     out = []
  130:     for tx in transactions:
  125:         if commodity and (tx.get("ration_type") or "").strip().lower() != commodity:
   10:             continue
  115:         ts = (tx.get("timestamp") or "")[:10]
  115:         if from_date and ts < from_date[:10]:
                   continue
  115:         if to_date and ts > to_date[:10]:
                   continue
  115:         out.append(tx)
    5:     return out
       
       
