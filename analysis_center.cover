    1: def analysis_history(db_path: str = DEFAULT_DB_PATH, *, page: int = 1, per_page: int = 10) -> dict:
    3:     conn = open_db(db_path)
    3:     try:
    3:         total = conn.execute("SELECT COUNT(*) AS n FROM analysis_runs").fetchone()["n"]
    6:         rows = conn.execute(
    3:             "SELECT r.*, i.dataset_name, i.file_name, s.name AS source_name "
                   "FROM analysis_runs r "
                   "LEFT JOIN data_imports i ON i.id = r.data_import_id "
                   "LEFT JOIN data_sources s ON s.id = i.data_source_id "
                   "ORDER BY r.id DESC LIMIT :limit OFFSET :offset",
    3:             {"limit": per_page, "offset": (page - 1) * per_page},
               ).fetchall()
           finally:
    3:         conn.close()
       
    3:     runs = []
    9:     for row in rows:
    6:         r = dict(row)
   12:         runs.append({
    6:             "id": r["id"],
    6:             "analysis_id": r["analysis_id"],
    6:             "dataset_mode": r["dataset_mode"],
    6:             "data_import_id": r["data_import_id"],
    6:             "dataset_name": r.get("dataset_name") or ("Synthetic Demo Dataset" if r["dataset_mode"] == "synthetic" else None),
    6:             "source_name": r.get("source_name"),
    6:             "status": r["status"],
    6:             "insight_count": r["insight_count"],
    6:             "anomaly_count": r["anomaly_count"],
    6:             "finding_count": r["finding_count"],
    6:             "case_count": r["case_count"],
    6:             "alert_count": r["alert_count"],
    6:             "analysis_types": json.loads(r["analysis_types"]) if r.get("analysis_types") else None,
    6:             "duration_ms": r.get("duration_ms"),
    6:             "created_at": r["created_at"],
    6:             "summary": r.get("summary"),
               })
    6:     return {"runs": runs, "total": total, "page": page, "per_page": per_page,
    3:             "pages": max(1, -(-total // per_page))}
       
       
    1: def analysis_detail(run_id: int, db_path: str = DEFAULT_DB_PATH):
