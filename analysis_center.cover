    3:         types = []
   18:         for t in ANALYSIS_TYPES:
   15:             key = t["key"]
   15:             if key == "distribution_anomaly":
    3:                 enabled = tx_count >= MIN_TRANSACTIONS_FOR_AGENTS
    6:                 reason = None if enabled else (
                           "Only %d transaction(s) available; at least %d required." % (
                               tx_count, MIN_TRANSACTIONS_FOR_AGENTS))
   12:             elif key == "recommendations":
    3:                 enabled = tx_count >= MIN_TRANSACTIONS_FOR_AGENTS
