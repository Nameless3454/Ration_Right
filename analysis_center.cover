    3:             tx_count = conn.execute(
    1:                 "SELECT COUNT(*) AS n FROM ration_transactions WHERE source_import_id = :imp",
    1:                 {"imp": data_import_id},
    1:             ).fetchone()["n"]
    3:             coords = conn.execute(
