    2: def _insight(insight_type, severity, title, summary, *, evidence=None,
    1:              confidence=None, recommendation=None, entity_type=None,
    1:              entity_id=None, deterministic=True, status="completed",
    1:              reason=None, source=None):
   21:     return {
   21:         "insight_type": insight_type,
   21:         "severity": severity,
   21:         "title": title,
   21:         "summary": summary,
   21:         "evidence": evidence or {},
   21:         "confidence": confidence,
   21:         "recommendation": recommendation,
   21:         "entity_type": entity_type,
   21:         "entity_id": entity_id,
   21:         "deterministic": deterministic,
   21:         "status": status,
   21:         "reason": reason,
   21:         "source": source or {},
           }
       
       
    1: def operational_risk_insights(conn, import_id: int, source: dict) -> list:
           """Per-import operational checks (failure rate / inactivity / low stock).
       
           Same documented thresholds as the Phase 5 operational alerts
           (FAILURE_RATE_THRESHOLD, NO_RECENT_DISTRIBUTION_DAYS), computed only for
           centers touched by this dataset.
           """
    3:     insights = []
       
           # 1. Elevated failure rate per FPS in this import.
    9:     for r in conn.execute(
    3:         "SELECT COALESCE(f.fps_code, 'Unknown') AS fps_code, "
               " COALESCE(SUM(CASE WHEN t.status = 'FAILED' THEN 1 ELSE 0 END), 0) AS failed, "
               " COALESCE(SUM(CASE WHEN t.status IN ('COMPLETED','FAILED') THEN 1 ELSE 0 END), 0) AS total "
               "FROM ration_transactions t LEFT JOIN fps_centers f ON f.id = t.fps_center_id "
               "WHERE t.source_import_id = :imp GROUP BY fps_code",
    3:         {"imp": import_id},
           ):
    3:         total = r["total"]
    3:         if total < FAILURE_MIN_TRANSACTIONS:
                   continue
    3:         rate = r["failed"] / total
    3:         if rate >= FAILURE_RATE_THRESHOLD:
    4:             insights.append(_insight(
    2:                 "OPERATIONAL_RISK", "MEDIUM",
    2:                 "Transaction failure rate is elevated at %s" % r["fps_code"],
    4:                 "%d of %d transactions at %s failed (%.0f%% >= %.0f%% threshold). "
    4:                 "Requires human review." % (r["failed"], total, r["fps_code"],
    2:                                             rate * 100, FAILURE_RATE_THRESHOLD * 100),
    4:                 evidence={"failed_transactions": r["failed"], "total_transactions": total,
    2:                           "failure_rate": round(rate, 4),
    2:                           "threshold": FAILURE_RATE_THRESHOLD},
    2:                 entity_type="fps_center", entity_id=r["fps_code"], source=source,
                   ))
       
           # 2. No recent distribution — reference date is this import's newest tx.
    9:     latest = conn.execute(
    3:         "SELECT MAX(transaction_date) AS d FROM ration_transactions "
    3:         "WHERE source_import_id = :imp", {"imp": import_id},
    3:     ).fetchone()["d"]
    3:     if latest:
    6:         cutoff = (datetime.fromisoformat(str(latest)[:10]) -
    3:                   timedelta(days=NO_RECENT_DISTRIBUTION_DAYS)).date().isoformat()
    6:         for r in conn.execute(
    3:             "SELECT f.id, f.fps_code, f.name, f.district, "
                   " COALESCE(SUM(CASE WHEN t.status = 'COMPLETED' THEN 1 ELSE 0 END), 0) AS completed "
                   "FROM fps_centers f LEFT JOIN ration_transactions t "
                   "  ON t.fps_center_id = f.id AND t.source_import_id = :imp "
                   "  AND substr(t.transaction_date, 1, 10) >= :cutoff "
                   "GROUP BY f.id HAVING completed = 0",
    3:             {"imp": import_id, "cutoff": cutoff},
               ):
                   insights.append(_insight(
                       "OPERATIONAL_RISK", "LOW",
                       "No recent distribution activity at %s" % r["fps_code"],
                       "No completed distribution was recorded at %s in the last %d days "
                       "(reference date %s)." % (r["fps_code"], NO_RECENT_DISTRIBUTION_DAYS, cutoff),
                       evidence={"reference_date": cutoff,
                                 "recent_days": NO_RECENT_DISTRIBUTION_DAYS},
                       entity_type="fps_center", entity_id=r["fps_code"], source=source,
                   ))
       
           # 3. Low stock from this import's inventory records.
    6:     for r in conn.execute(
    3:         "SELECT i.commodity, i.current_stock, i.reorder_threshold, "
               " COALESCE(f.fps_code, 'Unknown') AS fps_code "
               "FROM inventory i LEFT JOIN fps_centers f ON f.id = i.fps_center_id "
               "WHERE i.source_import_id = :imp AND i.reorder_threshold IS NOT NULL "
               "AND i.current_stock < i.reorder_threshold "
               "ORDER BY (i.reorder_threshold - i.current_stock) DESC",
    3:         {"imp": import_id},
           ):
               insights.append(_insight(
                   "OPERATIONAL_RISK", "HIGH",
                   "Inventory below reorder threshold at %s" % r["fps_code"],
                   "Stock of %s at %s is below the reorder threshold (%.2f < %.2f)."
                   % (r["commodity"], r["fps_code"], r["current_stock"], r["reorder_threshold"]),
                   evidence={"current_stock": r["current_stock"],
                             "reorder_threshold": r["reorder_threshold"]},
                   recommendation="Review replenishment for %s at %s." % (r["commodity"], r["fps_code"]),
                   entity_type="fps_center", entity_id=r["fps_code"], source=source,
               ))
    3:     return insights
       
       
    1: def inventory_risk_insights(conn, import_id: int, source: dict) -> list:
           """Stock-vs-consumption projection with documented thresholds.
       
           days_remaining = current_stock / (monthly_consumption / 30); CRITICAL < 15,
           WARNING < 30, else HEALTHY (same constants as Phase 5 analytics).
           """
    5:     insights = []
   14:     for r in conn.execute(
    5:         "SELECT i.commodity, i.current_stock, i.monthly_consumption, "
               " i.reorder_threshold, COALESCE(f.fps_code, 'Unknown') AS fps_code "
               "FROM inventory i LEFT JOIN fps_centers f ON f.id = i.fps_center_id "
               "WHERE i.source_import_id = :imp ORDER BY i.commodity, fps_code",
    5:         {"imp": import_id},
           ):
    4:         stock = r["current_stock"]
    4:         monthly = r["monthly_consumption"]
    4:         if monthly is None or monthly <= 0:
                   continue
    4:         days = stock / (monthly / 30.0)
    4:         if days < INVENTORY_CRITICAL_DAYS:
    4:             severity, status = "CRITICAL", "at risk of running out within %d days" % INVENTORY_CRITICAL_DAYS
               elif days < INVENTORY_WARNING_DAYS:
                   severity, status = "HIGH", "approaching the %d-day warning threshold" % INVENTORY_WARNING_DAYS
               else:
                   severity, status = "LOW", "healthy"
    8:         insights.append(_insight(
    4:             "INVENTORY_RISK", severity,
    4:             "%s stock at %s may fall below safe levels" % (r["commodity"], r["fps_code"]),
    8:             "Current stock of %s at %s covers approximately %.1f days at the "
    4:             "observed consumption rate (%s)." % (r["commodity"], r["fps_code"], days, status),
    4:             evidence={
    4:                 "current_stock": stock,
    4:                 "monthly_consumption": monthly,
    4:                 "daily_consumption": round(monthly / 30.0, 2),
    4:                 "days_remaining": round(days, 1),
    4:                 "reorder_threshold": r["reorder_threshold"],
    4:                 "critical_threshold_days": INVENTORY_CRITICAL_DAYS,
    4:                 "warning_threshold_days": INVENTORY_WARNING_DAYS,
                   },
    8:             recommendation="Initiate replenishment review for %s at %s." % (
    4:                 r["commodity"], r["fps_code"]),
    4:             entity_type="fps_center", entity_id=r["fps_code"], source=source,
               ))
    5:     return insights
       
       
    1: def demand_forecast_insights(conn, import_id: int, source: dict) -> list:
           """Deterministic linear-trend forecast per commodity.
       
           Uses each commodity's monthly totals; at least MIN_FORECAST_PERIODS months
           are required, otherwise a structured INSUFFICIENT_DATA insight is returned
           instead of a guessed forecast. The formula (least-squares slope projected
           one period) is documented and reproducible.
           """
   10:     rows = conn.execute(
    5:         "SELECT substr(transaction_date, 1, 7) AS period, commodity, "
               " SUM(quantity) AS qty "
               "FROM ration_transactions WHERE source_import_id = :imp "
               "AND transaction_date IS NOT NULL "
               "GROUP BY period, commodity ORDER BY period",
    5:         {"imp": import_id},
           ).fetchall()
    5:     by_commodity = {}
   25:     for r in rows:
   20:         by_commodity.setdefault(r["commodity"], {})[r["period"]] = r["qty"]
       
    5:     insights = []
   14:     for commodity in sorted(by_commodity):
    9:         periods = sorted(by_commodity[commodity])
    9:         if len(periods) < MIN_FORECAST_PERIODS:
   14:             insights.append(_insight(
    7:                 "DEMAND_FORECAST", "LOW",
    7:                 "Demand forecast not available for %s" % commodity,
    7:                 "Not enough history for a reliable forecast.",
   14:                 evidence={"historical_periods": len(periods),
    7:                           "required_periods": MIN_FORECAST_PERIODS},
    7:                 status="insufficient_data",
   14:                 reason="Only %d historical period(s) available for %s; at least %d "
    7:                        "are required." % (len(periods), commodity, MIN_FORECAST_PERIODS),
    7:                 entity_type="commodity", entity_id=commodity, source=source,
                   ))
    7:             continue
               # least-squares slope over index positions 0..n-1
    2:         n = len(periods)
    2:         x_mean = (n - 1) / 2.0
   12:         y_mean = sum(by_commodity[commodity][p] for p in periods) / n
   22:         num = sum((i - x_mean) * (by_commodity[commodity][p] - y_mean)
   10:                   for i, p in enumerate(periods))
   12:         den = sum((i - x_mean) ** 2 for i in range(n))
    2:         slope = num / den if den else 0.0
    2:         predicted = max(0.0, y_mean + slope * n)  # one period ahead
    2:         trend = "INCREASING" if slope > 0 else ("DECREASING" if slope < 0 else "STABLE")
               # deterministic confidence: fit quality, capped at 0.9
   12:         if den and sum((i - x_mean) ** 2 for i in range(n)) > 0:
   22:             ss_res = sum((by_commodity[commodity][p] - (y_mean + slope * (i - x_mean))) ** 2
   10:                          for i, p in enumerate(periods))
   12:             ss_tot = sum((by_commodity[commodity][p] - y_mean) ** 2 for p in periods)
    2:             r_squared = 1 - ss_res / ss_tot if ss_tot else 0.0
    2:             confidence = round(max(0.0, min(0.9, r_squared)), 2)
               else:
                   confidence = None
    4:         insights.append(_insight(
    2:             "DEMAND_FORECAST", "MEDIUM" if abs(slope) > 0 else "LOW",
    2:             "%s demand forecast for %s" % (trend.title(), commodity),
    4:             "Monthly demand for %s is projected at %.0f kg for the next period "
    2:             "(%s trend across %d observed period(s))." % (
    2:                 commodity, predicted, trend.lower(), n),
    4:             evidence={"commodity": commodity,
    2:                       "forecast_period": _next_period(periods[-1]),
    2:                       "predicted_quantity": round(predicted, 1),
    2:                       "trend": trend,
    2:                       "historical_periods": len(periods),
   22:                       "historical_basis": {p: round(by_commodity[commodity][p], 1)
   10:                                            for p in periods}},
    2:             confidence=confidence,
    4:             recommendation="Use the projected demand to plan allocation for %s."
    2:                            % commodity,
    2:             entity_type="commodity", entity_id=commodity, source=source,
               ))
    5:     if not insights:
               insights.append(_insight(
                   "DEMAND_FORECAST", "LOW", "Demand forecast not available",
                   "This dataset has no dated transactions to project demand from.",
                   status="insufficient_data",
                   reason="No historical transaction periods are available.",
                   source=source,
               ))
    5:     return insights
       
       
    1: def _next_period(period: str) -> str:
    2:     year, month = int(period[:4]), int(period[5:7])
    2:     month += 1
    2:     if month > 12:
               month, year = 1, year + 1
    2:     return "%04d-%02d" % (year, month)
       
       
       # ---------------------------------------------------------------------------
       # Run (the command center path)
       # ---------------------------------------------------------------------------
       
    1: def _source_block(dataset_block: dict, analysis_id: str) -> dict:
    6:     return {
    6:         "dataset_name": dataset_block.get("dataset_name"),
    6:         "source_name": dataset_block.get("source_name"),
