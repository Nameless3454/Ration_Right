               " COALESCE(SUM(CASE WHEN i.monthly_consumption > 0 THEN 1 ELSE 0 END), 0) AS coverage_n "
               "FROM inventory i LEFT JOIN fps_centers f ON f.id = i.fps_center_id "
               "GROUP BY district"
           ).fetchall()
  181:     coverage = {r["district"]: (r["coverage_sum"] / r["coverage_n"] if r["coverage_n"] else None)
   71:                 for r in inv}
           # Alerts per district (alerts reference FPS codes).
   39:     alert_counts = {}
   39:     alert_max = {}
  161:     fps_to_district = {
  122:         r["fps_code"]: r["district"] for r in conn.execute(
   39:             "SELECT fps_code, district FROM fps_centers WHERE district IS NOT NULL")
           }
   64:     for a in alerts:
   25:         dist = a.get("fps_district")
   25:         if not dist and a["entity_type"] == "fps_center":
    4:             dist = fps_to_district.get(a["entity_id"])
   25:         if not dist:
    4:             continue
   21:         alert_counts[dist] = alert_counts.get(dist, 0) + 1
   21:         alert_max[dist] = max(alert_max.get(dist, 0), _SEVERITY_RANK.get(a["severity"], 0))
       
   39:     out = []
   74:     for r in rows:
   35:         dist = r["district"]
   35:         cov = coverage.get(dist)
   35:         n_alerts = alert_counts.get(dist, 0)
   35:         severity = alert_max.get(dist, 0)
   35:         if severity >= 4 or (cov is not None and cov < INVENTORY_CRITICAL_DAYS):
    7:             risk = "HIGH"
   28:         elif severity >= 3 or (cov is not None and cov < INVENTORY_WARNING_DAYS):
   21:             risk = "MEDIUM"
    7:         elif n_alerts or r["n"]:
    7:             risk = "LOW"
               else:
                   risk = "LOW"
   70:         out.append({
   35:             "district": dist, "distribution_kg": round(r["qty"], 2),
   35:             "transactions": r["n"],
