    1: def _states(conn) -> list:
   78:     rows = conn.execute(
   39:         "SELECT DISTINCT state FROM fps_centers WHERE state IS NOT NULL AND state != '' "
               "ORDER BY state"
           ).fetchall()
  100:     return [r["state"] for r in rows]
       
       
    1: def _source_lineage(conn) -> list:
   78:     rows = conn.execute(
   39:         "SELECT s.id, s.name, s.type, s.status, s.last_successful_sync_at, s.last_error, "
               " (SELECT COUNT(*) FROM data_imports i WHERE i.data_source_id = s.id) AS imports "
               "FROM data_sources s ORDER BY s.id"
           ).fetchall()
  137:     return [dict(r) for r in rows]
       
       
    1: def _disclaimer(conn) -> str:
  137:     sources = [r["name"] for r in conn.execute("SELECT name FROM data_sources").fetchall()]
   78:     real = any(s != "Synthetic Demo Dataset" for s in sources)
  126:     mock = any("sample" in (s or "").lower() for s in sources)
   39:     parts = []
   39:     if real:
   38:         parts.append("Analysis based on imported dataset.")
   39:     if mock:
   11:         parts.append("Includes bundled sample data (mock/test), clearly labeled.")
   39:     if not real and sources:
               parts.append("Analysis based on synthetic demo data only.")
  115:     if any(s == "ogd_pds_resource" for s in sources):
   11:         parts.append("Government connector: CONNECTOR READY / NOT CONNECTED — no live source verified.")
   39:     return " ".join(parts) if parts else "No data sources configured."
       
       
    1: def _lineage(conn) -> dict:
   39:     import_count = conn.execute("SELECT COUNT(*) AS n FROM data_imports").fetchone()["n"]
   78:     latest_imports = conn.execute(
   39:         "SELECT i.id, i.dataset_name, i.status, i.record_count, i.successful_records, "
               " i.completed_at, s.name AS source_name "
               "FROM data_imports i LEFT JOIN data_sources s ON s.id = i.data_source_id "
               "ORDER BY i.id DESC LIMIT 5"
           ).fetchall()
   39:     analysis_count = conn.execute("SELECT COUNT(*) AS n FROM analysis_runs").fetchone()["n"]
   78:     latest_analysis = conn.execute(
   39:         "SELECT analysis_id, dataset_mode, status, insight_count, created_at "
               "FROM analysis_runs ORDER BY id DESC LIMIT 3"
           ).fetchall()
   39:     return {
   39:         "import_count": import_count,
  115:         "latest_imports": [dict(r) for r in latest_imports],
   39:         "analysis_count": analysis_count,
   80:         "latest_analysis_runs": [dict(r) for r in latest_analysis],
           }
       
       
