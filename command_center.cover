   64:     for a in alerts:
   25:         text = (a.get("recommendation") or "").strip()
   25:         if not text:
   21:             continue
    8:         actions.append({
    4:             "priority": a["severity"], "action": text,
    4:             "source": "alert", "entity": a.get("entity_id"), "alert_id": a["alert_id"],
               })
   41:     for i in insights:
    2:         if i.get("insight_type") != "RECOMMENDATION":
    2:             continue
               text = (i.get("recommendation") or i.get("title") or "").strip()
               if not text or any(x["action"] == text for x in actions):
                   continue
               actions.append({
                   "priority": i["severity"], "action": text,
                   "source": "ai", "entity": i.get("entity_id"),
                   "analysis_id": i.get("analysis_id"),
               })
   43:     actions.sort(key=lambda x: -_SEVERITY_RANK.get(x["priority"], 0))
   39:     return actions[:limit]
       
       
       # ---------------------------------------------------------------------------
       # Executive summary (AI from a compact structured context — deterministic
       # fallback; never invents; never sees raw rows)
       # ---------------------------------------------------------------------------
       
    1: def _executive_summary(payload: dict, generator=None) -> dict:
  390:     kpis = {k["key"]: k for k in payload["kpis"]}
   39:     risk = payload["risk_overview"]
  103:     top_alerts = [a for a in payload["active_alerts"]][:3]
   80:     top_insights = [i for i in payload["top_insights"]][:3]
  113:     districts = [d for d in payload["district_risk"]][:3]
   39:     quality = payload["data_quality"]
   39:     context = {
   39:         "total_distribution_kg": (kpis.get("distribution") or {}).get("value"),
   39:         "active_alerts": risk.get("total", 0),
  273:         "alert_counts": {sev: risk.get(sev.lower(), 0) for sev in
   39:                          ("critical", "high", "medium", "low")},
  192:         "top_alerts": [{"title": a.get("title"), "severity": a.get("severity"),
   89:                         "entity": a.get("entity_id")} for a in top_alerts],
  123:         "top_insights": [{"title": i.get("title"), "severity": i.get("severity"),
   43:                           "entity": i.get("entity_id")} for i in top_insights],
  222:         "top_districts": [{"district": d.get("district"), "risk": d.get("risk"),
  109:                            "alerts": d.get("alerts")} for d in districts],
   39:         "data_quality_pct": quality.get("overall"),
   39:         "freshness_status": payload["freshness"].get("status"),
   39:         "data_status_note": payload["disclaimer"],
           }
   78:     empty = (not (payload["kpis"] or [])) and risk.get("total", 0) == 0 \
               and not payload["top_insights"]
   39:     if empty:
               return {"summary": "Insufficient data to provide a reliable executive summary.",
                       "generated_by": "deterministic_fallback"}
   39:     fallback = _fallback_summary(payload)
   39:     text = maybe_generate("executive_summary", context, fallback, generator=generator)
   78:     return {"summary": text,
   39:             "generated_by": "llm" if text != fallback else "deterministic_fallback"}
       
       
    1: def _fallback_summary(payload: dict) -> str:
   39:     risk = payload["risk_overview"]
  390:     kpis = {k["key"]: k for k in payload["kpis"]}
   39:     parts = []
   39:     dist = (kpis.get("distribution") or {}).get("value")
   39:     if dist:
   35:         parts.append("Total distribution is %.0f kg in the selected window." % dist)
   39:     if risk.get("total"):
   46:         parts.append("%d active alert(s) (%d critical, %d high) require attention." % (
   23:             risk["total"], risk.get("critical", 0), risk.get("high", 0)))
  113:     high_districts = [d for d in payload["district_risk"] if d["risk"] == "HIGH"][:3]
   39:     if high_districts:
   28:         parts.append("High-risk district(s): %s." % ", ".join(
   14:             d["district"] for d in high_districts))
   39:     if payload["top_insights"]:
    4:         parts.append("Top AI insight: %s (%s)." % (
    2:             payload["top_insights"][0]["title"], payload["top_insights"][0]["severity"]))
   39:     if not parts:
    4:         return "Insufficient data to provide a reliable executive summary."
   35:     return " ".join(parts) + " This summary reflects the current monitored state and is not a prediction."
       
       
