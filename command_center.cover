               " i.commodity, i.current_stock, i.monthly_consumption, i.reorder_threshold "
   39:         "FROM inventory i LEFT JOIN fps_centers f ON f.id = i.fps_center_id" + where,
   39:         params,
           ).fetchall()
   39:     high = set()
   89:     for r in rows:
   50:         stock = r["current_stock"] or 0
   50:         monthly = r["monthly_consumption"]
   50:         if r["reorder_threshold"] is not None and stock < r["reorder_threshold"]:
   28:             high.add(r["fps_code"])
   50:         if monthly and monthly > 0 and stock / (monthly / 30.0) < INVENTORY_WARNING_DAYS:
    7:             high.add(r["fps_code"])
   39:     return sorted(high)
       
       
