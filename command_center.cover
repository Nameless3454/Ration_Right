   78:         kpis.append(_kpi("active_alerts", "Active alerts", len(alerts), "",
   39:                          "warning" if len(alerts) else "ok", len(alerts), None,
   39:                          note="OPEN + acknowledged (Phase 11)"))
   78:         kpis.append(_kpi("critical_alerts", "Critical alerts",
   39:                          risk_counts["critical"], "", "error" if risk_counts["critical"] else "ok",
   39:                          risk_counts["critical"], None))
   78:         kpis.append(_kpi("high_risk_fps", "High-risk FPS", len(high_risk_fps), "",
   39:                          "error" if high_risk_fps else "ok", len(high_risk_fps), None,
   39:                          note="coverage < %dd or below reorder threshold" % INVENTORY_WARNING_DAYS))
   39:         quality = quality_panel(db_path=db_path)
