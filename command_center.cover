           ).fetchall()
   39:     out = []
   65:     for row in rows:
   26:         a = dict(row)
   26:         if commodity and (a.get("commodity") or "") != commodity:
    1:             continue
   25:         if fps and not (a["entity_type"] == "fps_center" and a["entity_id"] == fps):
                   continue
   25:         if district and a.get("fps_district") != district:
                   continue
   25:         if state and a.get("fps_state") != state:
                   continue
   25:         out.append(a)
   39:     return out
       
       
       # ---------------------------------------------------------------------------
       # KPIs (current vs previous window, deterministic comparisons)
       # ---------------------------------------------------------------------------
       
    1: def _change_pct(current, previous):
  316:     if previous is None or current is None:
  235:         return None
   81:     if previous == 0:
   33:         return None
   48:     return round((current - previous) / previous * 100.0, 1)
       
       
    1: def _kpi(key, label, value, unit, status, current, previous=None, *, note=None):
  312:     return {
  312:         "key": key, "label": label, "value": value, "unit": unit,
  312:         "status": status, "note": note,
  312:         "comparison": {
  312:             "current": current,
  312:             "previous": previous,
  312:             "change_pct": _change_pct(current, previous),
  312:             "available": previous is not None,
               },
           }
       
       
    1: def _distribution_kpis(conn, *, from_date, to_date, prev_from, prev_to, scope_sql,
                              scope_params, filters) -> list:
   39:     clause = scope_sql
   39:     params = dict(scope_params)
       
   39:     def _sum(frm, to):
