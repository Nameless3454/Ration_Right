   39:              "ok" if cur_qty > 0 else "muted", cur_qty, prev_qty),
   39:         _kpi("transactions", "Transactions", cur_n, "", "muted", cur_n, prev_n),
           ]
       
       
    1: def _inventory_scope(scope_sql, scope_params):
           """Inventory is a point-in-time snapshot: reuse the geography/commodity
           scope but drop the date window (inventory has no transaction date)."""
   78:     where = scope_sql.replace("t.", "i.")
  324:     parts = [p.strip() for p in where.replace(" WHERE ", "", 1).split(" AND ") if p.strip()]
  324:     parts = [p for p in parts if "transaction_date" not in p]
   78:     clause = (" WHERE " + " AND ".join(parts)) if parts else ""
  324:     params = {k: v for k, v in scope_params.items() if k not in ("from_date", "to_date")}
   78:     return clause, params
       
       
    1: def _inventory_kpis(conn, *, scope_sql, scope_params) -> list:
           # Inventory is a point-in-time snapshot (no history) — comparison is not
           # available and is reported honestly as such.
   39:     where, params = _inventory_scope(scope_sql, scope_params)
   78:     row = conn.execute(
   78:         "SELECT COALESCE(SUM(i.current_stock), 0) AS stock, "
               " COALESCE(SUM(CASE WHEN i.monthly_consumption > 0 THEN "
               "   i.current_stock / (i.monthly_consumption / 30.0) END), 0) AS coverage_sum, "
               " COALESCE(SUM(CASE WHEN i.monthly_consumption > 0 THEN 1 ELSE 0 END), 0) AS coverage_n, "
               " COUNT(DISTINCT i.fps_center_id) AS centers "
   39:         "FROM inventory i LEFT JOIN fps_centers f ON f.id = i.fps_center_id" + where,
   39:         params,
           ).fetchone()
   39:     avg_coverage = (row["coverage_sum"] / row["coverage_n"]) if row["coverage_n"] else None
   39:     return [
   78:         _kpi("inventory", "Total inventory", round(row["stock"], 2), "kg",
   39:              "ok" if row["stock"] > 0 else "muted", row["stock"], None,
   39:              note="point-in-time snapshot — no historical comparison"),
   78:         _kpi("coverage", "Avg inventory coverage",
   39:              round(avg_coverage, 1) if avg_coverage is not None else None,
   39:              "days", ("warning" if avg_coverage is not None and avg_coverage < INVENTORY_WARNING_DAYS
   32:                       else "ok" if avg_coverage is not None else "muted"),
   39:              avg_coverage, None, note="current_stock / daily consumption"),
           ]
       
       
    1: def _risk_fps(conn, *, scope_sql, scope_params, filters) -> list:
