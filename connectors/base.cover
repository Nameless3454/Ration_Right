               # Reuse the Phase 3 JSON parser on the merged record list.
    1:         merged = json.dumps(records).encode("utf-8")
    1:         with tempfile.NamedTemporaryFile(suffix=".json", delete=False) as tmp:
    1:             tmp.write(merged)
    1:             path = Path(tmp.name)
    1:         try:
    1:             parsed = parsers.parse_file(path, "json")
               finally:
    1:             path.unlink(missing_ok=True)
    1:         return parsed.get("headers") or [], parsed.get("rows") or []
       
       
    1: def connector_for(profile: dict) -> DataConnector:
           """Factory: build the right connector for a profile."""
   14:     fmt = (profile.get("format") or "csv").lower()
   14:     if fmt == "json":
    1:         return JsonUrlConnector(profile)
   13:     if fmt == "csv":
   13:         return CsvUrlConnector(profile)
           raise InvalidResponseError("Unsupported connector format %r" % fmt)
