    8:         detected = mapmod.detect_mapping(headers, self.profile["dataset_type"])
    8:         mapping = mapmod.mapping_to_dict(detected["mapping"])
    8:         mappable = set(mapmod.mappable_fields(self.profile["dataset_type"]))
    8:         profile_mapping = self.profile.get("mapping") or {}
   77:         for external, internal in profile_mapping.items():
                   # Apply only when the column exists AND the target is a valid
                   # internal field for this dataset type (a bad profile entry must
                   # never break the required-field contract).
   69:             if internal not in mappable:
                       continue
  336:             for header in headers:
  336:                 if header.strip().lower() == external.strip().lower():
   69:                     mapping[header] = internal
   69:                     break
    8:         required = mapmod.required_fields(self.profile["dataset_type"])
   48:         missing = [f for f in required if f not in mapping.values()]
    8:         if missing:
                   raise MappingError(
                       "Required field(s) not present or not mapped: %s" % ", ".join(missing)
                   )
    8:         return mapping
       
           # -- validate -----------------------------------------------------------
       
    1:     def validate(self, headers: list, rows: list, mapping: dict) -> dict:
               """Run the Phase 4 validation pipeline; returns the summary."""
               return validation.summarize(rows, self.profile["dataset_type"], headers, mapping)
       
       
    2: class CsvUrlConnector(DataConnector):
    1:     """Connector for a downloadable CSV file (reuses the Phase 3 CSV parser)."""
       
    1:     format = "csv"
       
    1:     def fetch(self, fetcher, resolve_url) -> list:
   13:         return [fetcher(resolve_url(self.profile["base_url"]))]
       
    1:     def parse(self, pages: list) -> tuple:
   10:         if not pages or not pages[0]:
    1:             raise InvalidResponseError("The source returned an empty response.")
    9:         data = pages[0]
    9:         with tempfile.NamedTemporaryFile(suffix=".csv", delete=False) as tmp:
    9:             tmp.write(data)
    9:             path = Path(tmp.name)
    9:         try:
    9:             parsed = parsers.parse_file(path, "csv")
               finally:
    9:             path.unlink(missing_ok=True)
    7:         headers = parsed.get("headers") or []
    7:         rows = parsed.get("rows") or []
    7:         if not rows:
                   raise InvalidResponseError("The source returned an empty dataset (no rows).")
    7:         return headers, rows
       
       
    2: class JsonUrlConnector(DataConnector):
    1:     """Connector for a JSON API/dataset.
       
