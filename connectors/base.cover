    1:         if not pagination or pagination.get("type") != "offset":
                   return [fetcher(resolve_url(self.profile["base_url"]))]
    1:         offset_param = pagination.get("offset_param", "offset")
    1:         limit_param = pagination.get("limit_param", "limit")
    1:         page_size = int(pagination.get("page_size", 1000))
    1:         base = resolve_url(self.profile["base_url"])
    1:         sep = "&" if "?" in base else "?"
    1:         pages = []
    1:         offset = 0
    2:         while offset // page_size < MAX_PAGES:
