   15:     if last is not None:
    1:         view["last_import"] = {
    1:             "data_import_id": last["id"],
    1:             "dataset_name": last["dataset_name"],
    1:             "record_count": last["record_count"],
    1:             "successful_records": last["successful_records"],
    1:             "failed_records": last["failed_records"],
    1:             "duplicate_records": last["duplicate_records"],
    1:             "status": last["status"],
    1:             "completed_at": last["completed_at"],
