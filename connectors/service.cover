    9:     if status == "ACTIVE":
    9:         if source.get("last_successful_sync_at"):
    1:             return "CONNECTED"
    8:         if source.get("last_error"):
                   return "DISCONNECTED"
    8:         return "CONNECTED"
           return "DISCONNECTED"
       
       
