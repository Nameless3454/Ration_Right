   15:     profile = get_profile(source["name"])
   15:     if profile:
   15:         view["format"] = profile.get("format")
   15:         view["dataset_type"] = profile.get("dataset_type")
   15:         view["requires_auth"] = bool(profile.get("requires_auth"))
   15:         view["documentation_url"] = profile.get("documentation_url")
   15:         view["label"] = profile.get("label")
           # A source with a registered connector profile but no successful
           # connection is CONNECTOR_READY, not merely DISCONNECTED — the UI must
