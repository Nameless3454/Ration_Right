    1: def register_configured_sources(db_path: str = DEFAULT_DB_PATH) -> list:
           """Ensure every configured profile has a DataSource row.
       
           Idempotent: creates missing sources, refreshes their base_url/type/
           description, and marks auth-required sources that lack a key as INACTIVE
           with an actionable last_error (they remain visible but cannot sync).
           """
   60:     conn = open_db(db_path)
   60:     try:
   60:         registered = []
  180:         for profile in list_profiles():
  120:             existing = get_data_source_by_name(conn, profile["name"])
  120:             needs_key = bool(profile.get("requires_auth"))
  120:             from connectors.profiles import _ogd_api_key
  120:             has_key = not needs_key or bool(_ogd_api_key())
  120:             if existing is None:
  220:                 source_id = insert_data_source(
  110:                     conn,
  110:                     name=profile["name"],
  110:                     source_type=profile["type"],
  110:                     description=profile.get("description"),
  110:                     status="ACTIVE" if has_key else "INACTIVE",
  110:                     base_url=profile.get("base_url"),
                       )
  110:                 if not has_key:
  110:                     update_data_source_sync(
   55:                         conn, source_id, status="INACTIVE",
                               last_error=(
  110:                             "Requires an API key — set the %s environment variable "
   55:                             "server-side." % profile.get("auth_env_var")
                               ),
                           )
  110:                 registered.append(profile["name"])
                   else:
   10:                 changed = False
   10:                 if existing.get("base_url") != profile.get("base_url"):
                           conn.execute(
                               "UPDATE data_sources SET base_url = :url, updated_at = :now WHERE id = :id",
                               {"url": profile.get("base_url"), "now": _now_iso(), "id": existing["id"]},
                           )
                           changed = True
   10:                 if not has_key and existing.get("status") == "ACTIVE":
                           update_data_source_sync(
                               conn, existing["id"], status="INACTIVE",
                               last_error="Requires an API key — set the %s environment "
                                          "variable server-side." % profile.get("auth_env_var"),
                           )
                           changed = True
   10:                 if changed:
                           registered.append(profile["name"])
   60:         conn.commit()
  120:         return registered
           finally:
   60:         conn.close()
       
       
