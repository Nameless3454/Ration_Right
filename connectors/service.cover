    8:     payload = b"".join(pages)
   16:     return run_import(
    8:         conn,
    8:         file_name=profile.get("file_name") or (source["name"] + "." + (profile.get("format") or "csv")),
    8:         file_type=profile.get("format") or "csv",
    8:         dataset_name=profile.get("dataset_name") or source["name"],
    8:         source_name=source["name"],
    8:         dataset_type=profile.get("dataset_type") or "ration_transactions",
    8:         headers=headers,
    8:         rows=rows,
    8:         mapping=mapping,
    8:         file_hash=sha256_bytes(payload),
