    1: """RationAI — source profiles (Phase 7, centralized configuration).
       
       Every external data source is described ONCE here: URL, format, dataset
       type, field mapping, auth, pagination, and documentation. The database
       stores the source row (name/type/base_url/status/timestamps) and the sync
       service looks its connector profile up by name — URLs and mappings are never
       scattered through the application, and no user-supplied URL can ever be
       fetched (sync is only possible for a registered source id).
       
       Live vs sample — be honest:
       
       * ``ogd_pds_resource`` documents the OFFICIAL Government of India Open Data
         (OGD) Platform API (api.data.gov.in). It is a real, verified API that
         requires a free API key (env ``GOVERNMENT_DATA_API_KEY``). No key is
         configured in this development environment, so the connector is built and
         tested against mocked responses; a sync without the key fails cleanly with
         an actionable message instead of pretending to be live.
       
       * ``sample_open_pds`` is a SMALL BUNDLED sample served by the RationAI app
         itself (``/sample/pds_sample.csv``). It exists purely to exercise the full
         connector pipeline (real HTTP fetch -> parse -> validate -> import) and is
         clearly labelled in the UI as sample data — it is NOT government data.
       """
       
    1: from __future__ import annotations
       
    1: import os
       
       #: Env var that would hold the OGD India API key. Server-side only.
    1: OGD_API_KEY_ENV = "GOVERNMENT_DATA_API_KEY"
       
       #: Official OGD Platform India API documentation.
    1: OGD_DOC_URL = "https://www.data.gov.in/apis"
    1: OGD_API_BASE = "https://api.data.gov.in"
       
       
    1: def _ogd_api_key() -> str:
   63:     return os.environ.get(OGD_API_KEY_ENV, "").strip()
       
       
       # ---------------------------------------------------------------------------
       # Profiles
       # ---------------------------------------------------------------------------
       
    1: PROFILES = {
           # --- Official source (documented; requires an API key) -----------------
    1:     "ogd_pds_resource": {
    1:         "name": "ogd_pds_resource",
    1:         "label": "Open Government Data (OGD) India — PDS resource",
    1:         "type": "API",
               "description": (
    1:             "Official Government of India Open Data (OGD) Platform API. "
                   "PDS-related resources are served as JSON/CSV with offset/limit "
                   "pagination. Requires a free API key. Not connected in this "
                   "development environment."
               ),
    1:         "base_url": OGD_API_BASE,
    1:         "format": "json",
    1:         "dataset_type": "ration_transactions",
    1:         "dataset_name": "ogd_pds_sync",
    1:         "file_name": "ogd_pds_resource.json",
    1:         "requires_auth": True,
    1:         "auth_env_var": OGD_API_KEY_ENV,
    2:         "pagination": {"type": "offset", "offset_param": "offset", "limit_param": "limit",
    1:                        "page_size": 1000, "records_key": "records", "total_key": "total"},
    1:         "mapping": {
                   # NOTE: for ration_transactions the internal field is
                   # fps_center_id / beneficiary_id (external codes/refs the
                   # importer resolves) — see ingestion.importer._stage_record.
    1:             "fps_id": "fps_center_id",
    1:             "district_name": "district",
    1:             "commodity_name": "commodity",
    1:             "distributed_qty": "quantity",
    1:             "date": "transaction_date",
    1:             "transaction_id": "external_transaction_id",
               },
    1:         "documentation_url": OGD_DOC_URL,
    1:         "update_frequency": "varies by resource",
    1:         "terms": "Free registration; API key required; usage per OGD platform terms.",
           },
           # --- Bundled sample (NOT government data; exercises the pipeline) ------
    1:     "sample_open_pds": {
    1:         "name": "sample_open_pds",
    1:         "label": "Sample PDS dataset (bundled with RationAI)",
    1:         "type": "CSV",
               "description": (
    1:             "A small, deterministic sample dataset bundled with the app and "
                   "served from /sample/pds_sample.csv. It exists so the connector "
                   "pipeline (HTTP fetch, parse, validate, import) can be exercised "
                   "end to end. This is SAMPLE data — not an external government "
                   "source."
               ),
    1:         "base_url": "/sample/pds_sample.csv",  # relative -> resolved against the app origin
    1:         "format": "csv",
    1:         "dataset_type": "ration_transactions",
    1:         "dataset_name": "sample_open_pds_sync",
    1:         "file_name": "pds_sample.csv",
    1:         "requires_auth": False,
    1:         "pagination": None,
    1:         "mapping": {
    1:             "Transaction ID": "external_transaction_id",
    1:             "FPS Code": "fps_center_id",
    1:             "District Name": "district",
    1:             "Commodity": "commodity",
    1:             "Quantity Distributed": "quantity",
    1:             "Transaction Date": "transaction_date",
    1:             "Beneficiary ID": "beneficiary_id",
    1:             "Latitude": "latitude",
    1:             "Longitude": "longitude",
               },
    1:         "documentation_url": None,
    1:         "update_frequency": "n/a (static sample)",
    1:         "terms": "Sample data for demonstration; not real PDS records.",
           },
       }
       
       
    1: def get_profile(name: str):
           """Return the connector profile for a source name, or None."""
   34:     return PROFILES.get(name)
       
       
    1: def list_profiles() -> list:
           """All registered profiles (for documentation/registration)."""
   60:     return list(PROFILES.values())
