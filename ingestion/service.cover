   39:     mapping_list = entry.mapping
   39:     missing = mapmod.validate_mapping(mapping_list, entry.dataset_type)
   39:     if missing:
               raise MappingError(" ".join(missing))
   39:     mapping_dict = mapmod.mapping_to_dict(mapping_list)
       
   39:     already = _already_imported(entry, db_path)
   39:     if already:
    2:         _drop_entry(token)
    2:         return {
    2:             "status": "ALREADY_IMPORTED",
    2:             "message": "This dataset appears to have already been imported.",
    2:             "existing_import": already,
