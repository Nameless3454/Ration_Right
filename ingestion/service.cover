   74:         summary = run_import(
   37:             conn,
   37:             file_name=entry.file_name,
   37:             file_type=entry.file_type,
   37:             dataset_name=entry.dataset_name,
   37:             source_name=UPLOADED_SOURCE_NAME,
   37:             dataset_type=entry.dataset_type,
   37:             headers=entry.headers,
   37:             rows=entry.rows,
   37:             mapping=mapping_dict,
   37:             file_hash=entry.file_hash,
