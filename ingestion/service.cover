    1: def import_history(db_path=DEFAULT_DB_PATH) -> list:
    2:     conn = open_db(db_path)
    2:     try:
    4:         rows = conn.execute(
    2:             "SELECT i.id, i.dataset_name, i.file_name, i.file_type, i.record_count, "
                   " i.successful_records, i.failed_records, i.duplicate_records, i.status, "
                   " i.error_summary, i.started_at, i.completed_at, i.created_at, "
                   " s.name AS source_name, s.type AS source_type "
                   "FROM data_imports i JOIN data_sources s ON s.id = i.data_source_id "
                   "ORDER BY i.id DESC"
               ).fetchall()
    8:         return [dict(row) for row in rows]
           finally:
    2:         conn.close()
       
       
    1: def import_status(import_id: int, *, db_path=DEFAULT_DB_PATH) -> dict:
    2:     conn = open_db(db_path)
    2:     try:
    4:         row = conn.execute(
    2:             "SELECT i.id, i.dataset_name, i.file_name, i.file_type, i.record_count, "
                   " i.successful_records, i.failed_records, i.duplicate_records, i.status, "
                   " i.error_summary, i.started_at, i.completed_at, i.created_at, "
                   " s.name AS source_name, s.type AS source_type "
                   "FROM data_imports i JOIN data_sources s ON s.id = i.data_source_id "
                   "WHERE i.id = :id",
    2:             {"id": import_id},
               ).fetchone()
           finally:
    2:         conn.close()
    2:     if row is None:
               raise NotFoundError("Import %s was not found." % import_id)
    2:     return dict(row)
       
       
