           """
   52:     if len(data) > get_max_upload_bytes():
    2:         raise FileTooLargeError(
    2:             "File too large. Maximum upload size is %d MB."
    1:             % (get_max_upload_bytes() // (1024 * 1024))
               )
   51:     file_type = sniff_file_type(filename, content_type)
   47:     verify_magic_bytes(file_type, data)
       
   46:     token = secrets.token_hex(8)
   46:     file_hash = hashlib.sha256(data).hexdigest()
   46:     upload_dir = _upload_dir()
   46:     temp_path = upload_dir / ("up_%s.%s" % (token, file_type))
   46:     with open(temp_path, "wb") as fh:
   46:         fh.write(data)
       
   46:     try:
   46:         parsed = parse_file(temp_path, file_type)
    3:     except ParseError:
    3:         _safe_unlink(temp_path)
    3:         raise
       
   43:     headers = parsed["headers"]
   43:     rows = parsed["rows"]
