   43:     dataset_type = mapmod.infer_dataset_type(headers)
   43:     auto = mapmod.detect_mapping(headers, dataset_type)
   43:     warnings.extend(auto["warnings"])
       
   43:     dataset_name = _default_dataset_name(filename)
   86:     entry = _Entry(
   43:         token=token, temp_path=temp_path, file_name=filename,
   43:         file_type=file_type, dataset_name=dataset_name, headers=headers,
   43:         rows=rows, sheets=sheets, warnings=warnings,
   43:         dataset_type=dataset_type, mapping=auto["mapping"],
   43:         file_hash=file_hash, created_at=time.time(),
           )
   43:     with _PENDING_LOCK:
   43:         _purge_stale_locked()
   43:         _PENDING[token] = entry
       
   86:     logger.info(
   43:         "[Ingestion] Upload %s: %s (%s), %d record(s), type=%s",
   43:         token, filename, file_type, len(rows), dataset_type,
           )
   43:     return {
   43:         "token": token,
   43:         "file_name": filename,
   43:         "file_type": file_type,
   43:         "dataset_name": dataset_name,
   43:         "record_count": len(rows),
   43:         "detected_columns": headers,
   43:         "sheets": sheets,
   43:         "dataset_type": dataset_type,
   43:         "dataset_type_label": mapmod.DATASET_TYPE_LABELS[dataset_type],
   43:         "mapping": auto["mapping"],
   43:         "missing_required": auto["missing_required"],
   43:         "warnings": warnings,
   43:         "preview": _preview(headers, rows),
           }
       
       
       # ---------------------------------------------------------------------------
       # Validate (mapping + validation + duplicates + preview)
