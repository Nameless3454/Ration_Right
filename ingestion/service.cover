                   )
   41:         entry.dataset_type = dataset_type
   41:     if sheet is not None and entry.sheet != sheet:
               parsed = parse_file(entry.temp_path, entry.file_type, sheet=sheet)
               entry.headers = parsed["headers"]
               entry.rows = parsed["rows"]
               entry.sheets = parsed.get("sheets", entry.sheets)
               entry.sheet = sheet
               entry.warnings = list(parsed.get("warnings", []))
       
   41:     mapping_list = _apply_mapping_overrides(entry, mapping)
   41:     missing = mapmod.validate_mapping(mapping_list, entry.dataset_type)
   40:     if missing:
    1:         raise MappingError(" ".join(missing))
       
   39:     mapping_dict = mapmod.mapping_to_dict(mapping_list)
   78:     summary = validation.summarize(
   39:         entry.rows, entry.dataset_type, entry.headers, mapping_dict
           )
   78:     duplicates = validation.classify_duplicates(
   39:         entry.rows, entry.dataset_type, entry.headers, mapping_dict
           )
   78:     quality = validation.quality_report(
   39:         total=len(entry.rows),
   39:         invalid=summary["invalid_records"],
   39:         duplicates=duplicates["exact"] + duplicates["possible"],
   39:         warnings=summary["warning_count"],
           )
  368:     mapped_columns = [
  251:         {"external": m["external"], "internal": m["internal"]}
  290:         for m in mapping_list
           ]
   39:     already = _already_imported(entry, db_path)
   39:     return {
   39:         "token": token,
   39:         "file_name": entry.file_name,
   39:         "file_type": entry.file_type,
   39:         "dataset_name": entry.dataset_name,
   39:         "dataset_type": entry.dataset_type,
   39:         "dataset_type_label": mapmod.DATASET_TYPE_LABELS[entry.dataset_type],
   39:         "sheets": entry.sheets,
   39:         "sheet": entry.sheet,
   39:         "detected_columns": entry.headers,
   39:         "mapped_columns": mapped_columns,
  270:         "required_fields": [
  153:             {"field": f, "label": mapmod.field_label(f)}
  192:             for f in mapmod.required_fields(entry.dataset_type)
               ],
   39:         "record_count": summary["total_records"],
   39:         "valid_records": summary["valid_records"],
   39:         "invalid_records": summary["invalid_records"],
   39:         "duplicate_records": duplicates["exact"] + duplicates["possible"],
   39:         "duplicates": duplicates,
   39:         "warning_count": summary["warning_count"],
   39:         "errors": summary["errors"],
   39:         "warnings": entry.warnings,
   39:         "warning_examples": summary["warnings"],
