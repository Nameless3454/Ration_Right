               )
   68:     fields = mappable_fields(dataset_type)
 1264:     aliases = {field: _alias_set(field) for field in fields}
   68:     used = set()
   68:     mapping = []
   68:     warnings = []
  435:     for header in headers:
  367:         normalized = normalize_header(header)
  367:         internal = None
  367:         if normalized:
 1625:             for field, accepted in aliases.items():
 1624:                 if field not in used and normalized in accepted:
  366:                     internal = field
  366:                     used.add(field)
  366:                     break
  367:             if normalized in ("ignore", "ignored", "unused"):
                       warnings.append("Column %r marked as ignored." % header)
  367:         mapping.append({"external": header, "internal": internal})
       
  473:     missing_required = [
  389:         field for field in required_fields(dataset_type)
 1991:         if field not in {m["internal"] for m in mapping}
           ]
   68:     return {"mapping": mapping, "warnings": warnings, "missing_required": missing_required}
       
       
    1: def infer_dataset_type(headers: list) -> str:
           """Guess the dataset kind from the columns present.
       
