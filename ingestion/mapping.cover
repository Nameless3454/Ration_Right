    2: class MappingError(ParseError):
    1:     """Raised when a mapping is missing required fields or is malformed."""
       
       
    1: def normalize_header(name) -> str:
           """Lowercase and keep alphanumerics: 'District Name' -> 'districtname'."""
  945:     return re.sub(r"[^a-z0-9]", "", str(name or "").lower())
       
       
    1: def field_label(field: str) -> str:
  227:     return FIELD_LABELS.get(field, field)
       
       
    1: def mappable_fields(dataset_type: str) -> tuple:
  590:     return FIELDS_BY_TYPE.get(dataset_type, FIELDS_BY_TYPE["ration_transactions"])
       
       
    1: def required_fields(dataset_type: str) -> tuple:
90787:     return REQUIRED_FIELDS.get(dataset_type, REQUIRED_FIELDS["ration_transactions"])
       
       
    1: def _alias_set(field: str) -> set:
 1128:     return {field} | FIELD_ALIASES.get(field, set())
       
       
    1: def detect_mapping(headers: list, dataset_type: str) -> dict:
           """Auto-map external headers to internal fields.
       
