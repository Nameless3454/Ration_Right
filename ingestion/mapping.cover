           (commodity + quantity/date), FPS centers (fps code, no commodity),
           beneficiaries (beneficiary ref, no quantity), default transactions."""
  382:     normalized = {normalize_header(h) for h in headers if normalize_header(h)}
  329:     has = lambda field, aliases: bool(normalized & (set(aliases) | {field}))
       
   47:     has_stock = has("current_stock", FIELD_ALIASES["current_stock"])
   47:     has_quantity = has("quantity", FIELD_ALIASES["quantity"])
   47:     has_commodity = has("commodity", FIELD_ALIASES["commodity"])
   47:     has_date = has("transaction_date", FIELD_ALIASES["transaction_date"])
   47:     has_fps = has("fps_code", FIELD_ALIASES["fps_code"])
   47:     has_beneficiary = has("external_reference", FIELD_ALIASES["external_reference"])
       
   47:     if has_stock and not has_quantity and has_commodity:
    2:         return "inventory"
   45:     if has_commodity and (has_quantity or has_date):
   41:         return "ration_transactions"
    4:     if has_fps and not has_commodity:
    2:         return "fps_centers"
    2:     if has_beneficiary and not has_quantity:
    2:         return "beneficiaries"
           return "ration_transactions"
       
       
    1: def validate_mapping(mapping: list, dataset_type: str) -> list:
           """Return errors (list of strings) if the mapping is unusable.
       
