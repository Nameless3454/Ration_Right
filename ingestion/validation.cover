    1:     "sugar": "Sugar", "oil": "Oil", "kerosene": "Kerosene",
       }
       
    1: COMMODITY_ALIASES = {
    1:     "rice": {"rice", "ricegrain", "rawrice", "parboiledrice", "basmati",
                    "basmaticommon", "ricegrain", "grains"},
