   40:     samples = []
       
30202:     for row_number, row in enumerate(rows, start=2):
30162:         record = _record_from_row(row, headers, mapping_dict)
30162:         normalized, errors, _ = validate_record(record, dataset_type)
30162:         if errors:
   21:             continue
