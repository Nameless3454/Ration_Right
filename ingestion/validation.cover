       # ---------------------------------------------------------------------------
       # Data quality score (Phase 4)
       # ---------------------------------------------------------------------------
       
       # Transparent, deterministic formula (no AI): start at 100 and subtract
       # penalties for invalid records (3x), duplicates (2x), and warnings (0.5x),
       # each measured as a percentage of total records. Clamped to [0, 100].
    1: QUALITY_WEIGHTS = {"invalid": 3.0, "duplicates": 2.0, "warnings": 0.5}
       
       
    1: def quality_score(total: int, invalid: int, duplicates: int, warnings: int) -> float:
           """Deterministic 0-100 quality score. Formula documented in the module
           docstring and QUALITY_WEIGHTS."""
  145:     if total <= 0:
               return 0.0
  145:     invalid_pct = invalid / total * 100
  145:     duplicate_pct = duplicates / total * 100
  145:     warning_pct = warnings / total * 100
  290:     score = 100.0 - (
  435:         QUALITY_WEIGHTS["invalid"] * invalid_pct
  145:         + QUALITY_WEIGHTS["duplicates"] * duplicate_pct
  145:         + QUALITY_WEIGHTS["warnings"] * warning_pct
           )
  145:     return round(max(0.0, min(100.0, score)), 1)
       
       
    1: def quality_report(total: int, invalid: int, duplicates: int, warnings: int) -> dict:
           """Structured quality report with the breakdown lines shown in the UI."""
  138:     if total <= 0:
               return {"score": 0.0, "valid_pct": 0.0, "duplicate_pct": 0.0, "warning_pct": 0.0}
  138:     valid = total - invalid - duplicates
  138:     return {
  138:         "score": quality_score(total, invalid, duplicates, warnings),
  138:         "valid_pct": round((valid / total) * 100, 1),
  138:         "duplicate_pct": round(duplicates / total * 100, 1),
  138:         "warning_pct": round(warnings / total * 100, 1),
  138:         "invalid_pct": round(invalid / total * 100, 1),
           }
       
       
    1: def _record_from_row(row, headers, mapping_dict: dict) -> dict:
           """Build an internal-field record from a raw row using the mapping."""
60320:     record = {}
442472:     for index, header in enumerate(headers):
382152:         field = mapping_dict.get(header)
382152:         if field:
382152:             record[field] = row[index] if index < len(row) else ""
60320:     return record
