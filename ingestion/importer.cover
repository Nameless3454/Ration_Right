    1: def _record_from_row(row, headers, mapping: dict) -> dict:
           """Build an internal-field record from a raw row using the mapping."""
30252:     record = {}
222170:     for index, header in enumerate(headers):
191918:         field = mapping.get(header)
191918:         if field:
191918:             record[field] = row[index] if index < len(row) else ""
30252:     return record
       
       
    1: def _build_error_summary(examples: list) -> str:
