    3:     limit = max(1, min(int(limit), 500))
    3:     sql = "SELECT id, actor, action, entity_type, entity_id, detail, request_id, created_at " \
                 "FROM audit_log"
    3:     clauses, params = [], {}
    3:     if action:
    1:         clauses.append("action = :action")
    1:         params["action"] = str(action)[:64]
    3:     if entity_type:
               clauses.append("entity_type = :entity_type")
               params["entity_type"] = str(entity_type)[:64]
    3:     if clauses:
    1:         sql += " WHERE " + " AND ".join(clauses)
    3:     sql += " ORDER BY id DESC LIMIT :limit"
    3:     params["limit"] = limit
    3:     rows = conn.execute(sql, params).fetchall()
    8:     return [dict(row) for row in rows]
       
       
