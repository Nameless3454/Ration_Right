    1: def get_alert_trend(conn: sqlite3.Connection, days: int = 7) -> dict:
           """Alerts created per day for the last ``days`` days (actual records)."""
   41:     from datetime import timedelta
       
   41:     days = max(1, min(int(days), 90))
