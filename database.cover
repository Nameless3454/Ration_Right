   57:     if source is not None:
    8:         import_ids = [
    2:             row["id"]
    6:             for row in conn.execute(
    2:                 "SELECT id FROM data_imports WHERE data_source_id = :sid",
    2:                 {"sid": source["id"]},
                   ).fetchall()
               ]
    4:         for import_id in import_ids:
    8:             for table in ("ai_insights", "inventory", "ration_transactions"):
   12:                 conn.execute(
    6:                     "DELETE FROM %s WHERE source_import_id = :iid" % table,
    6:                     {"iid": import_id},
                       )
    2:             conn.execute("DELETE FROM data_imports WHERE id = :iid", {"iid": import_id})
    2:         conn.execute("DELETE FROM data_sources WHERE id = :sid", {"sid": source["id"]})
       
           # --- data source + import (provenance) ---
  114:     source_id = insert_data_source(
   57:         conn,
   57:         name=SYNTHETIC_SOURCE_NAME,
   57:         source_type="JSON",
   57:         description=metadata.get("description"),
   57:         status="ACTIVE",
   57:         last_sync_at=now,
           )
  114:     import_id = insert_data_import(
   57:         conn,
   57:         data_source_id=source_id,
   57:         dataset_name=metadata.get("dataset_name") or "rationright-synthetic-transactions",
   57:         file_name="transactions.json",
   57:         file_type="json",
   57:         record_count=len(transactions),
   57:         successful_records=len(transactions),
   57:         failed_records=0,
   57:         duplicate_records=0,
   57:         status="COMPLETED",
   57:         started_at=now,
   57:         completed_at=now,
           )
       
           # --- beneficiaries + transactions ---
   57:     beneficiary_ids = {}
 1482:     for tx in transactions:
 1425:         ref = tx["beneficiary_id"]
 1425:         if ref not in beneficiary_ids:
  285:             beneficiary_ids[ref] = upsert_beneficiary(conn, external_reference=ref, status="ACTIVE")
 2850:         insert_transaction(
 1425:             conn,
 1425:             external_transaction_id=tx["transaction_id"],
 1425:             beneficiary_id=beneficiary_ids[ref],
 1425:             transaction_date=tx["timestamp"],
 1425:             commodity=tx["ration_type"],
 1425:             quantity=tx["quantity"],
 1425:             unit=DEFAULT_TRANSACTION_UNIT,
 1425:             latitude=tx["latitude"],
 1425:             longitude=tx["longitude"],
 1425:             status="COMPLETED",
 1425:             source_import_id=import_id,
               )
       
   57:     conn.commit()
   57:     return {
   57:         "data_source_id": source_id,
   57:         "data_import_id": import_id,
   57:         "beneficiaries": len(beneficiary_ids),
   57:         "transactions": len(transactions),
   57:         "fps_centers": 0,
   57:         "inventory": 0,
   57:         "ai_insights": 0,
           }
       
       
