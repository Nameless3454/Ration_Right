    7:     now = _now_iso()
    7:     if status == "ACKNOWLEDGED":
    4:         conn.execute(
    2:             "UPDATE alerts SET status = 'ACKNOWLEDGED', acknowledged_at = :now "
    2:             "WHERE id = :id", {"now": now, "id": row["id"]})
    5:     elif status == "RESOLVED":
    4:         conn.execute(
    2:             "UPDATE alerts SET status = 'RESOLVED', resolved_at = :now "
    2:             "WHERE id = :id", {"now": now, "id": row["id"]})
    3:     elif status == "DISMISSED":
    6:         conn.execute(
    3:             "UPDATE alerts SET status = 'DISMISSED', dismissed_at = :now, "
                   " dismissed_reason = :reason WHERE id = :id",
    3:             {"now": now, "reason": dismissed_reason, "id": row["id"]})
           else:  # re-open (used by tests / recovery)
               conn.execute(
                   "UPDATE alerts SET status = 'OPEN' WHERE id = :id", {"id": row["id"]})
    7:     return True
       
       
