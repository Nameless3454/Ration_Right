   82:     rows = conn.execute(
   41:         "SELECT substr(created_at, 1, 10) AS day, COUNT(*) AS n "
               "FROM alerts WHERE substr(created_at, 1, 10) >= :start "
               "GROUP BY day ORDER BY day",
   41:         {"start": (today - timedelta(days=days - 1)).isoformat()},
           ).fetchall()
  108:     by_day = {r["day"]: r["n"] for r in rows}
   41:     series = []
  328:     for offset in range(days):
  287:         day = (today - timedelta(days=days - 1 - offset)).isoformat()
  287:         series.append({"date": day, "count": by_day.get(day, 0)})
   82:     return {"days": days, "series": series,
  369:             "total": sum(item["count"] for item in series)}
       
       
    1: def update_alert_status(
           conn: sqlite3.Connection,
           alert_id: str,
           status: str,
           *,
    1:     dismissed_reason: Optional[str] = None,
       ) -> bool:
           """Transition one alert's status; returns True when a row changed.
       
           OPEN -> ACKNOWLEDGED (records acknowledged_at), OPEN/ACKNOWLEDGED ->
           RESOLVED (records resolved_at), and -> DISMISSED (records dismissed_at +
           optional reason). The alert row is never deleted — history is preserved.
           """
