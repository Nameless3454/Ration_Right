   31:     where, params = [], {}
   31:     if insight_type:
   31:         where.append("insight_type = :itype")
   31:         params["itype"] = insight_type
   31:     if min_severity:
   31:         rank = {"LOW": 0, "MEDIUM": 1, "HIGH": 2, "CRITICAL": 3}
   31:         cutoff = rank.get(min_severity)
   31:         if cutoff is not None:
   31:             where.append("CASE severity WHEN 'LOW' THEN 0 WHEN 'MEDIUM' THEN 1 "
                                "WHEN 'HIGH' THEN 2 WHEN 'CRITICAL' THEN 3 END >= :rank")
   31:             params["rank"] = cutoff
   31:     where_sql = (" WHERE " + " AND ".join(where)) if where else ""
   62:     rows = conn.execute(
   62:         "SELECT * FROM ai_insights" + where_sql +
   31:         " ORDER BY id DESC LIMIT :limit",
   31:         {**params, "limit": limit},
           ).fetchall()
   31:     out = []
   58:     for row in rows:
   27:         d = dict(row)
   27:         raw = d.get("evidence")
   27:         if isinstance(raw, str):
   27:             try:
   27:                 d["evidence"] = _json.loads(raw)
                   except ValueError:
                       d["evidence"] = None
   27:         out.append(d)
   31:     return out
       
       
