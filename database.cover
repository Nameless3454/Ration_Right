  307:     if not refs:
   43:         return {}
20873:     placeholders = ",".join("?" for _ in refs)
  528:     rows = conn.execute(
  528:         "SELECT id, external_reference FROM beneficiaries "
  264:         "WHERE external_reference IN (%s)" % placeholders,
  264:         list(refs),
