   17:         analysis_id = "RA-%04d-%04d" % (_now().year, seq)
   34:         insert_analysis_run(
   17:             conn,
   17:             analysis_id=analysis_id,
   17:             data_import_id=data_import_id,
   17:             dataset_mode=dataset_mode,
   17:             status=status,
   17:             anomaly_count=len(anomalies),
   17:             finding_count=len(findings),
   17:             case_count=len(cases),
   17:             alert_count=len(alerts),
   17:             insight_count=len(insights),
   17:             analysis_types=analysis_types,
   17:             filters=filters,
   17:             timings=timings,
   17:             duration_ms=duration_ms,
   17:             summary=summary,
