   17:     insights = result.get("insights") or []
   17:     skipped = bool(result.get("skipped_reason"))
   17:     types_status = result.get("types") or {}
       
   17:     if result.get("errors"):
               status = "FAILED"
               summary = "; ".join(str(e) for e in result["errors"])[:300]
   17:     elif skipped:
    1:         status = "INSUFFICIENT_DATA"
    1:         summary = str(result.get("skipped_reason"))[:300]
           else:
   16:         status = "COMPLETED"
   32:         summary = "%d anomaly(ies) -> %d finding(s) -> %d case(s) -> %d alert(s)" % (
   16:             len(anomalies), len(findings), len(cases), len(alerts),
               )
       
   17:     conn = open_db(db_path)
