    1: def freshness(db_path: str = DEFAULT_DB_PATH) -> dict:
           """Data freshness from the latest successful import timestamp.
       
           No timestamp -> UNKNOWN (never assumed). Thresholds documented in the
           module constants.
           """
   43:     conn = open_db(db_path)
   43:     try:
  129:         latest = conn.execute(
   43:             "SELECT MAX(completed_at) AS ts FROM data_imports "
                   "WHERE status IN ('COMPLETED','PARTIAL')"
   43:         ).fetchone()["ts"]
           finally:
   43:         conn.close()
       
   43:     parsed = _parse_ts(latest)
   43:     if parsed is None:
   50:         return {"latest_data_at": None, "age_seconds": None, "age_label": None,
   25:                 "status": "UNKNOWN", "detail": "No successful import recorded yet."}
   18:     age = (_now() - parsed).total_seconds()
   18:     if age < FRESH_MAX_SECONDS:
   17:         status = "FRESH"
    1:     elif age < RECENT_MAX_SECONDS:
               status = "RECENT"
    1:     elif age < STALE_MAX_SECONDS:
               status = "STALE"
           else:
    1:         status = "UNKNOWN"
   18:     return {
   18:         "latest_data_at": latest,
   18:         "age_seconds": round(age, 1),
   18:         "age_label": _fmt_age(age),
   18:         "status": status,
   36:         "detail": "Latest data %s ago (thresholds: FRESH < 24h, RECENT < 7d, STALE < 30d)."
   18:                   % _fmt_age(age),
           }
       
       
       # ---------------------------------------------------------------------------
       # Data quality panel (reuses the single Phase 4 formula)
       # ---------------------------------------------------------------------------
       
    1: def quality_panel(db_path: str = DEFAULT_DB_PATH) -> dict:
           """Aggregated quality across imports, using the exact Phase 4 formula.
       
           The overall score is the record-count-weighted mean of each import's
           ``quality_report`` score (transparent and deterministic). Completeness
           (missing required fields) is not stored per import, so it is reported
           as ``None`` — the UI renders \"Not available\" rather than inventing it.
           """
   41:     conn = open_db(db_path)
   41:     try:
   82:         rows = conn.execute(
   41:             "SELECT id, dataset_name, record_count, successful_records, "
                   " failed_records, duplicate_records, warnings_count, status, completed_at "
                   "FROM data_imports ORDER BY id"
               ).fetchall()
           finally:
   41:         conn.close()
       
   41:     entries = []
   41:     total_weight = 0
   41:     weighted = 0.0
   41:     totals = {"records": 0, "valid": 0, "invalid": 0, "duplicates": 0, "warnings": 0}
   80:     for row in rows:
   39:         r = dict(row)
   39:         if r["record_count"] > 0:
   78:             report = quality_report(
   39:                 total=r["record_count"],
   39:                 invalid=r["failed_records"],
   39:                 duplicates=r["duplicate_records"],
   39:                 warnings=r["warnings_count"],
                   )
   39:             weight = r["record_count"]
   39:             weighted += report["score"] * weight
   39:             total_weight += weight
               else:
                   report = {"score": None, "valid_pct": None, "duplicate_pct": None, "warning_pct": None}
   39:         totals["records"] += r["record_count"]
   39:         totals["valid"] += r["successful_records"]
   39:         totals["invalid"] += r["failed_records"]
   39:         totals["duplicates"] += r["duplicate_records"]
   39:         totals["warnings"] += r["warnings_count"]
   78:         entries.append({
   39:             "data_import_id": r["id"],
   39:             "dataset_name": r["dataset_name"],
   39:             "status": r["status"],
   39:             "completed_at": r["completed_at"],
   39:             "score": report["score"],
   39:             "records": r["record_count"],
               })
       
   41:     overall = round(weighted / total_weight, 1) if total_weight else None
   41:     n = max(len(entries), 1)
   41:     validity = round(100.0 - (totals["invalid"] / totals["records"] * 100), 1) if totals["records"] else None
   41:     duplicate_rate = round(totals["duplicates"] / totals["records"] * 100, 1) if totals["records"] else None
   41:     consistency = round(100.0 - (totals["warnings"] / totals["records"] * 100), 1) if totals["records"] else None
       
   41:     return {
   41:         "overall_score": overall,
   41:         "import_count": len(entries),
   41:         "totals": totals,
   41:         "breakdown": {
   41:             "validity": validity,
   41:             "consistency": consistency,
   41:             "duplicate_rate": duplicate_rate,
   41:             "completeness": None,
               },
   41:         "formula": "Phase 4 quality_report: 100 - 3.0*invalid%% - 2.0*duplicates%% - 0.5*warnings%%",
   41:         "entries": entries,
           }
       
       
