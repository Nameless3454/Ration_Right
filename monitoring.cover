   58:         if r["reorder_threshold"] is not None and stock < r["reorder_threshold"]:
  120:             out.append(_candidate(
   30:                 "INVENTORY_RISK", "below_reorder", "HIGH",
   30:                 "Inventory below reorder threshold at %s" % r["fps_code"],
   60:                 "Stock of %s at %s is %.2f kg, below the %.2f kg reorder "
