    1: _SEVERITY_RANK = {"LOW": 0, "MEDIUM": 1, "HIGH": 2, "CRITICAL": 3}
       
       
    1: def _now() -> datetime:
  293:     return datetime.now(timezone.utc)
       
       
    1: def _parse_ts(ts) -> Optional[datetime]:
   29:     if not ts:
               return None
   29:     try:
   29:         parsed = datetime.fromisoformat(str(ts).replace("Z", "+00:00"))
           except ValueError:
               return None
   29:     if parsed.tzinfo is None:
               parsed = parsed.replace(tzinfo=timezone.utc)
   29:     return parsed
       
       
    1: def _round(value, digits=2):
  536:     if value is None:
               return None
  536:     return round(float(value), digits)
       
       
    1: def _seed_rules(conn) -> None:
   31:     seed_alert_rules(conn, DEFAULT_RULES)
   31:     conn.commit()
       
       
    1: def _rule_map(conn) -> dict:
           """Rules keyed by (rule_type, condition) -> config dict."""
   32:     rules = {}
  329:     for rule in list_alert_rules(conn):
  297:         rules[(rule["rule_type"], rule["condition"])] = rule
   32:     return rules
       
       
    1: def _threshold(rules, rule_type: str, condition: str, default: float) -> Optional[float]:
  247:     rule = rules.get((rule_type, condition))
  247:     if rule is None:
   40:         return default
  207:     if rule["threshold"] is not None:
  207:         return float(rule["threshold"])
           return default
       
       
    1: def _enabled(rules, rule_type: str, condition: str) -> bool:
  279:     rule = rules.get((rule_type, condition))
  279:     return rule is None or bool(rule["enabled"])
       
       
       # ---------------------------------------------------------------------------
       # Detectors — deterministic, parameterized SQL, no LLM
       # ---------------------------------------------------------------------------
       
    1: def _candidate(rule_type, condition, severity, title, description, *, evidence,
    1:                recommendation=None, entity_type=None, entity_id=None,
    1:                commodity=None, current_value=None, threshold=None,
    1:                source_id=None, import_id=None, analysis_id=None) -> dict:
  246:     return {
  246:         "rule_type": rule_type, "condition": condition, "severity": severity,
  246:         "title": title, "description": description, "evidence": evidence or {},
  246:         "recommendation": recommendation, "entity_type": entity_type,
  246:         "entity_id": entity_id, "commodity": commodity,
  246:         "current_value": current_value, "threshold": threshold,
  246:         "source_id": source_id, "import_id": import_id, "analysis_id": analysis_id,
           }
       
       
    1: def _inventory_candidates(conn, rules) -> list:
