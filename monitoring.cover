           FAILURE_MIN_TRANSACTIONS,
           FAILURE_RATE_THRESHOLD,
           INVENTORY_CRITICAL_DAYS,
           INVENTORY_WARNING_DAYS,
           NO_RECENT_DISTRIBUTION_DAYS,
       )
