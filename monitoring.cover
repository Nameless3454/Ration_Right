    1: logger = logging.getLogger("rationright.monitoring")
       
       # --- built-in default thresholds (the alert_rules table overrides these) -----
    1: DEMAND_SPIKE_PCT = 20.0
    1: DEMAND_DROP_PCT = 20.0
    1: FRESHNESS_HOURS = 24.0
    1: QUALITY_WARN_PCT = 90.0
    1: DEMAND_MIN_TRANSACTIONS = 3
       
