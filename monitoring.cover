    1: def _operational_candidates(conn, rules) -> list:
   31:     out = []
           # Elevated failure rate per FPS.
   31:     if _enabled(rules, "OPERATIONAL_RISK", "high_failure_rate"):
   62:         pct = _threshold(rules, "OPERATIONAL_RISK", "high_failure_rate",
   31:                          FAILURE_RATE_THRESHOLD * 100)
   97:         for r in conn.execute(
   31:             "SELECT COALESCE(f.fps_code, 'Unknown') AS fps_code, f.district, "
                   " COALESCE(SUM(CASE WHEN t.status = 'FAILED' THEN 1 ELSE 0 END), 0) AS failed, "
                   " COALESCE(SUM(CASE WHEN t.status IN ('COMPLETED','FAILED') THEN 1 ELSE 0 END), 0) AS total, "
                   " MAX(t.source_import_id) AS import_id "
                   "FROM ration_transactions t LEFT JOIN fps_centers f ON f.id = t.fps_center_id "
                   "GROUP BY fps_code"
               ):
   35:             total = r["total"]
   35:             if total < FAILURE_MIN_TRANSACTIONS:
    8:                 continue
   27:             rate = r["failed"] / total
   27:             if rate * 100 >= pct:
   54:                 out.append(_candidate(
   27:                     "OPERATIONAL_RISK", "high_failure_rate", "MEDIUM",
   27:                     "Transaction failure rate elevated at %s" % r["fps_code"],
   54:                     "%d of %d transactions at %s failed (%.0f%% >= %.0f%% "
   27:                     "threshold). Requires human review." % (
   27:                         r["failed"], total, r["fps_code"], rate * 100, pct),
   54:                     evidence={"fps_code": r["fps_code"], "district": r["district"],
   27:                               "failed_transactions": r["failed"],
   27:                               "total_transactions": total,
   27:                               "failure_rate_pct": _round(rate * 100),
   27:                               "threshold_pct": pct},
   54:                     recommendation="Review the failing transactions at %s."
   27:                                    % r["fps_code"],
   27:                     current_value=_round(rate * 100), threshold=pct,
   27:                     entity_type="fps_center", entity_id=r["fps_code"],
   27:                     import_id=r["import_id"]))
           # No recent distribution per FPS.
   31:     if _enabled(rules, "OPERATIONAL_RISK", "no_recent_distribution"):
   62:         recent_days = int(_threshold(rules, "OPERATIONAL_RISK",
   31:                                      "no_recent_distribution",
   31:                                      float(NO_RECENT_DISTRIBUTION_DAYS)))
   31:         cutoff = (_now() - timedelta(days=recent_days)).date().isoformat()
   89:         for r in conn.execute(
   31:             "SELECT f.fps_code, f.district, "
                   " COALESCE(SUM(CASE WHEN t.status = 'COMPLETED' AND "
                   "   substr(t.transaction_date, 1, 10) >= :cutoff THEN 1 ELSE 0 END), 0) AS completed "
                   "FROM fps_centers f LEFT JOIN ration_transactions t ON t.fps_center_id = f.id "
                   "GROUP BY f.fps_code HAVING completed = 0",
   31:             {"cutoff": cutoff},
               ):
   54:             out.append(_candidate(
   27:                 "OPERATIONAL_RISK", "no_recent_distribution", "LOW",
   27:                 "No recent distribution activity at %s" % r["fps_code"],
   54:                 "FPS %s (%s) has no completed transactions in the last %d days "
   27:                 "(cutoff %s). Verify the center is operating." % (
   27:                     r["fps_code"], r["district"] or "district unknown",
   27:                     recent_days, cutoff),
   54:                 evidence={"fps_code": r["fps_code"], "district": r["district"],
   27:                           "recent_days": recent_days, "cutoff": cutoff},
   54:                 recommendation="Verify %s is operating and record distributions."
   27:                                % r["fps_code"],
   27:                 current_value=0, threshold=float(recent_days),
   27:                 entity_type="fps_center", entity_id=r["fps_code"]))
   31:     return out
       
       
    1: def _demand_candidates(conn, rules) -> list:
   31:     out = []
   31:     spike_on = _enabled(rules, "DEMAND_SPIKE", "demand_spike")
   31:     drop_on = _enabled(rules, "DEMAND_DROP", "demand_drop")
   31:     if not (spike_on or drop_on):
               return out
   31:     spike_pct = _threshold(rules, "DEMAND_SPIKE", "demand_spike", DEMAND_SPIKE_PCT)
   31:     drop_pct = _threshold(rules, "DEMAND_DROP", "demand_drop", DEMAND_DROP_PCT)
   62:     rows = conn.execute(
   31:         "SELECT substr(transaction_date, 1, 7) AS period, commodity, "
               " COUNT(*) AS n, SUM(quantity) AS qty "
               "FROM ration_transactions WHERE transaction_date IS NOT NULL "
               "GROUP BY period, commodity ORDER BY period, commodity"
           ).fetchall()
   31:     by_commodity = {}
  155:     for r in rows:
  248:         by_commodity.setdefault(r["commodity"], []).append(
  124:             {"period": r["period"], "n": r["n"], "qty": r["qty"]})
   66:     for commodity in sorted(by_commodity):
  159:         series = sorted(by_commodity[commodity], key=lambda item: item["period"])
   35:         if len(series) < 2:
                   continue  # need a baseline month to compare against
   35:         latest = series[-1]
   35:         if latest["n"] < DEMAND_MIN_TRANSACTIONS:
    8:             continue  # too little activity in the latest month to judge a change
   27:         prior = series[:-1]
  135:         baseline = sum(item["qty"] for item in prior) / len(prior)
   27:         if baseline <= 0:
                   continue
   27:         deviation = (latest["qty"] - baseline) / baseline * 100.0
   27:         if spike_on and deviation >= spike_pct:
                   severity = "HIGH" if deviation >= 2 * spike_pct else "MEDIUM"
                   out.append(_candidate(
                       "DEMAND_SPIKE", "demand_spike", severity,
                       "Demand spike detected for %s" % commodity,
                       "Demand for %s in %s was %.0f kg, %.1f%% above the average of "
                       "the %d preceding month(s) (%.0f kg)." % (
                           commodity, latest["period"], latest["qty"], deviation,
                           len(prior), baseline),
                       evidence={"commodity": commodity, "latest_period": latest["period"],
                                 "latest_quantity": _round(latest["qty"]),
                                 "baseline_periods": [item["period"] for item in prior],
                                 "baseline_average": _round(baseline),
                                 "deviation_pct": _round(deviation),
                                 "threshold_pct": spike_pct},
                       recommendation="Investigate the demand increase for %s and confirm "
                                      "supply keeps pace." % commodity,
                       current_value=_round(deviation), threshold=spike_pct,
                       entity_type="commodity", entity_id=commodity, commodity=commodity))
   27:         elif drop_on and deviation <= -drop_pct:
   27:             severity = "HIGH" if deviation <= -2 * drop_pct else "MEDIUM"
   54:             out.append(_candidate(
   27:                 "DEMAND_DROP", "demand_drop", severity,
   27:                 "Demand drop detected for %s" % commodity,
   54:                 "Demand for %s in %s was %.0f kg, %.1f%% below the average of "
   27:                 "the %d preceding month(s) (%.0f kg)." % (
   27:                     commodity, latest["period"], latest["qty"], abs(deviation),
   27:                     len(prior), baseline),
   54:                 evidence={"commodity": commodity, "latest_period": latest["period"],
   27:                           "latest_quantity": _round(latest["qty"]),
  135:                           "baseline_periods": [item["period"] for item in prior],
   27:                           "baseline_average": _round(baseline),
   27:                           "deviation_pct": _round(deviation),
   27:                           "threshold_pct": drop_pct},
   54:                 recommendation="Check whether the demand drop for %s reflects a "
   27:                                "data gap or a real reduction in uptake." % commodity,
   27:                 current_value=_round(deviation), threshold=drop_pct,
   27:                 entity_type="commodity", entity_id=commodity, commodity=commodity))
   31:     return out
       
       
    1: def _freshness_candidates(conn, rules) -> list:
   31:     out = []
   31:     if not _enabled(rules, "DATA_FRESHNESS", "stale"):
               return out
   31:     hours = _threshold(rules, "DATA_FRESHNESS", "stale", FRESHNESS_HOURS)
   31:     now = _now()
   91:     for r in conn.execute(
   31:         "SELECT id, name, last_successful_sync_at, last_sync_at "
               "FROM data_sources WHERE last_successful_sync_at IS NOT NULL"
           ):
   29:         last = _parse_ts(r["last_successful_sync_at"])
   29:         if last is None:
                   continue
   29:         age_hours = (now - last).total_seconds() / 3600.0
   29:         if age_hours > hours:
   52:             out.append(_candidate(
   26:                 "DATA_FRESHNESS", "stale", "MEDIUM",
   26:                 "Data source has not been updated recently",
   52:                 "Source %r has not been updated for %.1f hours (threshold %.0f "
   26:                 "hours). Last successful sync: %s." % (
   26:                     r["name"], age_hours, hours, r["last_successful_sync_at"]),
   52:                 evidence={"source": r["name"],
   26:                           "last_successful_sync_at": r["last_successful_sync_at"],
   26:                           "last_sync_attempt_at": r["last_sync_at"],
   26:                           "age_hours": _round(age_hours),
   26:                           "threshold_hours": hours},
   26:                 recommendation="Trigger a sync for %r." % r["name"],
   26:                 current_value=_round(age_hours), threshold=hours,
   26:                 entity_type="data_source", entity_id=r["name"],
   26:                 source_id=r["id"]))
   31:     return out
       
       
