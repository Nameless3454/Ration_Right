   74: class _RateLimiter:
   37:     """Minimal in-memory sliding-window rate limiter keyed by client address.
       
           Per-server instance (not global) so tests stay isolated. Uses
           ``time.monotonic`` and a lock; no dependencies.
           """
       
   37:     def __init__(self):
   48:         self._hits = {}
   48:         self._lock = threading.Lock()
       
   37:     def allow(self, key: str, limit: int, window: int):
               """Return ``(ok, retry_after_seconds)`` for one request."""
   47:         now = time.monotonic()
   47:         with self._lock:
   47:             bucket = self._hits.setdefault(key, deque())
   47:             while bucket and now - bucket[0] >= window:
                       bucket.popleft()
   47:             if len(bucket) >= limit:
    3:                 retry = max(1, int(window - (now - bucket[0])))
    3:                 return False, retry
   44:             bucket.append(now)
   44:             return True, 0
       
       
