    6:         errors = validate_transactions(dataset["transactions"])
    6:         if errors:
                   checks["dataset"] = {
                       "status": "degraded",
                       "detail": "%d validation error(s)" % len(errors),
                   }
                   overall = "degraded"
               else:
    6:             checks["dataset"] = {
    6:                 "status": "ok",
   12:                 "detail": "%d transaction(s), %d beneficiary(ies)" % (
    6:                     len(dataset["transactions"]),
  162:                     len({t["beneficiary_id"] for t in dataset["transactions"]}),
                       ),
                   }
    1:     except Exception as exc:  # noqa: BLE001
    1:         checks["dataset"] = {"status": "error", "detail": str(exc)}
    1:         overall = "error"
       
           # Agent checks: every agent must import and instantiate.
    7:     agent_classes = {
    7:         "agent_1": Agent1TransactionAnalyst,
    7:         "agent_2": Agent2AnomalyInvestigator,
    7:         "agent_3": Agent3EvidenceCaseBuilder,
    7:         "agent_4": Agent4AlertGenerator,
