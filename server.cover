               )
    7:         checks["config"] = {
    7:             "status": "ok",
   14:             "detail": "interval<=%s min, distance>=%s km" % (
    7:                 RAPID_GEOGRAPHIC_MAX_INTERVAL_MINUTES,
    7:                 RAPID_GEOGRAPHIC_MIN_DISTANCE_KM,
                   ),
               }
           except Exception as exc:  # noqa: BLE001
