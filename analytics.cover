    2:             "alert_id": make_id("INV", r["fps_code"]),
    2:             "category": "LOW_INVENTORY",
    2:             "severity": "high",
    2:             "title": "Inventory below reorder threshold",
    4:             "message": "Stock of %s at %s is below the reorder threshold "
    4:                        "(%.2f < %.2f)." % (r["commodity"], r["fps_code"],
    2:                                            r["current_stock"], r["reorder_threshold"]),
    2:             "entity_type": "fps_center",
    2:             "entity_id": r["fps_code"],
    2:             "commodity": r["commodity"],
    2:             "current_stock": r["current_stock"],
    2:             "reorder_threshold": r["reorder_threshold"],
