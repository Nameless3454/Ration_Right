               " COALESCE(SUM(CASE WHEN status = 'ACTIVE' THEN 1 ELSE 0 END), 0) AS active "
               " FROM beneficiaries"
           ).fetchone()
   50:     fps_row = conn.execute(
   25:         "SELECT COUNT(*) AS n, "
