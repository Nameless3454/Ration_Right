           ]
   18:     by_center = [
   13:         dict(r) for r in conn.execute(
    5:             "SELECT COALESCE(f.fps_code, 'Unknown') AS fps_code, "
                   " COALESCE(SUM(i.current_stock), 0) AS current_stock, COUNT(i.id) AS items "
                   "FROM inventory i LEFT JOIN fps_centers f ON f.id = i.fps_center_id "
                   "GROUP BY fps_code ORDER BY current_stock DESC"
               )
           ]
       
    5:     return {
   14:         "total_stock_kg": round(sum(r["current_stock"] for r in by_commodity), 2),
    5:         "by_commodity": by_commodity,
    5:         "items": items,
    5:         "by_center": by_center,
    5:         "low_stock_items": low_stock,
