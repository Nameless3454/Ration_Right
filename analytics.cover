    5:         "thresholds": {
    5:             "critical_days": INVENTORY_CRITICAL_DAYS,
    5:             "warning_days": INVENTORY_WARNING_DAYS,
    5:             "method": "days_remaining = current_stock * 30 / monthly_consumption",
               },
           }
       
       
