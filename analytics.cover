    1: def inventory(conn: sqlite3.Connection) -> dict:
    5:     by_commodity = []
   14:     for r in conn.execute(
    5:         "SELECT commodity, "
               " COALESCE(SUM(current_stock), 0) AS current_stock, "
               " COALESCE(SUM(monthly_consumption), 0) AS monthly_consumption, "
               " MIN(reorder_threshold) AS reorder_threshold, "
               " COUNT(DISTINCT fps_center_id) AS center_count "
               "FROM inventory GROUP BY commodity ORDER BY current_stock DESC"
           ):
    4:         stock = r["current_stock"]
    4:         consumption = r["monthly_consumption"]
    4:         if consumption and consumption > 0:
    4:             days_remaining = round(stock * 30.0 / consumption, 1)
    4:             status = (
    4:                 "CRITICAL" if days_remaining < INVENTORY_CRITICAL_DAYS
    2:                 else "WARNING" if days_remaining < INVENTORY_WARNING_DAYS
    2:                 else "HEALTHY"
                   )
               else:
                   days_remaining = None
                   status = "UNKNOWN"
    8:         by_commodity.append({
    4:             "commodity": r["commodity"],
    4:             "current_stock": stock,
    4:             "monthly_consumption": consumption,
    4:             "reorder_threshold": r["reorder_threshold"],
    4:             "center_count": r["center_count"],
    4:             "days_remaining": days_remaining,
    4:             "status": status,
               })
       
   19:     items = [dict(r) for r in conn.execute(
    5:         "SELECT i.id, i.commodity, i.current_stock, i.monthly_consumption, "
               " i.reorder_threshold, COALESCE(f.fps_code, 'Unknown') AS fps_code, "
               " substr(i.last_updated, 1, 10) AS last_updated "
               "FROM inventory i LEFT JOIN fps_centers f ON f.id = i.fps_center_id "
               "ORDER BY i.commodity, fps_code"
           )]
   19:     low_stock = [
   11:         item for item in items
    4:         if item["reorder_threshold"] is not None
