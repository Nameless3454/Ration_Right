               "WHERE district IS NOT NULL AND district != ''"
           ).fetchone()
       
  143:     by_commodity = [
  118:         dict(r) for r in conn.execute(
   75:             "SELECT commodity, COALESCE(SUM(quantity), 0) AS quantity, COUNT(*) AS count "
   25:             "FROM ration_transactions WHERE 1 = 1" + clause +
   25:             " GROUP BY commodity ORDER BY quantity DESC",
   25:             params,
               )
           ]
   25:     by_status = {
