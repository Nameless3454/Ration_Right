    1: """RationRight — database analytics service (Phase 5).
       
       The dashboard's numbers come from HERE, never from the frontend: every metric
       is an SQL aggregation over the normalized database (``data/rationright.db``),
       so a change to a database record changes the dashboard on the next fetch.
       
       The database contains the seeded synthetic demo dataset (import source
       "Synthetic Demo Dataset") plus any datasets uploaded through Phase 3/4. All
       analytics operate over the full database — demo data is preserved and real
       data simply adds to the aggregates, with per-source provenance reported so the
       UI can show exactly which imports are contributing.
       
       Supported queries
       -----------------
       - ``overview``          KPI cards + provenance (time-range aware)
       - ``distribution``      by commodity / district / center / status + trend
       - ``inventory``         stock, consumption, days remaining, risk status
       - ``beneficiaries``     searchable, filterable, paginated registry
       - ``fps``               centers with distribution activity
       - ``alerts``            deterministic operational alerts (no AI)
       - ``transactions``      paginated transaction feed (agent-contract shape)
       
       Deterministic rules documented here (never computed in the UI):
       
       - **Inventory risk** — ``days_remaining = current_stock * 30 / monthly_consumption``
         (30-day month assumption). ``CRITICAL`` below 15 days, ``WARNING`` below 30
         days, otherwise ``HEALTHY``; ``UNKNOWN`` when no consumption is recorded.
       - **Low-stock alert** — ``current_stock < reorder_threshold`` → HIGH.
       - **High failure-rate alert** — at an FPS, ``failed / (failed + completed) >= 10%``
         with at least 5 transactions → MEDIUM.
       - **No recent distribution alert** — an FPS with zero completed transactions
         in the last 30 days → LOW.
       """
       
    1: from __future__ import annotations
       
    1: import sqlite3
    1: from datetime import date, timedelta
       
    1: from database import DEFAULT_DB_PATH, as_agent_transaction, open_db
       
    1: RANGES = ("today", "7d", "30d", "all", "custom")
    1: RANGE_LABELS = {
    1:     "today": "Today",
    1:     "7d": "Last 7 days",
    1:     "30d": "Last 30 days",
    1:     "all": "All time",
    1:     "custom": "Custom range",
       }
    1: GRANULARITIES = ("day", "week", "month")
    1: BENEFICIARY_SORTS = (
           "external_reference", "transaction_count", "total_quantity",
           "last_transaction", "district",
       )
    1: BENEFICIARY_DEFAULT_SORT = "external_reference"
    1: BENEFICIARY_SORTS_SQL = {
    1:     "external_reference": "b.external_reference COLLATE NOCASE",
    1:     "transaction_count": "transaction_count DESC",
    1:     "total_quantity": "total_quantity DESC",
    1:     "last_transaction": "last_transaction DESC",
    1:     "district": "b.district COLLATE NOCASE",
       }
       
       # --- documented thresholds -------------------------------------------------
    1: INVENTORY_CRITICAL_DAYS = 15
    1: INVENTORY_WARNING_DAYS = 30
    1: FAILURE_RATE_THRESHOLD = 0.10
    1: FAILURE_MIN_TRANSACTIONS = 5
    1: NO_RECENT_DISTRIBUTION_DAYS = 30
       
    1: MAX_PAGE_SIZE = 200
    1: DEFAULT_PAGE_SIZE = 10
       
       
    2: class AnalyticsError(ValueError):
    1:     """Raised for invalid analytics parameters (mapped to HTTP 400)."""
       
       
       # ---------------------------------------------------------------------------
       # Range handling
       # ---------------------------------------------------------------------------
       
       
    1: def resolve_range(range_key: str, from_date: str = None, to_date: str = None):
           """Return ``(start_iso, end_iso)`` — inclusive, ``None`` when unfiltered.
       
           ``range_key`` must be one of RANGES. ``custom`` requires both ``from_date``
           and ``to_date`` as ISO dates (``YYYY-MM-DD``) with from <= to. Date-only
           comparison is used because the database stores both ``YYYY-MM-DD`` and
           ``YYYY-MM-DDTHH:MM:SS`` values.
           """
   47:     if range_key not in RANGES:
    4:         raise AnalyticsError(
    2:             "Invalid range %r. Supported: %s" % (range_key, ", ".join(RANGES))
               )
   45:     if range_key == "all":
   35:         return None, None
   10:     if range_key == "custom":
    9:         if not from_date or not to_date:
    2:             raise AnalyticsError("Custom range requires both 'from' and 'to' (YYYY-MM-DD).")
    7:         try:
    7:             date.fromisoformat(from_date)
    7:             date.fromisoformat(to_date)
               except (TypeError, ValueError):
                   raise AnalyticsError("Invalid date. Use YYYY-MM-DD.")
    7:         if from_date > to_date:
    2:             raise AnalyticsError("'from' must not be after 'to'.")
    5:         return from_date, to_date
    1:     today = date.today().isoformat()
    1:     days = {"today": 0, "7d": 6, "30d": 29}[range_key]
    1:     start = (date.today() - timedelta(days=days)).isoformat()
    1:     return start, today
       
       
    1: def _date_clause(range_key: str, from_date: str = None, to_date: str = None):
           """SQL fragment + params filtering on ``substr(transaction_date, 1, 10)``."""
   47:     start, end = resolve_range(range_key, from_date, to_date)
   41:     if start is None:
   35:         return "", {}
    6:     return (
    6:         " AND substr(transaction_date, 1, 10) BETWEEN :d_start AND :d_end",
    6:         {"d_start": start, "d_end": end},
           )
       
       
    1: def _require_page(page, per_page):
   16:     try:
   16:         page = int(page)
   16:         per_page = int(per_page)
           except (TypeError, ValueError):
               raise AnalyticsError("page and per_page must be integers.")
   16:     if page < 1:
    1:         raise AnalyticsError("page must be >= 1.")
   15:     if per_page < 1 or per_page > MAX_PAGE_SIZE:
    1:         raise AnalyticsError("per_page must be between 1 and %d." % MAX_PAGE_SIZE)
   14:     return page, per_page
       
       
