               " COALESCE(SUM(CASE WHEN t.status IN ('COMPLETED','FAILED') THEN 1 ELSE 0 END), 0) AS total "
               "FROM ration_transactions t LEFT JOIN fps_centers f ON f.id = t.fps_center_id "
               "GROUP BY fps_code"
           ):
    8:         total = r["total"]
    8:         if total < FAILURE_MIN_TRANSACTIONS:
    4:             continue
    4:         rate = r["failed"] / total
    4:         if rate >= FAILURE_RATE_THRESHOLD:
    4:             alerts.append({
    2:                 "alert_id": make_id("FAIL", r["fps_code"]),
    2:                 "category": "HIGH_FAILURE_RATE",
    2:                 "severity": "medium",
    2:                 "title": "Transaction failure rate is elevated",
    4:                 "message": "%d of %d transactions at %s failed (%.0f%% >= %.0f%% threshold). "
    2:                            "Requires human review." % (
    2:                                r["failed"], total, r["fps_code"], rate * 100,
    2:                                FAILURE_RATE_THRESHOLD * 100),
    2:                 "entity_type": "fps_center",
    2:                 "entity_id": r["fps_code"],
    2:                 "failed": r["failed"],
    2:                 "total": total,
    2:                 "failure_rate": round(rate, 4),
                   })
       
           # 3. NO RECENT DISTRIBUTION — per FPS
    3:     cutoff = (date.today() - timedelta(days=recent_days)).isoformat()
    8:     for r in conn.execute(
    3:         "SELECT f.id, f.fps_code, f.name, f.district, "
               " COALESCE(SUM(CASE WHEN t.status = 'COMPLETED' THEN 1 ELSE 0 END), 0) AS completed "
               "FROM fps_centers f LEFT JOIN ration_transactions t "
               "  ON t.fps_center_id = f.id AND substr(t.transaction_date, 1, 10) >= :cutoff "
               "GROUP BY f.id HAVING completed = 0",
    3:         {"cutoff": cutoff},
           ):
    4:         alerts.append({
    2:             "alert_id": make_id("QUIET", r["fps_code"]),
    2:             "category": "NO_RECENT_DISTRIBUTION",
    2:             "severity": "low",
    2:             "title": "No recent distribution activity detected",
    4:             "message": "FPS %s (%s) has no completed transactions in the last "
    2:                        "%d days. Verify the center is operating." % (
    2:                            r["fps_code"], r["district"] or "district unknown",
    2:                            recent_days),
    2:             "entity_type": "fps_center",
    2:             "entity_id": r["fps_code"],
    2:             "recent_days": recent_days,
               })
       
    9:     alerts.sort(key=lambda a: ({"high": 0, "medium": 1, "low": 2}.get(a["severity"], 3), a["alert_id"]))
    3:     return {
    3:         "generated_at": date.today().isoformat(),
    3:         "recent_days": recent_days,
    3:         "count": len(alerts),
    3:         "alerts": alerts,
    3:         "rules": {
