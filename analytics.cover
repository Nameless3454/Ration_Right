       # ---------------------------------------------------------------------------
       # Transaction feed
       # ---------------------------------------------------------------------------
       
       
    2: def transactions(conn: sqlite3.Connection, range_key: str = "all",
    1:                  status: str = None, page: int = 1,
    1:                  per_page: int = DEFAULT_PAGE_SIZE,
    1:                  from_date: str = None, to_date: str = None) -> dict:
    4:     page, per_page = _require_page(page, per_page)
    4:     clause, params = _date_clause(range_key, from_date, to_date)
    4:     if status:
    2:         if status not in ("COMPLETED", "PENDING", "FAILED", "CANCELLED"):
    2:             raise AnalyticsError(
    1:                 "Invalid status %r. Supported: COMPLETED, PENDING, FAILED, CANCELLED." % status
                   )
    1:         clause += " AND t.status = :status"
    1:         params["status"] = status
       
    9:     total = conn.execute(
    3:         "SELECT COUNT(*) AS n FROM ration_transactions t WHERE 1 = 1" + clause,
    3:         params,
    3:     ).fetchone()["n"]
   27:     rows = [
   24:         as_agent_transaction(dict(r)) for r in conn.execute(
    9:             "SELECT t.*, b.external_reference AS beneficiary_external_reference "
                   "FROM ration_transactions t "
                   "LEFT JOIN beneficiaries b ON b.id = t.beneficiary_id "
    3:             "WHERE 1 = 1" + clause +
    3:             " ORDER BY t.transaction_date, t.id LIMIT :limit OFFSET :offset",
    3:             {**params, "limit": per_page, "offset": (page - 1) * per_page},
               )
           ]
    3:     return {
    3:         "total": total,
    3:         "page": page,
    3:         "per_page": per_page,
    3:         "rows": rows,
           }
       
       
