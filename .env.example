# RationAI environment template.
# Copy to `.env` and fill in your own values. Never commit a real key.
# `.env` is git-ignored; shell exports take precedence over `.env` values.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite database file. The default is data/rationright.db (relative to the
# project root). A fresh path is created automatically with the full schema
# on first start — no separate migration step is required.
RATIONRIGHT_DB_PATH=data/rationright.db

# ---------------------------------------------------------------------------
# AI (optional, server-side only — never exposed to the browser)
# ---------------------------------------------------------------------------
# Opt-in switch for LLM-written narratives (Agent 2 explanation, Agent 3
# summary, Agent 4 message, scenario/alert/executive interpretations).
# Deterministic templates are used otherwise; the whole platform works
# without a key.
RATIONRIGHT_LLM_ENABLED=1

# The API key. RationAI talks to any OpenAI-compatible endpoint
# (OpenAI or OpenRouter). Keep this server-side.
OPENAI_API_KEY=

# Required for OpenRouter keys (sk-or-v1-...). Leave unset for api.openai.com.
RATIONRIGHT_LLM_BASE_URL=https://openrouter.ai/api/v1

# Model name served by the endpoint (default: gpt-4o-mini).
RATIONRIGHT_LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Government of India Open Data (OGD) platform connector (optional)
# ---------------------------------------------------------------------------
# API key for the official data.gov.in OGD platform. Server-side only, never
# exposed to the browser. The connector stays CONNECTOR_READY / NOT CONNECTED
# until a real resource id is configured and a sync succeeds. Leave empty for
# the demo — the platform works fully without it.
GOVERNMENT_DATA_API_KEY=

# ---------------------------------------------------------------------------
# Authentication (optional — off by default for the single-operator demo)
# ---------------------------------------------------------------------------
# When set, the API requires a valid session for every route except
# /api/health, /api/ready, /api/auth/* and static files. The frontend then
# shows a sign-in overlay. Leave empty to run open (demo default).
RATIONRIGHT_AUTH_TOKEN=

# Secret used to sign session cookies (HMAC). Required if auth is enabled.
RATIONRIGHT_SESSION_SECRET=

# ---------------------------------------------------------------------------
# CORS (defaults are safe for local/demo use)
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins echoed back (no wildcard).
# Example: https://ops.example.com
RATIONRIGHT_ALLOWED_ORIGINS=

# Set to 1 to restore a blanket Access-Control-Allow-Origin: * (not
# recommended for authenticated deployments).
RATIONRIGHT_CORS_ALLOW_ANY=0

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------
# Maximum rows per imported file (default 500,000).
RATIONRIGHT_MAX_ROWS=500000
