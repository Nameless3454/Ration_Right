           "TX202,BEN001,FPS01,2026-08-02,rice,40,kg\n"
           "TX203,BEN002,FPS02,2026-08-03,wheat,20,kg\n"
           "TX204,BEN002,FPS02,2026-08-04,pulses,60,kg\n"
       )
       
       
