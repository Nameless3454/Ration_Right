    2: class EvaluationScorecardTests(unittest.TestCase):
    1:     """The Phase 15 AI evaluation table — every row must PASS."""
       
    1:     def test_scorecard(self):
    1:         scorecard = []
               # Row 1: missing data -> refuse (insufficient), never estimate.
    1:         db_path = _fresh_db()
    1:         try:
    1:             conn = db.open_db(db_path)
    1:             conn.close()
    1:             r = sim.run_scenario(999999, commodity="rice", db_path=db_path)
    1:             refused = r["status"] == "INSUFFICIENT_DATA" and r.get("risk") is None
    2:             scorecard.append(("Missing data -> refuse", "INSUFFICIENT_DATA",
    1:                               r["status"], "PASS" if refused else "FAIL"))
               finally:
    1:             if os.path.exists(db_path):
    1:                 os.unlink(db_path)
       
               # Row 2: number preservation in scenario context.
    1:         db_path = _fresh_db()
    1:         try:
    1:             imp = _seed_import_with_inventory(db_path)
    1:             gen = RecordingGenerator()
    2:             sim.run_scenario(imp, commodity="rice", demand_change_pct=10,
    1:                              db_path=db_path, generator=gen)
    1:             ctx = gen.calls[0][1]
    2:             scorecard.append(
    2:                 ("Number accuracy (context == calculated)",
    2:                  "exact values", "matches", "PASS"
    1:                  if ctx["scenario_monthly_demand_kg"] == 154.0 else "FAIL"))
               finally:
    1:             if os.path.exists(db_path):
    1:                 os.unlink(db_path)
       
               # Row 3: source attribution is honest.
    1:         db_path = _fresh_db()
    1:         try:
    1:             _seed_import_with_inventory(db_path)
    1:             import command_center
    1:             cc = command_center.command_center(db_path=db_path)
    3:             honest = ("imported dataset" in cc["disclaimer"].lower()
    1:                       and "live government" not in cc["disclaimer"].lower()
    5:                       and "uploaded dataset" in [s["name"].lower()
    2:                                                  for s in cc["sources"]])
    2:             scorecard.append(("Source attribution (imported, not live API)",
    1:                               "honest", "honest" if honest else "misleading",
    1:                               "PASS" if honest else "FAIL"))
               finally:
    1:             if os.path.exists(db_path):
    1:                 os.unlink(db_path)
       
               # Row 4: confidence is deterministic.
    1:         gen = RecordingGenerator(result="confidence: 0.01")
    2:         case = Agent3EvidenceCaseBuilder(narrative_generator=gen).run(
    3:             {"findings": [Agent2AnomalyInvestigator().run(
    2:                 A2_PAYLOAD, finding_id="FIND001")], "transactions": TX})
    1:         deterministic = case["confidence"] == 0.9
    2:         scorecard.append(("Confidence provenance (deterministic)",
    1:                           "0.9", case["confidence"], "PASS" if deterministic else "FAIL"))
       
               # Row 5: AI failure degrades gracefully.
    1:         gen = RecordingGenerator(exc=urllib.error.URLError("down"))
    2:         finding = Agent2AnomalyInvestigator(narrative_generator=gen).run(
    1:             A2_PAYLOAD, finding_id="FIND001")
    1:         graceful = finding["status"] == "verified" and len(gen.calls) == 1
    2:         scorecard.append(("AI failure -> fallback, no retry storm",
    1:                           "graceful", "graceful" if graceful else "crashed",
    1:                           "PASS" if graceful else "FAIL"))
       
    7:         rows = "\n".join("| %s | %s | %s | %s |" % row for row in scorecard)
    1:         print("\nAI EVALUATION SCORECARD\n" + rows)
    6:         for row in scorecard:
    5:             self.assertEqual(row[3], "PASS", row[0])
       
       
    1: if __name__ == "__main__":
           unittest.main()
