    2: class RecordingGenerator:
    1:     """Records every call; returns a scripted string or raises."""
       
    1:     def __init__(self, result=None, exc=None):
   18:         self.result = result
   18:         self.exc = exc
   18:         self.calls = []
       
    1:     def __call__(self, kind, context, fallback):
   20:         self.calls.append((kind, dict(context), fallback))
   20:         if self.exc is not None:
   10:             raise self.exc
   10:         if self.result is not None:
    7:             return self.result
    3:         return "Generated narrative for %s." % kind
       
       
    2: class NumberAccuracyTests(unittest.TestCase):
