    2: class RetryBehaviorTests(unittest.TestCase):
    1:     """Failures fail fast: exactly one attempt, no infinite retry loop."""
       
    1:     def test_failing_generator_called_exactly_once(self):
    1:         gen = RecordingGenerator(exc=RuntimeError("provider down"))
    2:         result = llm.maybe_generate("agent_2_explanation", {"x": 1},
    1:                                     "fallback text", generator=gen)
    1:         self.assertEqual(result, "fallback text")
    1:         self.assertEqual(len(gen.calls), 1)
       
    1:     def test_persistent_failure_resolves_immediately(self):
    1:         import time
    1:         gen = RecordingGenerator(exc=RuntimeError("down"))
    1:         started = time.monotonic()
    4:         for _ in range(3):
    6:             llm.maybe_generate("scenario_interpretation", {"x": 1},
    3:                                "fallback", generator=gen)
    1:         elapsed = time.monotonic() - started
    1:         self.assertEqual(len(gen.calls), 3)
    1:         self.assertLess(elapsed, 2.0, "must not sleep/backoff between failures")
       
       
