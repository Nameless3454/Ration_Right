    2:         result = sim.run_scenario(self.imp_id, commodity="rice",
    1:                                   demand_change_pct=10, db_path=self.db_path,
    1:                                   generator=gen)
    1:         self.assertEqual(result["status"], "completed")
    1:         self.assertEqual(len(gen.calls), 1)
    1:         kind, context, fallback = gen.calls[0]
    1:         self.assertEqual(kind, "scenario_interpretation")
       
               # Every number the AI receives is exactly the code-computed value.
    2:         self.assertEqual(context["baseline_monthly_demand_kg"],
    1:                          result["baseline"]["monthly_demand_kg"])
    2:         self.assertEqual(context["scenario_monthly_demand_kg"],
    1:                          result["scenario"]["projected_monthly_demand_kg"])
    1:         self.assertEqual(context["current_stock_kg"], 3400.0)
    2:         self.assertEqual(context["coverage_days_projected"],
    1:                          result["scenario"]["projected_coverage_days"])
    1:         self.assertEqual(context["reorder_threshold"], 1500.0)
    1:         self.assertEqual(context["risk"], result["risk"])
       
               # The deterministic explanation also carries the same numbers.
    1:         self.assertIn("1500.0", fallback)  # reorder threshold
       
    1:     def test_scenario_math_is_deterministic_not_llm(self):
    1:         gen = RecordingGenerator(result="the projected demand is 999999 kg")
    2:         result = sim.run_scenario(self.imp_id, commodity="rice",
    1:                                   demand_change_pct=10, db_path=self.db_path,
    1:                                   generator=gen)
               # 140 kg over 1 month -> 140; +10% -> 154. The LLM's invented 999999
               # must not appear anywhere in the structured result.
    1:         self.assertEqual(result["scenario"]["projected_monthly_demand_kg"], 154.0)
    1:         self.assertNotEqual(result["scenario"]["projected_monthly_demand_kg"], 999999)
               # Projected daily consumption is the baseline times the multiplier.
    1:         baseline_daily = result["baseline"]["daily_consumption_kg"]
    2:         self.assertEqual(result["scenario"]["projected_daily_consumption_kg"],
    1:                          round(baseline_daily * 1.1, 2))
       
       
    2: class HallucinationRefusalTests(unittest.TestCase):
    1:     """An LLM that invents facts cannot contaminate structured output."""
       
    1:     def test_hostile_generator_cannot_change_evidence_or_severity(self):
    2:         gen = RecordingGenerator(
    1:             result="INVENTED: stock is 42 kg, fraud confirmed, district Chennai.")
    2:         finding = Agent2AnomalyInvestigator(narrative_generator=gen).run(
    1:             A2_PAYLOAD, finding_id="FIND001")
               # Structured fields are calculated, never overwritten by the narrative.
    1:         self.assertEqual(finding["evidence"]["time_difference_minutes"], 12.0)
    1:         self.assertEqual(finding["evidence"]["distance_km"], 1148.09)
    1:         self.assertEqual(finding["status"], "verified")
    1:         self.assertEqual(finding["transaction_ids"], ["TX001", "TX002"])
               # Guilt language is rejected at the sanitizer, falling back to the
               # deterministic text that uses only supplied values.
    1:         self.assertNotIn("fraud", finding["explanation"].lower())
    1:         self.assertIn("12.00 minutes", finding["explanation"])
       
    1:     def test_deterministic_path_never_invents_missing_values(self):
               # No generator, LLM disabled: fallback explanation must only reference
               # values that exist in the payload.
    1:         finding = Agent2AnomalyInvestigator().run(A2_PAYLOAD, finding_id="FIND001")
    1:         explanation = finding["explanation"].lower()
    5:         for invented in ("42 kg", "chennai", "mumbai", "delhi"):
    4:             self.assertNotIn(invented, explanation)
               # It must reference the real evidence.
    1:         self.assertIn("1148.09", finding["explanation"])
    1:         self.assertIn("12.00", finding["explanation"])
       
