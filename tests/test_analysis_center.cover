    1:     def test_precheck_synthetic_honest_disables(self):
    1:         _seed_synthetic(self.conn)
    1:         pre = ac.precheck(dataset_mode="synthetic", db_path=self.db_path)
    1:         self.assertTrue(pre["ok"])
    7:         by_key = {t["key"]: t for t in pre["types"]}
    1:         self.assertTrue(by_key["distribution_anomaly"]["enabled"])
    1:         self.assertTrue(by_key["operational_risk"]["enabled"])
               # no inventory -> disabled with an actionable reason (never faked)
    1:         self.assertFalse(by_key["inventory_risk"]["enabled"])
    1:         self.assertIn("no inventory records", by_key["inventory_risk"]["reason"].lower())
               # synthetic history is short -> forecast honestly disabled
    1:         self.assertFalse(by_key["demand_forecast"]["enabled"])
    1:         self.assertIn("historical month", by_key["demand_forecast"]["reason"].lower())
       
    1:     def test_precheck_real_dataset_enables_with_data(self):
