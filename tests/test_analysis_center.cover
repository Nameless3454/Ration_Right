    2: class AnalysisCenterApiTests(unittest.TestCase):
    1:     """End-to-end API tests against the real server (dev DB)."""
       
    1:     @classmethod
    1:     def setUpClass(cls):
    1:         cls.server = make_server("127.0.0.1", 0)
    1:         cls.port = cls.server.server_address[1]
    1:         cls.base = f"{BASE}:{cls.port}"
    1:         cls.thread = threading.Thread(target=cls.server.serve_forever, daemon=True)
    1:         cls.thread.start()
       
    1:     @classmethod
    1:     def tearDownClass(cls):
    1:         cls.server.shutdown()
    1:         cls.server.server_close()
       
    1:     def request(self, method, path, body=None):
    9:         data = json.dumps(body).encode("utf-8") if body is not None else None
    9:         headers = {"Content-Type": "application/json"} if data else {}
    9:         req = urllib.request.Request(self.base + path, data=data, method=method, headers=headers)
    9:         try:
    9:             with urllib.request.urlopen(req, timeout=30) as response:
    5:                 return response.status, json.loads(response.read().decode("utf-8"))
    4:         except urllib.error.HTTPError as exc:
    4:             return exc.code, json.loads(exc.read().decode("utf-8"))
       
    1:     def test_types_endpoint(self):
    1:         status, payload = self.request("GET", "/api/analysis/types")
    1:         self.assertEqual(status, 200)
    1:         self.assertEqual(len(payload["types"]), 5)
       
