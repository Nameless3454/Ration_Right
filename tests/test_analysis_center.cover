    1:     def test_run_analysis_synthetic_merges_insights(self):
    1:         _seed_synthetic(self.conn)
    2:         r = ac.run_analysis(
    1:             dataset_mode="synthetic",
    1:             types=["distribution_anomaly", "recommendations", "operational_risk",
                          "inventory_risk", "demand_forecast"],
    1:             db_path=self.db_path,
               )
    1:         self.assertIsNotNone(r)
               # merged result keeps the Phase 6 shape
    1:         self.assertEqual(r["workflow_status"], "completed")
    1:         self.assertIn("insights", r)
    1:         self.assertGreaterEqual(len(r["insights"]), 5)  # 4 forecast + anomaly + rec
    1:         self.assertIn("types", r)
    1:         self.assertEqual(r["types"]["distribution_anomaly"]["status"], "completed")
    1:         self.assertEqual(r["types"]["recommendations"]["status"], "completed")
    1:         self.assertEqual(r["types"]["inventory_risk"]["status"], "insufficient_data")
               # analysis run persisted with the real id stamped on sources
    1:         run = r["analysis_run"]
    1:         self.assertTrue(run["analysis_id"].startswith("RA-"))
    7:         for i in r["insights"]:
    6:             self.assertEqual(i["source"]["analysis_id"], run["analysis_id"])
               # real stage timings from the orchestrator
    2:         self.assertEqual(set((r.get("timings") or {}).keys()),
    1:                          {"agent_1", "agent_2", "agent_3", "agent_4"})
       
