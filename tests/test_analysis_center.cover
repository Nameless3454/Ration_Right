    1:     def test_operational_risk_detects_failure_rate(self):
    1:         imp_id = _seed_real(self.conn, with_inventory=False, with_failures=True)
    1:         conn = db.open_db(self.db_path)
    1:         try:
    1:             ops = ac.operational_risk_insights(conn, imp_id, {"analysis_id": "RA-T"})
               finally:
    1:             conn.close()
    3:         failure = [o for o in ops if "failure rate" in o["title"].lower()]
    1:         self.assertEqual(len(failure), 1)
    1:         self.assertGreaterEqual(failure[0]["evidence"]["failure_rate"], 0.10)
    1:         self.assertEqual(failure[0]["insight_type"], "OPERATIONAL_RISK")
       
    1:     def test_inventory_risk_projects_days_remaining(self):
    1:         imp_id = _seed_real(self.conn)
    1:         conn = db.open_db(self.db_path)
    1:         try:
    1:             inv = ac.inventory_risk_insights(conn, imp_id, {"analysis_id": "RA-T"})
               finally:
    1:             conn.close()
               # stock 200, monthly 900 -> days = 200/(900/30) = 6.7 -> CRITICAL
    1:         self.assertEqual(len(inv), 1)
    1:         self.assertEqual(inv[0]["severity"], "CRITICAL")
    1:         self.assertAlmostEqual(inv[0]["evidence"]["days_remaining"], 6.7, places=1)
    1:         self.assertFalse(inv[0]["deterministic"] is True and False)  # deterministic flag is True
    1:         self.assertTrue(inv[0]["deterministic"])
       
    1:     def test_demand_forecast_sufficient_and_insufficient(self):
