    1: def _seed_synthetic(conn):
    3:     db.seed_synthetic(conn)
       
       
    1: def _seed_real(conn, months=4, with_inventory=True, with_failures=True):
           """A real import with enough history for every deterministic check."""
    5:     src = db.get_data_source_by_name(conn, "Uploaded Dataset")
   15:     src_id = db.insert_data_source(
    5:         conn, name="Uploaded Dataset", source_type="MANUAL",
    5:         description="t", status="ACTIVE",
    5:     ) if src is None else src["id"]
   10:     imp_id = db.insert_data_import(
    5:         conn, data_source_id=src_id, dataset_name="pds_aug",
    5:         file_name="pds_aug.csv", file_type="CSV", record_count=100,
    5:         successful_records=100, status="COMPLETED",
           )
   10:     db.upsert_beneficiaries(conn, [{"external_reference": "RB1", "district": "Lucknow",
    5:                                     "ration_category": "AAY", "family_size": 4, "status": "ACTIVE"}])
    5:     ben = db.beneficiary_ids(conn, ["RB1"])
   10:     db.upsert_fps_centers(conn, [{"fps_code": "FPS1", "name": "Center One", "district": "Lucknow",
    5:                                   "state": "UP", "status": "ACTIVE"}])
    5:     fps = db.fps_center_ids(conn, ["FPS1"])
    5:     rows = []
    5:     seq = 0
   25:     for month in range(months):
   20:         m = "%02d" % (5 + month)  # 2026-05 .. 2026-08
   80:         for i in range(3):
   60:             seq += 1
   60:             status = "FAILED" if (with_failures and i >= 1 and month == 0) else "COMPLETED"
  120:             rows.append({
   60:                 "external_transaction_id": "TX%04d" % seq,
   60:                 "beneficiary_id": ben["RB1"], "fps_center_id": fps["FPS1"],
   60:                 "transaction_date": "2026-%s-%02d" % (m, i + 1),
   60:                 "commodity": "rice", "quantity": 100.0 + i * 10, "unit": "kg",
   60:                 "latitude": 26.8, "longitude": 80.9, "status": status,
   60:                 "source_import_id": imp_id,
                   })
    5:     db.insert_transactions_batch(conn, rows)
    5:     if with_inventory:
    8:         db.insert_inventory_batch(conn, [{
    4:             "fps_center_id": fps["FPS1"], "commodity": "rice",
    4:             "current_stock": 200.0, "monthly_consumption": 900.0,
    4:             "reorder_threshold": 150.0, "source_import_id": imp_id,
               }])
    5:     conn.commit()
    5:     return imp_id
       
       
