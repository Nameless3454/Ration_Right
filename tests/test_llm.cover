    1:         self.assertEqual(alert["status"], "open")
       
    1:     def test_default_path_unchanged_without_env(self):
               # Without env vars, no generator is invoked and deterministic text is used.
    1:         self.assertNotIn("RATIONRIGHT_LLM_ENABLED", os.environ)
    1:         finding = Agent2AnomalyInvestigator().run(A2_PAYLOAD, finding_id="FIND001")
    1:         self.assertIn("12.00 minutes apart", finding["explanation"])
    1:         case = Agent3EvidenceCaseBuilder().run({"findings": [A2_VERIFIED], "transactions": TX})
    1:         self.assertIn("12.00 minutes apart", case["summary"])
    1:         alert = Agent4AlertGenerator().run(A3_CASE)
    1:         self.assertIn("12.0 minutes apart", alert["message"])
       
    1:     def test_agent_4_llm_generation_never_touches_evidence_field(self):
               # Phase 9 guard: the Alert schema has no evidence field, so there is
               # nothing for the LLM to overwrite; the message is the only narrative.
    1:         generator = mock.MagicMock(return_value="Custom alert text.")
    1:         alert = Agent4AlertGenerator(narrative_generator=generator).run(A3_CASE)
    1:         self.assertEqual(set(alert.keys()), {
                   "alert_id", "case_id", "severity", "title", "message",
                   "recommended_action", "status",
               })
       
       
