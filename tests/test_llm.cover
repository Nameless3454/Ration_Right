    2: class TestAgentWiring(unittest.TestCase):
    1:     """Injected generators must replace narratives but never structured fields."""
       
    1:     def test_agent_2_explanation_replaced_evidence_untouched(self):
    1:         generator = mock.MagicMock(return_value="LLM explanation of the verified anomaly.")
    2:         finding = Agent2AnomalyInvestigator(narrative_generator=generator).run(
    1:             A2_PAYLOAD, finding_id="FIND001"
               )
    1:         self.assertEqual(finding["explanation"], "LLM explanation of the verified anomaly.")
    2:         self.assertEqual(
    1:             finding["evidence"],
    1:             {"time_difference_minutes": 12.0, "distance_km": 1148.09},
               )
    1:         self.assertEqual(finding["status"], "verified")
    1:         self.assertEqual(finding["transaction_ids"], ["TX001", "TX002"])
    1:         self.assertEqual(finding["anomaly_id"], "ANOM001")
    1:         generator.assert_called_once()
    1:         kind, context, _ = generator.call_args[0]
    1:         self.assertEqual(kind, "agent_2_explanation")
    1:         self.assertEqual(context["time_difference_minutes"], 12.0)
    1:         self.assertEqual(context["distance_km"], 1148.09)
       
    1:     def test_agent_2_generator_failure_falls_back(self):
    1:         def boom(kind, context, fallback):
    1:             raise RuntimeError("LLM down")
       
    2:         finding = Agent2AnomalyInvestigator(narrative_generator=boom).run(
    1:             A2_PAYLOAD, finding_id="FIND001"
               )
    1:         self.assertIn("12.00 minutes apart", finding["explanation"])
    1:         self.assertEqual(finding["evidence"]["distance_km"], 1148.09)
       
    1:     def test_agent_3_summary_replaced_evidence_untouched(self):
    1:         generator = mock.MagicMock(return_value="LLM case summary for review.")
    2:         case = Agent3EvidenceCaseBuilder(narrative_generator=generator).run(
    1:             {"findings": [A2_VERIFIED], "transactions": TX}
               )
    1:         self.assertEqual(case["summary"], "LLM case summary for review.")
    1:         self.assertEqual(case["status"], "requires_human_review")
    1:         self.assertEqual(case["severity"], "high")
    1:         self.assertEqual(case["confidence"], 0.9)
    1:         self.assertEqual(case["finding_ids"], ["FIND001"])
    2:         self.assertEqual(
    1:             case["evidence"],
    1:             [
    1:                 {"type": "time_difference", "value": 12.0, "unit": "minutes"},
    1:                 {"type": "distance", "value": 1148.09, "unit": "km"},
                   ],
               )
    1:         kind, context, _ = generator.call_args[0]
    1:         self.assertEqual(kind, "agent_3_summary")
    1:         self.assertEqual(context["transaction_ids"], ["TX001", "TX002"])
    1:         self.assertEqual(context["beneficiaries"], ["BEN001"])
       
    1:     def test_agent_3_generator_failure_falls_back(self):
    1:         def boom(kind, context, fallback):
    1:             raise RuntimeError("LLM down")
       
    2:         case = Agent3EvidenceCaseBuilder(narrative_generator=boom).run(
    1:             {"findings": [A2_VERIFIED], "transactions": TX}
               )
    1:         self.assertIn("TX001", case["summary"])
    1:         self.assertIn("12.00 minutes apart", case["summary"])
    1:         self.assertEqual(case["evidence"][1]["value"], 1148.09)
       
    1:     def test_agent_4_message_replaced_evidence_untouched(self):
    1:         generator = mock.MagicMock(return_value="LLM alert message for the reviewer.")
    1:         alert = Agent4AlertGenerator(narrative_generator=generator).run(A3_CASE)
    1:         self.assertEqual(alert["message"], "LLM alert message for the reviewer.")
    1:         self.assertEqual(alert["status"], "open")
    1:         self.assertEqual(alert["severity"], "high")
    1:         self.assertEqual(alert["case_id"], "CASE001")
    1:         self.assertEqual(alert["recommended_action"], "Human verification")
    1:         kind, context, _ = generator.call_args[0]
    1:         self.assertEqual(kind, "agent_4_message")
    1:         self.assertEqual(context["case_id"], "CASE001")
       
    1:     def test_agent_4_generator_failure_falls_back(self):
