    1:         self.assertEqual(len(result["cases"]), 1)
    1:         self.assertEqual(len(result["alerts"]), 1)
       
    1:         case = result["cases"][0]
    1:         self.assertEqual(case["finding_ids"], ["FIND001", "FIND002"])
    6:         values = [e["value"] for e in case["evidence"]]
    1:         self.assertEqual(values[0], 5.0)
    1:         self.assertAlmostEqual(values[1], round(haversine_km(19.0760, 72.8777, 28.6139, 77.2090), 2), places=2)
    1:         self.assertEqual(values[2], 10.0)
