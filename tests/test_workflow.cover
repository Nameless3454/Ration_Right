    1: def failing_agent_2(fail_for):
           """Wrap the real Agent 2 but raise for the given anomaly IDs."""
    1:     real = Agent2AnomalyInvestigator()
       
    2:     class _Wrapper:
    1:         def run(self, payload, finding_id="FIND001"):
    2:             anomaly_id = payload["anomaly"]["anomaly_id"]
    2:             if anomaly_id in fail_for:
    1:                 raise ValueError(f"forced Agent 2 failure for {anomaly_id}")
    1:             return real.run(payload, finding_id=finding_id)
       
    1:     return _Wrapper()
       
       
