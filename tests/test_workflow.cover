    2: class TestWorkflowAgent2Failure(unittest.TestCase):
    1:     """TEST 4 — a failing candidate is recorded; valid candidates continue."""
       
    1:     def test_failed_candidate_recorded_and_others_continue(self):
    2:         result = run_workflow(
    1:             multi_anomaly_transactions(),
    1:             agent_2=failing_agent_2({"ANOM001"}),
               )
    1:         self.assertEqual(result["workflow_status"], "partial_failure")
    1:         self.assertEqual(len(result["errors"]), 1)
    1:         error = result["errors"][0]
    1:         self.assertEqual(error["stage"], "agent_2")
    1:         self.assertEqual(error["anomaly_id"], "ANOM001")
    1:         self.assertEqual(error["status"], "failed")
    1:         self.assertIn("forced Agent 2 failure", error["error"])
       
               # No fabricated finding for the failed candidate; the other continues.
    1:         self.assertEqual(len(result["findings"]), 1)
    1:         self.assertEqual(result["findings"][0]["anomaly_id"], "ANOM002")
    1:         self.assertEqual(len(result["cases"]), 1)
    1:         self.assertEqual(len(result["alerts"]), 1)
       
       
