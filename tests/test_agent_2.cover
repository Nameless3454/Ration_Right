    1:             make_tx("TX002", "BEN901", "2026-08-01T10:12:00", 28.6139, 77.2090),
               ]
    2:         finding = Agent2AnomalyInvestigator().run({
    1:             "anomaly": candidate(beneficiary_id="BEN900"),
