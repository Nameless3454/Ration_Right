    2: class TestAgent2Boundary(unittest.TestCase):
    1:     """TEST 8 — behavior around the configured thresholds is deterministic."""
       
    1:     def _verify(self, tx_a, tx_b):
    6:         return Agent2AnomalyInvestigator().run({
    3:             "anomaly": candidate(transaction_ids=("TX001", "TX002")),
    3:             "transactions": [tx_a, tx_b],
               })
       
    1:     def test_interval_at_threshold_and_distance_just_above(self):
               # Exactly 60 minutes and ~100.08 km: both inclusive bounds hold.
    1:         tx_a = make_tx("TX001", "BEN001", "2026-08-01T10:00:00", 0.0, 0.0)
    1:         tx_b = make_tx("TX002", "BEN001", "2026-08-01T11:00:00", 0.9, 0.0)
    1:         finding = self._verify(tx_a, tx_b)
    1:         self.assertEqual(finding["status"], "verified")
       
    1:     def test_distance_just_below_threshold(self):
               # ~99.96 km: just under the 100 km inclusive bound.
    1:         tx_a = make_tx("TX001", "BEN001", "2026-08-01T10:00:00", 0.0, 0.0)
    1:         tx_b = make_tx("TX002", "BEN001", "2026-08-01T11:00:00", 0.899, 0.0)
    1:         finding = self._verify(tx_a, tx_b)
    1:         self.assertEqual(finding["status"], "unverified")
       
    1:     def test_interval_just_above_threshold(self):
               # 60.02 minutes: just over the 60 min inclusive bound.
    1:         tx_a = make_tx("TX001", "BEN001", "2026-08-01T10:00:00", 0.0, 0.0)
    1:         tx_b = make_tx("TX002", "BEN001", "2026-08-01T11:00:01", 2.0, 0.0)
    1:         finding = self._verify(tx_a, tx_b)
    1:         self.assertEqual(finding["status"], "unverified")
       
       
    2: class TestAgent2Agent1Compatibility(unittest.TestCase):
    1:     """TEST 9 — Agent 2 consumes real Agent 1 output without rewriting."""
       
    1:     def test_consumes_actual_agent_1_output(self):
    1:         dataset = load_dataset(DEFAULT_DATASET_PATH)
    1:         transactions = dataset["transactions"]
    1:         agent1_result = Agent1TransactionAnalyst().run(transactions)
    1:         self.assertGreaterEqual(len(agent1_result["anomalies"]), 1)
       
    1:         anomaly = agent1_result["anomalies"][0]
    2:         finding = Agent2AnomalyInvestigator().run({
    1:             "anomaly": anomaly,
    1:             "transactions": transactions,
               })
    1:         self.assertEqual(finding["status"], "verified")
    1:         self.assertEqual(finding["anomaly_id"], anomaly["anomaly_id"])
    1:         self.assertEqual(finding["transaction_ids"], anomaly["transaction_ids"])
    1:         self.assertEqual(finding["evidence"]["time_difference_minutes"], 12.0)
    1:         self.assertAlmostEqual(finding["evidence"]["distance_km"], 1148.09, places=2)
       
       
    2: class TestAgent2InvalidCandidate(unittest.TestCase):
    1:     """Malformed candidates and payloads are rejected safely."""
       
    1:     def test_malformed_candidate_raises(self):
    1:         investigator = Agent2AnomalyInvestigator()
    1:         with self.assertRaises(ValueError):
    2:             investigator.run({"anomaly": {"transaction_ids": ["TX001"]}, "transactions": []})
    1:         with self.assertRaises(ValueError):
    2:             investigator.run({"anomaly": {"anomaly_id": "ANOM001", "transaction_ids": "TX001"}, "transactions": []})
    1:         with self.assertRaises(ValueError):
    2:             investigator.run({"anomaly": {"anomaly_id": "ANOM001", "transaction_ids": ["TX001", 42]}, "transactions": []})
    1:         with self.assertRaises(ValueError):
    2:             investigator.run({"anomaly": "not-a-dict", "transactions": []})
    1:         with self.assertRaises(ValueError):
    2:             investigator.run("not-a-payload")
       
       
    1: if __name__ == "__main__":
           unittest.main()
