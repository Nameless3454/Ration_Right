    2:         finding = Agent2AnomalyInvestigator().run({
    1:             "anomaly": candidate(transaction_ids=("TX001", "TX999")),
    1:             "transactions": transactions,
               })
    1:         self.assertEqual(finding["status"], "unverified")
    1:         self.assertEqual(finding["evidence"], {})
    1:         self.assertEqual(finding["evidence_sources"], [])
    1:         self.assertIn("TX999", finding["explanation"])
       
    1:     def test_empty_transaction_list(self):
    2:         finding = Agent2AnomalyInvestigator().run({
    1:             "anomaly": candidate(),
    1:             "transactions": [],
               })
    1:         self.assertEqual(finding["status"], "unverified")
    1:         self.assertEqual(finding["evidence"], {})
       
       
