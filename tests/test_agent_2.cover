    1: def make_tx(transaction_id, beneficiary_id, timestamp, latitude, longitude,
                   ration_type="rice", quantity=10):
           """Build a contract-compliant synthetic transaction record."""
   23:     return {
   23:         "transaction_id": transaction_id,
   23:         "beneficiary_id": beneficiary_id,
   23:         "timestamp": timestamp,
   23:         "latitude": latitude,
   23:         "longitude": longitude,
   23:         "ration_type": ration_type,
   23:         "quantity": quantity,
           }
       
       
    1: def candidate(anomaly_id="ANOM001", transaction_ids=("TX001", "TX002"),
                     beneficiary_id="BEN001", severity="high",
                     reason="Two transactions occurred within a short time interval at distant locations."):
           """Build an Agent 1-style anomaly candidate."""
   15:     return {
   15:         "anomaly_id": anomaly_id,
   15:         "anomaly_type": "rapid_geographic_transaction",
   15:         "transaction_ids": list(transaction_ids),
   15:         "beneficiary_id": beneficiary_id,
   15:         "reason": reason,
   15:         "severity": severity,
           }
       
       
    2: class TestAgent2ValidCandidate(unittest.TestCase):
    1:     """TEST 1 — the real planted anomaly is verified with calculated evidence."""
       
    1:     @classmethod
    1:     def setUpClass(cls):
    1:         cls.transactions = load_dataset(DEFAULT_DATASET_PATH)["transactions"]
    2:         cls.finding = Agent2AnomalyInvestigator().run({
    1:             "anomaly": candidate(),
    1:             "transactions": cls.transactions,
               })
       
    1:     def test_status_verified(self):
    1:         self.assertEqual(self.finding["status"], "verified")
       
    1:     def test_evidence_contains_actual_calculations(self):
    1:         self.assertEqual(self.finding["evidence"]["time_difference_minutes"], 12.0)
    1:         self.assertAlmostEqual(self.finding["evidence"]["distance_km"], 1148.09, places=2)
       
    1:     def test_contract_fields(self):
    1:         self.assertEqual(set(self.finding.keys()), FINDING_FIELDS)
    1:         self.assertEqual(self.finding["anomaly_id"], "ANOM001")
    1:         self.assertEqual(self.finding["transaction_ids"], ["TX001", "TX002"])
    1:         self.assertEqual(self.finding["evidence_sources"], ["TX001", "TX002"])
    1:         self.assertTrue(self.finding["explanation"])
       
    1:     def test_evidence_is_calculated_not_a_template(self):
               """Different input data must produce different calculated evidence."""
    1:         transactions = [
    1:             make_tx("TX900", "BEN900", "2026-08-01T10:00:00", 19.0760, 72.8777),
    1:             make_tx("TX901", "BEN900", "2026-08-01T10:25:00", 23.0225, 72.5714),
               ]
    2:         anomaly = candidate(anomaly_id="ANOM900", transaction_ids=("TX900", "TX901"),
    1:                             beneficiary_id="BEN900", reason="test")
    1:         finding = Agent2AnomalyInvestigator().run({"anomaly": anomaly, "transactions": transactions})
    1:         self.assertEqual(finding["status"], "verified")
    1:         self.assertEqual(finding["evidence"]["time_difference_minutes"], 25.0)
    1:         expected_distance = haversine_km(19.0760, 72.8777, 23.0225, 72.5714)
    1:         self.assertAlmostEqual(finding["evidence"]["distance_km"], expected_distance, places=2)
       
    1:     def test_explanation_avoids_guilt_language(self):
    1:         text = self.finding["explanation"].lower()
    1:         self.assertNotIn("guilty", text)
    1:         self.assertNotIn("fraud", text)
    1:         self.assertNotIn("committed", text)
    1:         self.assertIn("human verification", text)
       
       
    2: class TestAgent2MissingTransaction(unittest.TestCase):
    1:     """TEST 2 — a missing transaction cannot be verified and invents nothing."""
       
    1:     def test_one_transaction_missing(self):
