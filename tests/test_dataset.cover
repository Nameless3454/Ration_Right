    1:     def test_08_planted_anomaly_satisfies_pattern(self):
               """TEST 8: the planted pair shares a beneficiary, is within the short
               interval, and is geographically far apart."""
    1:         report = verify_planted_anomaly(self.transactions)
    1:         self.assertTrue(report["present"], report)
    1:         self.assertTrue(report["pattern_satisfied"], report)
    1:         self.assertTrue(report["conditions"]["same_beneficiary"], report)
    1:         self.assertTrue(report["conditions"]["short_time_interval"], report)
    1:         self.assertTrue(report["conditions"]["large_geographic_distance"], report)
    1:         self.assertLessEqual(report["time_difference_minutes"], SHORT_INTERVAL_MINUTES)
    1:         self.assertGreaterEqual(report["distance_km"], LARGE_DISTANCE_KM)
       
    1:     def test_09_normal_transactions_do_not_trip_threshold(self):
