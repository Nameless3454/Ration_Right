    1: BASE = "http://127.0.0.1"
       
       
    1: def request(method, url, body=None):
   12:     data = json.dumps(body).encode("utf-8") if body is not None else None
   12:     headers = {"Content-Type": "application/json"} if data else {}
   12:     req = urllib.request.Request(url, data=data, method=method, headers=headers)
   12:     try:
   12:         with urllib.request.urlopen(req, timeout=15) as response:
    9:             return response.status, response.read().decode("utf-8"), dict(response.headers)
    3:     except urllib.error.HTTPError as exc:
    3:         return exc.code, exc.read().decode("utf-8"), dict(exc.headers)
       
       
    2: class TestRationRightAPI(unittest.TestCase):
