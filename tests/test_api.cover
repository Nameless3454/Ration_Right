    1:         result = json.loads(body)
    1:         _, dataset_body, _ = request("GET", self.base + "/api/dataset")
   27:         real_ids = {t["transaction_id"] for t in json.loads(dataset_body)["transactions"]}
       
    1:         alert = result["alerts"][0]
    1:         case = result["cases"][0]
    1:         finding = result["findings"][0]
    1:         anomaly = result["anomalies"][0]
    1:         self.assertEqual(alert["case_id"], case["case_id"])
    1:         self.assertEqual(case["finding_ids"], [finding["finding_id"]])
    1:         self.assertEqual(finding["anomaly_id"], anomaly["anomaly_id"])
    1:         self.assertTrue(set(anomaly["transaction_ids"]).issubset(real_ids))
    1:         self.assertEqual(anomaly["transaction_ids"], ["TX001", "TX002"])
       
    1:     def test_analyze_evidence_matches_calculation(self):
               """The alert carries the exact calculated evidence (no mocks)."""
