    1:         self.assertAlmostEqual(finding["evidence"]["distance_km"], 1148.09, places=2)
    1:         alert = result["alerts"][0]
    1:         self.assertIn("12.0", alert["message"])
    1:         self.assertIn("1148.09", alert["message"])
       
    1:     def test_unknown_dataset_rejected(self):
               # Phase 6: "real" is now a valid mode but requires data_import_id;
               # a bogus mode name is still rejected.
    1:         status, body, _ = request("POST", self.base + "/api/analyze", {"dataset": "bogus"})
    1:         self.assertEqual(status, 400)
    1:         self.assertIn("Unknown dataset mode", body)
    1:         status, body, _ = request("POST", self.base + "/api/analyze", {"dataset": "real"})
    1:         self.assertEqual(status, 400)
    1:         self.assertIn("data_import_id", body)
       
