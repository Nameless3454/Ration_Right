    2: class FetcherRetryTests(unittest.TestCase):
    1:     """Unit tests for the HTTP fetcher's retry/backoff policy."""
       
    1:     def _patch_urlopen(self, responses, sleep_log=None):
    4:         import connectors.fetcher as fetcher_mod
       
    4:         calls = {"n": 0}
       
    8:         class FakeResp:
    4:             def __init__(self, data):
    2:                 self._data = data
       
    4:             def getcode(self):
    2:                 return 200
       
    4:             def __enter__(self):
    2:                 return self
       
    4:             def __exit__(self, *a):
    2:                 return False
       
    4:             def read(self):
    2:                 return self._data
       
    8:         class FakeURLError(urllib.error.URLError):
    4:             pass
       
    4:         def fake_urlopen(request, timeout=None):
    8:             calls["n"] += 1
    8:             resp = responses[min(calls["n"] - 1, len(responses) - 1)]
    8:             if isinstance(resp, Exception):
                       raise resp
    8:             if isinstance(resp, int):
    6:                 raise urllib.error.HTTPError(request.full_url, resp, "err", {}, None)
    2:             return FakeResp(resp)
       
    4:         self._orig = fetcher_mod.urllib.request.urlopen
    4:         fetcher_mod.urllib.request.urlopen = fake_urlopen
    4:         self._fetcher_mod = fetcher_mod
    4:         self.addCleanup(setattr, fetcher_mod.urllib.request, "urlopen", self._orig)
    4:         return calls
       
    1:     def test_success(self):
    1:         calls = self._patch_urlopen([b"data"])
    1:         self.assertEqual(http_get_bytes("http://x"), b"data")
    1:         self.assertEqual(calls["n"], 1)
       
    1:     def test_404_no_retry(self):
    1:         calls = self._patch_urlopen([404])
    1:         with self.assertRaises(HttpStatusError) as cm:
    2:             http_get_bytes("http://x")
    1:         self.assertEqual(cm.exception.status, 404)
    1:         self.assertFalse(cm.exception.retryable)
    1:         self.assertEqual(calls["n"], 1)  # permanent error: exactly one attempt
       
    1:     def test_500_retries_then_succeeds(self):
    1:         sleep_log = []
    1:         calls = self._patch_urlopen([500, 500, b"ok"])
    1:         self.assertEqual(http_get_bytes("http://x", sleep=sleep_log.append), b"ok")
    1:         self.assertEqual(calls["n"], 3)
    1:         self.assertEqual(len(sleep_log), 2)  # backoff between attempts
       
    1:     def test_500_exhausts_attempts(self):
    1:         calls = self._patch_urlopen([500, 500, 500, 500])
    1:         with self.assertRaises(HttpStatusError):
    2:             http_get_bytes("http://x", max_attempts=3)
    1:         self.assertEqual(calls["n"], 3)
       
    1:     def test_429_respects_retry_after(self):
    1:         import connectors.fetcher as fetcher_mod
    1:         import urllib.error as ue
       
    1:         calls = {"n": 0}
    1:         sleep_log = []
       
    1:         def fake_urlopen(request, timeout=None):
    2:             calls["n"] += 1
    2:             if calls["n"] == 1:
    1:                 e = ue.HTTPError(request.full_url, 429, "too many", {}, None)
    1:                 e.headers = {"Retry-After": "2"}
    1:                 raise e
       
    2:             class FakeResp:
    1:                 def getcode(self):
    1:                     return 200
       
    1:                 def __enter__(self):
    1:                     return self
       
    1:                 def __exit__(self, *a):
    1:                     return False
       
    1:                 def read(self):
    1:                     return b"ok"
       
    1:             return FakeResp()
       
    1:         orig = fetcher_mod.urllib.request.urlopen
    1:         fetcher_mod.urllib.request.urlopen = fake_urlopen
    1:         self.addCleanup(setattr, fetcher_mod.urllib.request, "urlopen", orig)
    1:         self.assertEqual(http_get_bytes("http://x", sleep=sleep_log.append), b"ok")
    1:         self.assertEqual(sleep_log, [2.0])  # honoured Retry-After
       
    1:     def test_timeout_retries(self):
    1:         import connectors.fetcher as fetcher_mod
       
    1:         calls = {"n": 0}
    1:         sleep_log = []
       
    1:         def fake_urlopen(request, timeout=None):
