    1: """RationRight — Phase 14: Security, Reliability & Production Hardening tests.
       
       Covers the audit-log database layer, security headers, same-origin CORS
       (default) and configured-origin behavior, opt-in bearer-token authentication
       (login / logout / session revocation / forged-token rejection / route
       protection / login rate limiting), readiness endpoint, input validation (bad
       date ranges, SQL-injection attempts on filters, clamped pagination), upload
       hardening (extension, magic bytes, size), import rollback atomicity (a
       critical failure leaves no partial dataset), error sanitization (no stack
       traces / filesystem paths leaked), and a source-wide hardcoded-secret scan.
       
       Run from the project root::
       
           python3 -m unittest discover -s tests -t . -v
       """
       
    1: import http.client
    1: import importlib
    1: import json
    1: import os
    1: import re
    1: import tempfile
    1: import threading
    1: import unittest
    1: import urllib.error
    1: import urllib.parse
    1: import urllib.request
    1: from pathlib import Path
       
    1: import database as db
       
    1: BASE = "http://127.0.0.1"
    1: ROOT = Path(__file__).resolve().parent.parent
       
    1: TRANSACTION_CSV = (
    1:     "Transaction ID,Beneficiary ID,FPS Code,Transaction Date,Commodity,Quantity,Unit\n"
           "TX1001,BEN001,FPS01,2026-08-01,rice,10,kg\n"
           "TX1002,BEN001,FPS01,2026-08-02,rice,5,kg\n"
           "TX1003,BEN002,FPS02,2026-08-01,wheat,8,kg\n"
       )
       
    1: _ENV_KEYS = ("RATIONRIGHT_AUTH_TOKEN", "RATIONRIGHT_ALLOWED_ORIGINS",
                    "RATIONRIGHT_CORS_ALLOW_ANY", "RATIONRIGHT_SESSION_SECRET")
       
       
    1: def _fresh_db():
   19:     tmp = tempfile.NamedTemporaryFile(suffix=".db", delete=False)
   19:     tmp.close()
   19:     os.unlink(tmp.name)
   19:     return tmp.name
       
       
    2: class _ServerContext:
    1:     """A live server in a fresh process-independent env (module reloaded)."""
       
    1:     def __init__(self, env=None, db_path=None):
  108:         self.saved = {k: os.environ.get(k) for k in _ENV_KEYS}
   90:         for k in _ENV_KEYS:
   72:             os.environ.pop(k, None)
   18:         if env:
    5:             os.environ.update(env)
   18:         import server as srv
   18:         srv = importlib.reload(srv)
   18:         self.srv = srv
   18:         self.db_path = db_path or _fresh_db()
   18:         self.httpd = srv.make_server(port=0, db_path=self.db_path)
   18:         self.port = self.httpd.server_address[1]
   18:         threading.Thread(target=self.httpd.serve_forever, daemon=True).start()
       
    1:     def close(self):
   18:         self.httpd.shutdown()
   18:         self.httpd.server_close()
   90:         for k, v in self.saved.items():
   72:             if v is None:
   72:                 os.environ.pop(k, None)
                   else:
                       os.environ[k] = v
   18:         import server as srv
   18:         importlib.reload(srv)
   18:         if os.path.exists(self.db_path):
   18:             os.unlink(self.db_path)
       
    1:     def request(self, method, path, data=None, headers=None, timeout=30):
   74:         req = urllib.request.Request(
   37:             "%s:%d%s" % (BASE, self.port, path), data=data,
   37:             headers=headers or {}, method=method)
   37:         try:
   37:             with urllib.request.urlopen(req, timeout=timeout) as resp:
   18:                 return resp.status, dict(resp.headers), resp.read()
   19:         except urllib.error.HTTPError as exc:
   18:             return exc.code, dict(exc.headers), exc.read()
       
       
    2: class SecretScanTests(unittest.TestCase):
    1:     """No hardcoded secrets anywhere outside the git-ignored .env."""
       
    1:     def test_no_hardcoded_api_keys_in_source(self):
               # Match real key shapes only, so UI class names ("risk-grid"),
               # doc comments ("sk-or-v1-..."), and short test fixtures
               # ("sk-test") are not false positives.
    1:         patterns = (
    1:             re.compile(r"sk-(?:proj-|or-v1-)?[A-Za-z0-9_-]{16,}"),
    1:             re.compile(r"api[_-]?key\s*[:=]\s*[\"'][A-Za-z0-9]{16,}"),
               )
    1:         hits = []
   83:         for path in list(ROOT.rglob("*.py")) + list(ROOT.rglob("*.js")) \
    2:                 + list(ROOT.rglob("*.html")) + list(ROOT.rglob("*.md")):
   80:             if ".freebuff" in path.parts or "__pycache__" in path.parts:
                       continue
   79:             text = path.read_text(errors="ignore")
  237:             for pattern in patterns:
  158:                 for match in pattern.finditer(text):
                           hits.append("%s:%d: %s" % (path, 1 + text.count("\n", 0, match.start()),
                                                       match.group(0)))
    1:         self.assertEqual(hits, [])
       
    1:     def test_env_example_is_placeholders_only(self):
    1:         example = (ROOT / ".env.example").read_text()
    1:         self.assertIn("OPENAI_API_KEY=", example)
    1:         secret_like = ("KEY", "SECRET", "TOKEN", "PASSWORD")
   16:         for line in example.splitlines():
   15:             line = line.strip()
   15:             if not line or line.startswith("#") or "=" not in line:
                       continue
    4:             key, _, value = line.partition("=")
   20:             if any(s in key.upper() for s in secret_like):
    2:                 self.assertEqual(value.strip(), "",
    2:                                  "%s must be an empty placeholder in .env.example"
    1:                                  % key)
       
    1:     def test_env_is_gitignored(self):
    1:         gitignore = (ROOT / ".gitignore").read_text()
    1:         self.assertIn(".env", gitignore)
       
       
    2: class SecurityHeadersTests(unittest.TestCase):
    1:     def setUp(self):
    3:         self.ctx = _ServerContext()
       
    1:     def tearDown(self):
    3:         self.ctx.close()
       
    1:     def test_api_response_headers(self):
    1:         status, headers, _ = self.ctx.request("GET", "/api/health")
    1:         self.assertEqual(status, 200)
    1:         self.assertEqual(headers.get("X-Content-Type-Options"), "nosniff")
    1:         self.assertEqual(headers.get("Referrer-Policy"), "no-referrer")
    1:         self.assertEqual(headers.get("X-Frame-Options"), "DENY")
    1:         self.assertIn("Content-Security-Policy", headers)
    1:         self.assertIn("script-src 'self'", headers["Content-Security-Policy"])
    1:         self.assertTrue(headers.get("X-Request-ID"))
       
    1:     def test_static_response_headers(self):
    1:         status, headers, _ = self.ctx.request("GET", "/static/app.js")
    1:         self.assertEqual(status, 200)
    1:         self.assertEqual(headers.get("X-Content-Type-Options"), "nosniff")
       
    1:     def test_cors_same_origin_default(self):
               # No Origin header / same-origin usage must not receive a wildcard.
    1:         _, headers, _ = self.ctx.request("GET", "/api/datasets")
    1:         self.assertIsNone(headers.get("Access-Control-Allow-Origin"))
    1:         _, headers, _ = self.ctx.request("OPTIONS", "/api/analyze")
    1:         self.assertIsNone(headers.get("Access-Control-Allow-Origin"))
    1:         self.assertIn("POST", headers.get("Access-Control-Allow-Methods", ""))
       
       
    2: class CorsConfiguredTests(unittest.TestCase):
    1:     def test_configured_origin_is_echoed(self):
    2:         ctx = _ServerContext(env={
    1:             "RATIONRIGHT_ALLOWED_ORIGINS": "https://ops.example.com"})
    1:         try:
    2:             _, h1, _ = ctx.request("GET", "/api/health",
    1:                                    headers={"Origin": "https://ops.example.com"})
    2:             self.assertEqual(h1.get("Access-Control-Allow-Origin"),
    1:                              "https://ops.example.com")
    2:             _, h2, _ = ctx.request("GET", "/api/health",
    1:                                    headers={"Origin": "https://evil.example.com"})
    1:             self.assertIsNone(h2.get("Access-Control-Allow-Origin"))
               finally:
    1:             ctx.close()
       
    1:     def test_cors_allow_any_opt_in(self):
    1:         ctx = _ServerContext(env={"RATIONRIGHT_CORS_ALLOW_ANY": "1"})
    1:         try:
    1:             _, headers, _ = ctx.request("GET", "/api/health")
    1:             self.assertEqual(headers.get("Access-Control-Allow-Origin"), "*")
               finally:
    1:             ctx.close()
       
       
    2: class AuthTests(unittest.TestCase):
    1:     def test_auth_disabled_by_default(self):
    1:         ctx = _ServerContext()
    1:         try:
    1:             status, _, body = ctx.request("GET", "/api/auth/status")
    1:             payload = json.loads(body)
    1:             self.assertFalse(payload["auth_enabled"])
    1:             self.assertEqual(ctx.request("GET", "/api/datasets")[0], 200)
               finally:
    1:             ctx.close()
       
    1:     def test_auth_enabled_flow(self):
    1:         ctx = _ServerContext(env={"RATIONRIGHT_AUTH_TOKEN": "secret-token-abc"})
    1:         try:
                   # Unauthenticated API -> 401 UNAUTHORIZED (server-side, not UI hiding)
    1:             status, _, body = ctx.request("GET", "/api/datasets")
    1:             self.assertEqual(status, 401)
    1:             self.assertEqual(json.loads(body)["error"]["code"], "UNAUTHORIZED")
                   # health stays public
    1:             self.assertEqual(ctx.request("GET", "/api/health")[0], 200)
                   # wrong token -> 401
    2:             status, _, _ = ctx.request(
    1:                 "POST", "/api/auth/login",
    1:                 json.dumps({"token": "wrong"}).encode(),
    1:                 {"Content-Type": "application/json"})
    1:             self.assertEqual(status, 401)
                   # correct token -> session cookie (HttpOnly, SameSite)
    2:             status, headers, _ = ctx.request(
    1:                 "POST", "/api/auth/login",
    1:                 json.dumps({"token": "secret-token-abc"}).encode(),
    1:                 {"Content-Type": "application/json"})
    1:             self.assertEqual(status, 200)
    1:             set_cookie = headers["Set-Cookie"]
    1:             self.assertIn("HttpOnly", set_cookie)
    1:             self.assertIn("SameSite=Lax", set_cookie)
    1:             self.assertNotIn("Secure", set_cookie)  # local http
    1:             cookie = set_cookie.split(";")[0]
                   # authenticated access works
    2:             self.assertEqual(
    3:                 ctx.request("GET", "/api/datasets",
    3:                             headers={"Cookie": cookie})[0], 200)
                   # forged cookie (tampered signature) -> 401
    1:             forged = cookie[:-2] + ("aa" if not cookie.endswith("aa") else "bb")
    2:             self.assertEqual(
    3:                 ctx.request("GET", "/api/datasets",
    3:                             headers={"Cookie": forged})[0], 401)
                   # logout revokes the session server-side
    2:             ctx.request("POST", "/api/auth/logout", b"{}",
    1:                         {"Cookie": cookie, "Content-Type": "application/json"})
    2:             self.assertEqual(
    3:                 ctx.request("GET", "/api/datasets",
    3:                             headers={"Cookie": cookie})[0], 401)
               finally:
    1:             ctx.close()
       
    1:     def test_login_rate_limited(self):
    1:         ctx = _ServerContext(env={"RATIONRIGHT_AUTH_TOKEN": "secret-token-abc"})
    1:         try:
    1:             codes = []
    9:             for _ in range(8):
   16:                 status, _, _ = ctx.request(
    8:                     "POST", "/api/auth/login",
    8:                     json.dumps({"token": "wrong"}).encode(),
    8:                     {"Content-Type": "application/json"})
    8:                 codes.append(status)
    1:             self.assertIn(429, codes)
               finally:
    1:             ctx.close()
       
       
    2: class InputValidationTests(unittest.TestCase):
    1:     def setUp(self):
    3:         self.ctx = _ServerContext()
       
    1:     def tearDown(self):
    3:         self.ctx.close()
       
    1:     def test_reversed_date_range_rejected(self):
    2:         status, _, body = self.ctx.request(
    1:             "GET", "/api/command-center?from=2026-08-10&to=2026-08-01")
    1:         self.assertEqual(status, 400)
    1:         self.assertEqual(json.loads(body)["error"]["code"], "INVALID_INPUT")
       
    1:     def test_sql_injection_attempt_is_parameterized(self):
               # A classic injection in a filter must never error or leak rows.
    2:         query = urllib.parse.urlencode(
    1:             {"fps": "UP-001' OR '1'='1 --"})
    1:         status, _, body = self.ctx.request("GET", "/api/command-center?" + query)
    1:         self.assertEqual(status, 200)
    1:         payload = json.loads(body)
               # The injected string is treated as a literal filter value: no row
               # matches it, the API stays healthy, and nothing leaks.
    3:         self.assertFalse(any(
    1:             f.get("fps_code") == "UP-001' OR '1'='1 --" for f in payload["fps_risk"]))
    1:         self.assertNotIn("Traceback", body.decode())
    1:         self.assertNotIn("sqlite", body.decode().lower())
       
    1:     def test_error_responses_are_sanitized(self):
               # Trigger a 404 and a 400; bodies must not leak internals.
    1:         status, _, body = self.ctx.request("GET", "/api/reports/RPT-0000-9999")
    1:         self.assertEqual(status, 404)
    1:         self.assertNotIn("Traceback", body.decode())
    1:         self.assertNotIn(self.ctx.db_path, body.decode())
    1:         self.assertNotIn(".py", body.decode())
    2:         status, _, body = self.ctx.request(
    1:             "POST", "/api/simulation/run",
    1:             json.dumps({"import_id": 999999, "demand_change_pct": 200}).encode(),
    1:             {"Content-Type": "application/json"})
    1:         self.assertEqual(status, 400)
       
       
    2: class UploadSecurityTests(unittest.TestCase):
    1:     def setUp(self):
    4:         self.ctx = _ServerContext()
       
    1:     def tearDown(self):
    4:         self.ctx.close()
       
    1:     def test_unsupported_extension(self):
    2:         status, _, _ = self.ctx.request(
    1:             "POST", "/api/upload", data=b"hello",
    1:             headers={"X-Filename": "evil.exe", "Content-Type": "application/octet-stream"})
    1:         self.assertEqual(status, 400)
       
    1:     def test_magic_byte_mismatch(self):
               # Claims to be xlsx but is not a ZIP container.
    2:         status, _, _ = self.ctx.request(
    1:             "POST", "/api/upload", data=b"not a zip at all",
    1:             headers={"X-Filename": "data.xlsx", "Content-Type": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"})
    1:         self.assertEqual(status, 400)
       
    1:     def test_content_type_mismatch(self):
               # .json extension with a csv content type must be rejected.
    2:         status, _, _ = self.ctx.request(
    1:             "POST", "/api/upload", data=b'[{"a":1}]',
    1:             headers={"X-Filename": "data.json", "Content-Type": "text/csv"})
    1:         self.assertEqual(status, 400)
       
    1:     def test_oversized_file(self):
    1:         import ingestion.parsers as parsers
    1:         limit = parsers.get_max_upload_bytes()
               # The server rejects by Content-Length and closes, which can reset
               # the client's in-flight write — either outcome is a rejection.
    1:         try:
    2:             status, _, _ = self.ctx.request(
    1:                 "POST", "/api/upload", data=b"x" * (limit + 1),
    1:                 headers={"X-Filename": "big.csv", "Content-Type": "text/csv"})
    2:         except (ConnectionResetError, BrokenPipeError,
    1:                 http.client.HTTPException, urllib.error.URLError):
    1:             status = 413
    1:         self.assertEqual(status, 413)
       
       
    2: class ImportRollbackTests(unittest.TestCase):
    1:     def test_critical_failure_leaves_no_partial_dataset(self):
    1:         import ingestion.service as service
    1:         import ingestion.importer as importer
       
    1:         db_path = _fresh_db()
    1:         conn = db.open_db(db_path)
    1:         conn.commit()
    1:         conn.close()
    1:         try:
    2:             upload = service.handle_upload(
    1:                 TRANSACTION_CSV.encode(), "rollback.csv", "text/csv")
    1:             token = upload["token"]
    2:             service.validate_step(token, dataset_type="ration_transactions",
    1:                                   db_path=db_path)
    1:             original = importer.upsert_fps_centers
       
    1:             def boom(*args, **kwargs):
    1:                 raise RuntimeError("simulated mid-import failure")
       
    1:             importer.upsert_fps_centers = boom
    1:             try:
    1:                 with self.assertRaises(RuntimeError):
    2:                     service.confirm_step(token, db_path=db_path)
                   finally:
    1:                 importer.upsert_fps_centers = original
       
    1:             conn = db.open_db(db_path)
    1:             try:
    3:                 tx = conn.execute(
    2:                     "SELECT COUNT(*) AS n FROM ration_transactions").fetchone()["n"]
    3:                 imports = conn.execute(
    2:                     "SELECT COUNT(*) AS n FROM data_imports").fetchone()["n"]
                   finally:
    1:                 conn.close()
    1:             self.assertEqual(tx, 0, "no transactions may survive a failed import")
    1:             self.assertEqual(imports, 0, "no import row may survive a failed import")
               finally:
    1:             if os.path.exists(db_path):
    1:                 os.unlink(db_path)
       
       
    2: class AuditLogTests(unittest.TestCase):
    1:     def test_audit_roundtrip_and_no_secrets(self):
    1:         ctx = _ServerContext(env={"RATIONRIGHT_AUTH_TOKEN": "secret-token-abc"})
    1:         try:
    2:             status, headers, _ = ctx.request(
    1:                 "POST", "/api/auth/login",
    1:                 json.dumps({"token": "secret-token-abc"}).encode(),
    1:                 {"Content-Type": "application/json"})
    1:             self.assertEqual(status, 200)
    1:             cookie = headers["Set-Cookie"].split(";")[0]
    2:             status, _, body = ctx.request("GET", "/api/audit?limit=20",
    1:                                           headers={"Cookie": cookie})
    1:             self.assertEqual(status, 200)
    1:             entries = json.loads(body)["entries"]
    1:             self.assertTrue(entries)
    1:             blob = json.dumps(entries)
    1:             self.assertNotIn("secret-token-abc", blob)
    3:             actions = {e["action"] for e in entries}
    1:             self.assertIn("auth.login", actions)
       
    1:             conn = db.open_db(ctx.db_path)
    1:             try:
    1:                 rows = db.list_audit(conn, limit=5, action="auth.login")
    1:                 self.assertTrue(rows)
    1:                 self.assertIsNotNone(rows[0]["created_at"])
    1:                 self.assertTrue(rows[0]["request_id"])
                   finally:
    1:                 conn.close()
               finally:
    1:             ctx.close()
       
    1:     def test_audit_limit_clamped(self):
    1:         ctx = _ServerContext()
    1:         try:
    1:             status, _, body = ctx.request("GET", "/api/audit?limit=-5")
    1:             self.assertEqual(status, 200)
    1:             self.assertLessEqual(len(json.loads(body)["entries"]), 50)
               finally:
    1:             ctx.close()
       
       
