    1:         self.assertEqual(result["dataset"]["transaction_count"], 3)
       
    1:     def test_real_workflow_traceability_when_anomaly_present(self):
               # A dataset with a rapid geographic pattern must flow through ALL
               # agents and keep IDs connected end to end.
    1:         conn = db.open_db(self.db_path)
    1:         src = db.get_data_source_by_name(conn, "Uploaded Dataset")
    1:         src_id = src["id"] if src else db.insert_data_source(
                   conn, name="Uploaded Dataset", source_type="MANUAL",
                   description="test", status="ACTIVE",
               )
    2:         imp = db.insert_data_import(
    1:             conn, data_source_id=src_id, dataset_name="anomaly_set",
    1:             file_name="a.csv", file_type="CSV", record_count=4,
    1:             successful_records=4, status="COMPLETED",
               )
    1:         ben_map = db.beneficiary_ids(conn, ["RB001"])
    1:         center_map = db.fps_center_ids(conn, ["FPS99"])
    2:         db.insert_transactions_batch(conn, [
    2:             {"external_transaction_id": "AX1", "beneficiary_id": ben_map["RB001"],
    1:              "fps_center_id": center_map["FPS99"], "transaction_date": "2026-08-01 10:00",
    1:              "commodity": "rice", "quantity": 100.0, "unit": "kg", "status": "COMPLETED",
    1:              "source_import_id": imp, "latitude": 26.8, "longitude": 80.9},
                   # Same beneficiary, 30 minutes later, ~400 km away -> candidate.
    2:             {"external_transaction_id": "AX2", "beneficiary_id": ben_map["RB001"],
    1:              "fps_center_id": center_map["FPS99"], "transaction_date": "2026-08-01 10:30",
    1:              "commodity": "rice", "quantity": 120.0, "unit": "kg", "status": "COMPLETED",
    1:              "source_import_id": imp, "latitude": 29.9, "longitude": 78.1},
    2:             {"external_transaction_id": "AX3", "beneficiary_id": ben_map["RB001"],
    1:              "fps_center_id": center_map["FPS99"], "transaction_date": "2026-08-02 09:00",
    1:              "commodity": "wheat", "quantity": 30.0, "unit": "kg", "status": "COMPLETED",
    1:              "source_import_id": imp, "latitude": 26.8, "longitude": 80.9},
    2:             {"external_transaction_id": "AX4", "beneficiary_id": ben_map["RB001"],
    1:              "fps_center_id": center_map["FPS99"], "transaction_date": "2026-08-02 09:15",
    1:              "commodity": "wheat", "quantity": 20.0, "unit": "kg", "status": "COMPLETED",
    1:              "source_import_id": imp, "latitude": 26.9, "longitude": 81.0},
               ])
    1:         conn.commit()
    1:         conn.close()
       
    1:         result = dc.run_workflow_on_dataset(imp, db_path=str(self.db_path))
    1:         self.assertEqual(result["workflow_status"], "completed")
    1:         self.assertEqual(result["stages"]["agent_4"], "completed")
    1:         self.assertTrue(result["anomalies"])
    1:         self.assertTrue(result["findings"])
    1:         self.assertTrue(result["cases"])
    1:         self.assertTrue(result["alerts"])
               # Traceability: alert -> case -> finding -> anomaly -> transactions.
    1:         alert = result["alerts"][0]
    2:         case = next(c for c in result["cases"] if c["case_id"] == alert["case_id"])
    2:         finding = next(f for f in result["findings"] if f["finding_id"] in case["finding_ids"])
    2:         anomaly = next(a for a in result["anomalies"] if a["anomaly_id"] == finding["anomaly_id"])
    1:         tx_ids = anomaly["transaction_ids"]
    1:         self.assertTrue(tx_ids)
    1:         self.assertEqual(set(tx_ids), {"AX1", "AX2"})
    1:         self.assertEqual(result["dataset"]["data_import_id"], imp)
               # Evidence is deterministic backend math, present on the finding.
    1:         self.assertGreaterEqual(finding["evidence"]["distance_km"], 300)
       
