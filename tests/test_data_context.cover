    2: class AnalyzeApiTests(unittest.TestCase):
    1:     def setUp(self):
    7:         self._tmp = tempfile.TemporaryDirectory()
    7:         self.db_path = Path(self._tmp.name) / "api.db"
    7:         self.addCleanup(self._tmp.cleanup)
    7:         conn = db.open_db(self.db_path)
    7:         self.imp_id, _ = _seed(conn)
    7:         conn.close()
    7:         self.server = make_server("127.0.0.1", 0, db_path=str(self.db_path))
    7:         self.port = self.server.server_address[1]
    7:         self.thread = threading.Thread(target=self.server.serve_forever, daemon=True)
    7:         self.thread.start()
       
    1:     def tearDown(self):
    7:         self.server.shutdown()
    7:         self.server.server_close()
       
    1:     def _post(self, path, body):
   12:         req = urllib.request.Request(
    6:             BASE + ":%d%s" % (self.port, path),
    6:             data=json.dumps(body).encode("utf-8"),
    6:             headers={"Content-Type": "application/json"},
    6:             method="POST",
               )
    6:         try:
    6:             with urllib.request.urlopen(req, timeout=30) as resp:
    3:                 return resp.status, json.loads(resp.read().decode("utf-8"))
    3:         except urllib.error.HTTPError as exc:
    3:             return exc.code, json.loads(exc.read().decode("utf-8"))
       
    1:     def _get(self, path):
    1:         with urllib.request.urlopen(BASE + ":%d%s" % (self.port, path), timeout=30) as resp:
    1:             return resp.status, json.loads(resp.read().decode("utf-8"))
       
