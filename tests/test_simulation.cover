    1: def _seed(conn, with_inventory=True, months=4, stock=1000.0,
                 monthly=1200.0, threshold=500.0):
           """A real import with transactions + inventory for scenario math."""
   26:     src = db.get_data_source_by_name(conn, "Uploaded Dataset")
   77:     src_id = db.insert_data_source(
   25:         conn, name="Uploaded Dataset", source_type="MANUAL",
   25:         description="t", status="ACTIVE",
   27:     ) if src is None else src["id"]
   52:     imp_id = db.insert_data_import(
   26:         conn, data_source_id=src_id, dataset_name="pds_aug",
   26:         file_name="pds_aug.csv", file_type="CSV", record_count=100,
   26:         successful_records=100, status="COMPLETED")
   52:     db.upsert_beneficiaries(conn, [{"external_reference": "RB1",
   26:                                     "district": "Lucknow",
   26:                                     "ration_category": "AAY",
   26:                                     "family_size": 4, "status": "ACTIVE"}])
   26:     ben = db.beneficiary_ids(conn, ["RB1"])
   52:     db.upsert_fps_centers(conn, [
   52:         {"fps_code": "FPS1", "name": "Center One", "district": "Lucknow",
   26:          "state": "UP", "status": "ACTIVE"},
   52:         {"fps_code": "FPS2", "name": "Center Two", "district": "Kanpur",
   26:          "state": "UP", "status": "ACTIVE"},
           ])
   26:     fps = db.fps_center_ids(conn, ["FPS1", "FPS2"])
   26:     rows = []
   26:     _SEED_COUNTER[0] += 1
   26:     seed_n = _SEED_COUNTER[0]
   26:     seq = 0
  130:     for month in range(months):
  104:         m = "%02d" % (5 + month)  # 2026-05 .. 2026-08
  520:         for i in range(4):
  416:             seq += 1
  832:             fps_id, qty = (fps["FPS1"], 100.0 + i * 10) if i % 2 == 0 \
  208:                 else (fps["FPS2"], 80.0 + i * 5)
  832:             rows.append({
  416:                 "external_transaction_id": "TX%03d-%04d" % (seed_n, seq),
  416:                 "beneficiary_id": ben["RB1"], "fps_center_id": fps_id,
  416:                 "transaction_date": "2026-%s-%02d" % (m, i + 1),
  416:                 "commodity": "rice", "quantity": qty, "unit": "kg",
  416:                 "latitude": 26.8, "longitude": 80.9, "status": "COMPLETED",
  416:                 "source_import_id": imp_id,
                   })
   26:     db.insert_transactions_batch(conn, rows)
   26:     if with_inventory:
   50:         db.insert_inventory_batch(conn, [
   50:             {"fps_center_id": fps["FPS1"], "commodity": "rice",
   25:              "current_stock": stock, "monthly_consumption": monthly,
   25:              "reorder_threshold": threshold, "source_import_id": imp_id},
   50:             {"fps_center_id": fps["FPS2"], "commodity": "rice",
   25:              "current_stock": stock * 2.4, "monthly_consumption": monthly * 2,
   25:              "reorder_threshold": threshold, "source_import_id": imp_id},
               ])
   26:     conn.commit()
   26:     return imp_id
       
       
