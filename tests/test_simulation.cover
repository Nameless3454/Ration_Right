    1:         self.assertEqual(len(sit["high_risk_fps"]), 0)
       
    1:     def test_demand_plus_ten_percent_is_deterministic(self):
    2:         r = sim.run_scenario(self.imp_id, commodity="rice",
    1:                              demand_change_pct=10, db_path=self.db_path)
    1:         self.assertEqual(r["status"], "completed")
               # baseline monthly demand: 1600 kg over 4 months = 400 kg/month
    1:         self.assertEqual(r["baseline"]["monthly_demand_kg"], 400.0)
    1:         self.assertEqual(r["scenario"]["projected_monthly_demand_kg"], 440.0)
               # daily consumption 120 -> 132 kg/day; coverage 3400/132 = 25.8 days
    1:         self.assertEqual(r["baseline"]["daily_consumption_kg"], 120.0)
    1:         self.assertEqual(r["scenario"]["projected_daily_consumption_kg"], 132.0)
    2:         self.assertEqual(r["scenario"]["projected_coverage_days"],
    1:                          round(3400 / 132, 1))
    1:         self.assertEqual(r["risk"], "WARNING")  # < 30-day threshold
    1:         self.assertEqual(r["entity"]["id"], "whole_dataset")
       
    1:     def test_demand_minus_ten_percent(self):
