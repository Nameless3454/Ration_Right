    1:         self.assertEqual(sc["projected_stock_after_delay_kg"], 2560.0)
               # requirement: projected monthly demand 400 - stock after delay 2560 -> 0
    1:         self.assertEqual(sc["simulated_reorder_requirement_kg"], 0.0)
       
