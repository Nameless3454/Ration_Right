    2:         self.assertEqual(r["scenario"]["projected_coverage_days"],
    1:                          round(3400 / 108, 1))
    1:         self.assertEqual(r["risk"], "HEALTHY")
       
    1:     def test_supply_delay_consumes_stock(self):
    2:         r = sim.run_scenario(self.imp_id, commodity="rice",
    1:                              supply_delay_days=7, db_path=self.db_path)
    1:         sc = r["scenario"]
