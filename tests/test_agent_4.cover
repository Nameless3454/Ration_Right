    2: class TestAgent4ValidCase(unittest.TestCase):
    1:     """TEST 1 — the REAL Agent 3 case produces a valid review alert."""
       
    1:     @classmethod
    1:     def setUpClass(cls):
    1:         cls.case = real_case()
    1:         cls.alert = Agent4AlertGenerator().run(cls.case)
       
    1:     def test_alert_is_generated(self):
    1:         self.assertEqual(set(self.alert.keys()), ALERT_FIELDS)
    1:         self.assertEqual(self.alert["alert_id"], "ALERT001")
    1:         self.assertEqual(self.alert["case_id"], "CASE001")
    1:         self.assertEqual(self.alert["status"], "open")
    1:         self.assertEqual(self.alert["severity"], "high")
    1:         self.assertEqual(self.alert["recommended_action"], "Human verification")
    1:         self.assertTrue(self.alert["title"])
    1:         self.assertTrue(self.alert["message"])
       
    1:     def test_message_contains_verified_evidence(self):
    1:         message = self.alert["message"]
    1:         self.assertIn("12.0", message)
    1:         self.assertIn("1148.09", message)
       
    1:     def test_language_is_careful(self):
    1:         text = (self.alert["title"] + " " + self.alert["message"]).lower()
    7:         for banned in ("guilty", "fraud", "block", "deny", "suspend", "punish"):
    6:             self.assertNotIn(banned, text)
    1:         self.assertIn("human verification", text)
       
       
    2: class TestAgent4UnverifiedCase(unittest.TestCase):
    1:     """TEST 2 — a not-ready case never produces a normal review alert."""
       
    1:     def test_not_ready_case_alert(self):
    1:         case = {
    1:             "case_id": "CASE002",
    1:             "severity": "low",
    1:             "status": "not_ready",
    1:             "finding_ids": ["FIND001"],
    1:             "summary": "Case is not ready.",
    1:             "evidence": [],
    1:             "confidence": 0.0,
    1:             "recommended_action": "Human verification",
               }
    1:         alert = Agent4AlertGenerator().run(case)
    1:         self.assertEqual(alert["status"], "not_ready")
    1:         self.assertNotEqual(alert["status"], "open")
    1:         self.assertEqual(alert["severity"], "low")
       
       
    2: class TestAgent4MissingEvidence(unittest.TestCase):
