    2: class TestAgent4NoFabrication(unittest.TestCase):
    1:     """TEST 5 — every alert fact comes from the Agent 3 input."""
       
    1:     def test_message_contains_only_input_values(self):
    1:         case = real_case()
    1:         alert = Agent4AlertGenerator().run(case)
               # No transaction or beneficiary IDs are guessed into the message.
    1:         self.assertNotIn("TX", alert["message"])
    1:         self.assertNotIn("BEN", alert["message"])
    1:         self.assertIn("Potential anomaly detected", alert["message"])
    3:         for entry in case["evidence"]:
    2:             self.assertIn(str(entry["value"]), alert["message"])
       
       
    2: class TestAgent4PriorityRules(unittest.TestCase):
