    2:         self.httpd = make_server(port=0, db_path=self.db_path)
    2:         self.port = self.httpd.server_address[1]
    2:         threading.Thread(target=self.httpd.serve_forever, daemon=True).start()
       
    1:     def tearDown(self):
    2:         self.httpd.shutdown()
    2:         if os.path.exists(self.db_path):
    2:             os.unlink(self.db_path)
       
    1:     def _get(self, path):
   10:         with urllib.request.urlopen(
    9:                 "%s:%d%s" % (BASE, self.port, path), timeout=15) as resp:
    4:             return json.loads(resp.read())
       
