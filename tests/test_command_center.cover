    1:         self.assertEqual(kpis["critical_alerts"]["value"], 0)
    1:         self.assertEqual(kpis["high_risk_fps"]["value"], 1)  # UP-B1 below reorder
       
    1:     def test_kpi_previous_period_comparison(self):
