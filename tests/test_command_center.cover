    1: _SEED_COUNTER = [0]
       
       
    1: def _now_iso_ago(days=0):
  540:     return (datetime.now(timezone.utc) - timedelta(days=days)
  270:             ).isoformat(timespec="seconds")
       
       
    1: def _seed(conn, *, with_alerts=True, quality=100.0):
           """A deterministic fixture with transactions, inventory and alerts.
       
           Two FPS centers: UP-A1 (rice, healthy coverage) and UP-B1 (rice,
           low coverage -> warning), one district, one inventory record and one
           persisted alert, so every command-center section has real data.
           """
   18:     _SEED_COUNTER[0] += 1
   18:     seed_n = _SEED_COUNTER[0]
       
   36:     src = db.insert_data_source(
   18:         conn, name="cc_source_%d" % seed_n, source_type="CSV",
   18:         description="command center fixture", status="ACTIVE")
   36:     imp = db.insert_data_import(
   18:         conn, data_source_id=src, dataset_name="cc_fixture_%d" % seed_n,
   18:         file_name="fixture.csv", file_type="CSV",
   18:         record_count=12, successful_records=12, failed_records=0,
   18:         duplicate_records=0, status="COMPLETED")
       
   36:     db.upsert_beneficiaries(conn, [{"external_reference": "R1", "name": "A",
   18:                                     "state": "UP", "district": "Lucknow"}])
   18:     ben = db.beneficiary_ids(conn, ["R1"])
   36:     db.upsert_fps_centers(conn, [
   36:         {"fps_code": "UP-A1", "name": "Center A", "state": "UP",
   18:          "district": "Lucknow"},
   36:         {"fps_code": "UP-B1", "name": "Center B", "state": "UP",
   18:          "district": "Lucknow"},
           ])
   18:     fps_ids = db.fps_center_ids(conn, ["UP-A1", "UP-B1"])
   36:     db.insert_inventory_batch(conn, [
   36:         {"fps_center_id": fps_ids["UP-A1"], "commodity": "rice",
   18:          "current_stock": 2000, "reorder_threshold": 500},
   36:         {"fps_center_id": fps_ids["UP-B1"], "commodity": "rice",
   18:          "current_stock": 200, "reorder_threshold": 500},
           ])
           # 4 rice transactions at UP-A1 (45 days ago -> previous window) and 10
           # rice transactions at UP-B1 (yesterday -> current window): the KPI
           # comparison must be current 1000 vs previous 400 (+150%).
   18:     tx = []
   90:     for i in range(4):
  144:         tx.append({
   72:             "external_transaction_id": "CC%02d-A-%d" % (seed_n, i),
   72:             "beneficiary_id": ben["R1"], "fps_center_id": fps_ids["UP-A1"],
   72:             "commodity": "rice", "quantity": 100,
   72:             "transaction_date": _now_iso_ago(45),
   72:             "unit": "kg", "latitude": 26.8, "longitude": 80.9,
   72:             "status": "COMPLETED", "source_import_id": imp,
               })
  198:     for i in range(10):
  360:         tx.append({
  180:             "external_transaction_id": "CC%02d-B-%d" % (seed_n, i),
  180:             "beneficiary_id": ben["R1"], "fps_center_id": fps_ids["UP-B1"],
  180:             "commodity": "rice", "quantity": 100,
  180:             "transaction_date": _now_iso_ago(1),
  180:             "unit": "kg", "latitude": 26.8, "longitude": 80.9,
  180:             "status": "COMPLETED", "source_import_id": imp,
               })
   18:     db.insert_transactions_batch(conn, tx)
       
   18:     if with_alerts:
   36:         db.insert_alert(
   18:             conn, alert_id="ALT-TEST-%04d" % seed_n, rule_type="INVENTORY_RISK",
   18:             condition="coverage_low", severity="HIGH",
   18:             title="Inventory coverage below threshold",
   18:             status="OPEN", entity_type="fps_center", entity_id="UP-B1",
   18:             commodity="rice", current_value=2.0, threshold=30.0,
   18:             evidence="{}", created_at=_now_iso_ago(0))
   18:     return {"src": src, "imp": imp, "seed_n": seed_n}
       
       
    1: def _fresh_db():
   19:     tmp = tempfile.NamedTemporaryFile(suffix=".db", delete=False)
   19:     tmp.close()
   19:     os.unlink(tmp.name)
   19:     return tmp.name
       
       
