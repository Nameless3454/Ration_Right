    4:         self.conn.commit()  # release the write lock before probe connections
    4:         return sid
       
    1:     def test_unknown_source(self):
    1:         probe = pl.test_connection(999999, db_path=self.db_path)
    1:         self.assertEqual(probe["category"], "UNKNOWN_SOURCE")
    1:         self.assertEqual(probe["status"], "error")
       
    1:     def test_ogd_without_key_is_not_tested(self):
               """Auth-required source with no key: NOT_CONFIGURED, never fetched."""
    1:         sid = self._add_source("ogd_pds_resource", "API", "https://example.in/api")
    1:         probe = pl.test_connection(sid, db_path=self.db_path)
    1:         self.assertEqual(probe["category"], "AUTH_NOT_CONFIGURED")
    1:         self.assertEqual(probe["status"], "not_configured")
    1:         self.assertIn("NOT tested", probe["detail"])
       
    1:     def test_successful_probe(self):
    1:         sid = self._add_source("sample_open_pds", "CSV", "/sample/pds_sample.csv")
    2:         probe = pl.test_connection(
    1:             sid, db_path=self.db_path, request_host="127.0.0.1:8000",
    2:             fetcher=lambda url, timeout=6, max_attempts=1: b"a,b,c\n1,2,3\n",
               )
    1:         self.assertEqual(probe["status"], "ok")
    1:         self.assertEqual(probe["category"], "CONNECTION_OK")
       
    1:     def test_auth_failure_probe(self):
    1:         sid = self._add_source("sample_open_pds", "CSV", "/sample/pds_sample.csv")
    1:         def fail(url, timeout=6, max_attempts=1):
    1:             raise AuthError("The source rejected the request credentials (HTTP 401)")
    2:         probe = pl.test_connection(
    1:             sid, db_path=self.db_path, request_host="127.0.0.1:8000", fetcher=fail,
               )
    1:         self.assertEqual(probe["category"], "AUTH_FAILED")
       
    1:     def test_unreachable_probe(self):
    1:         sid = self._add_source("sample_open_pds", "CSV", "/sample/pds_sample.csv")
    1:         def fail(url, timeout=6, max_attempts=1):
    1:             raise UnreachableError("Could not reach the source")
    2:         probe = pl.test_connection(
    1:             sid, db_path=self.db_path, request_host="127.0.0.1:8000", fetcher=fail,
               )
    1:         self.assertEqual(probe["category"], "UNREACHABLE")
       
       
    2: class PipelineApiTests(unittest.TestCase):
    1:     """End-to-end API tests against the real server (dev DB)."""
       
    1:     @classmethod
    1:     def setUpClass(cls):
    1:         cls.server = make_server("127.0.0.1", 0)
    1:         cls.port = cls.server.server_address[1]
    1:         cls.base = f"{BASE}:{cls.port}"
    1:         cls.thread = threading.Thread(target=cls.server.serve_forever, daemon=True)
    1:         cls.thread.start()
       
    1:     @classmethod
    1:     def tearDownClass(cls):
    1:         cls.server.shutdown()
    1:         cls.server.server_close()
       
    1:     def request(self, method, path, body=None):
    8:         data = json.dumps(body).encode("utf-8") if body is not None else None
    8:         headers = {"Content-Type": "application/json"} if data else {}
    8:         req = urllib.request.Request(self.base + path, data=data, method=method, headers=headers)
    8:         try:
    8:             with urllib.request.urlopen(req, timeout=20) as response:
    6:                 return response.status, response.read().decode("utf-8")
    2:         except urllib.error.HTTPError as exc:
    2:             return exc.code, exc.read().decode("utf-8")
       
    1:     def test_pipeline_status_endpoint(self):
