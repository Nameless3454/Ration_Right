    1:     def test_status_stages_reflect_real_database(self):
               """Each stage reports counts computed from the actual database."""
    1:         _seed(self.conn)
    1:         status = pl.pipeline_status(db_path=self.db_path)
   10:         by_key = {s["key"]: s for s in status["stages"]}
               # source: 2 configured sources (synthetic + uploaded)
    1:         self.assertEqual(by_key["source"]["records"], 2)
               # extract: sum of record_count across imports = 25 + 100
    1:         self.assertEqual(by_key["extract"]["records"], 125)
               # validate: sum of successful/failed/warnings
    1:         self.assertEqual(by_key["validate"]["records"], 25 + 90)
    1:         self.assertIn("6 invalid", by_key["validate"]["detail"])
               # deduplicate: 4 duplicates reported (0 from synthetic)
