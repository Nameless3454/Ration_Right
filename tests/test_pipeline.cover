    1:         self.assertGreater(by_key["database"]["records"], 0)
               # ai: no analysis run yet -> warn/unknown, never a fake number
    1:         self.assertIn(by_key["ai"]["status"], ("warn", "unknown"))
    1:         self.assertEqual(by_key["ai"]["records"], 0)
       
