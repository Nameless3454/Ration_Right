    2: class QualityPanelTests(unittest.TestCase):
    1:     def setUp(self):
    2:         self._tmp = tempfile.TemporaryDirectory()
    2:         self.db_path = Path(self._tmp.name) / "quality.db"
    2:         self.addCleanup(self._tmp.cleanup)
    2:         self.conn = db.open_db(self.db_path)
       
    1:     def test_score_matches_phase4_formula(self):
    1:         _seed(self.conn)
    1:         q = pl.quality_panel(db_path=self.db_path)
               # Synthetic import: 25/25/0/0 -> 100. Upload: 100 records, 6 invalid,
               # 4 dupes, 5 warnings -> 100 - 3*6 - 2*4 - 0.5*5 = 100-18-8-2.5 = 71.5.
               # Weighted: (100*25 + 71.5*100) / 125 = (2500 + 7150)/125 = 77.2.
    1:         self.assertEqual(q["overall_score"], 77.2)
    1:         self.assertEqual(q["breakdown"]["completeness"], None)  # not stored -> Not available
    1:         self.assertEqual(q["totals"]["records"], 125)
       
    1:     def test_empty_database(self):
    1:         q = pl.quality_panel(db_path=self.db_path)
    1:         self.assertIsNone(q["overall_score"])
    1:         self.assertEqual(q["totals"]["records"], 0)
       
       
