    1:     def test_lifecycle_acknowledge_resolve_dismiss(self):
    1:         monitoring.run_monitoring(db_path=self.db_path)
    1:         alert = self._alerts(status="OPEN")["alerts"][0]
    1:         aid = alert["alert_id"]
    2:         self.assertTrue(monitoring.set_alert_status_view(
    1:             aid, "ACKNOWLEDGED", db_path=self.db_path))
    1:         detail = monitoring.alert_detail_view(aid, db_path=self.db_path)
    1:         self.assertEqual(detail["status"], "ACKNOWLEDGED")
    1:         self.assertTrue(detail["acknowledged_at"])
    2:         self.assertTrue(monitoring.set_alert_status_view(
    1:             aid, "RESOLVED", db_path=self.db_path))
    1:         detail = monitoring.alert_detail_view(aid, db_path=self.db_path)
    1:         self.assertEqual(detail["status"], "RESOLVED")
    1:         self.assertTrue(detail["resolved_at"])
