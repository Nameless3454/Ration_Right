    1:         self.assertEqual(status, 404)
               # invalid body -> 400
    1:         status, _ = self.request("POST", "/api/alerts/" + alert["alert_id"] + "/resolve", "not-json")
    1:         self.assertEqual(status, 400)
               # rule update
