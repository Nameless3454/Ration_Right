    1:         self.assertEqual(status, 200)
    1:         self.assertIn("lineage", detail)
               # lifecycle through the API
    2:         status, ack = self.request(
    1:             "POST", "/api/alerts/" + alert["alert_id"] + "/acknowledge", {})
    1:         self.assertEqual(status, 200)
