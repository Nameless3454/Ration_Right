    1:         alert2 = self._alerts(status="OPEN")["alerts"][0]
    2:         self.assertTrue(monitoring.set_alert_status_view(
    1:             alert2["alert_id"], "DISMISSED", dismissed_reason="False positive",
    1:             db_path=self.db_path))
