    1:         cc = self._get("/api/command-center?district=Lucknow")
   10:         kpis = {k["key"]: k["value"] for k in cc["kpis"]}
    9:         for key, value in kpis.items():
    8:             if value is None:
    2:                 continue
    6:             self.assertEqual(value, 0, "KPI %r leaked non-zero value %r" % (key, value))
       
       
    2: class HistoricalComparisonTests(unittest.TestCase):
    1:     """change % math and the previous=0 / missing-previous guards."""
       
    1:     def test_change_pct_math(self):
    1:         import command_center
    1:         self.assertEqual(command_center._change_pct(120, 100), 20.0)
    1:         self.assertEqual(command_center._change_pct(100, 120), -16.7)
       
    1:     def test_previous_zero_is_not_misleading(self):
               # (120 - 0) / 0 is undefined; must not produce +inf or a fake %.
    1:         import command_center
    1:         self.assertIsNone(command_center._change_pct(120, 0))
       
    1:     def test_missing_previous(self):
    1:         import command_center
    1:         self.assertIsNone(command_center._change_pct(None, 100))
       
       
    2: class DateBoundaryTests(unittest.TestCase):
