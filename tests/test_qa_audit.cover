    1: """RationRight — Phase 15: Data accuracy audit.
       
       Independently verifies the data path: upload -> validate -> import ->
       analytics -> command center -> API. Every expected value in this file is
       computed from raw rows / independent arithmetic, never copied from the
       application output.
       
       - Import reconciliation invariant: source = valid + invalid, imported == valid
       - Normalization rules (commodity case/whitespace, date formats)
       - Analytics recomputed from raw rows and compared to the service
       - KPI chain: database -> analytics -> command center -> API agree
       - Historical comparison: change % math + previous=0 guard
       - Filter scoping isolation (no cross-scope leakage)
       - Date boundaries (month / year / same-day) and null/missing data
       - Duplicate-file idempotency (no double import)
       
       Run from the project root::
       
           python3 -m unittest tests.test_qa_audit -v
       """
       
    1: import json
    1: import os
    1: import tempfile
    1: import threading
    1: import unittest
    1: import urllib.error
    1: import urllib.request
    1: from pathlib import Path
       
    1: import analytics
    1: import database as db
    1: from ingestion import service as ingest
    1: from server import make_server
       
    1: BASE = "http://127.0.0.1"
       
    1: TRANSACTION_CSV = (
    1:     "Transaction ID,Beneficiary ID,FPS Code,Transaction Date,Commodity,Quantity,Unit\n"
           "TX101,BEN001,FPS01,2026-08-01,rice,10,kg\n"
           "TX102,BEN001,FPS01,2026-08-02,Rice,5,kg\n"        # case-different (valid)
           "TX103,BEN002,FPS02,2026-08-01,wheat,8,kg\n"
           "TX104,BEN002,FPS02,2026-08-01,wheat,8,kg\n"        # exact duplicate of TX103
           "TX105,BEN003,FPS03,2026-08-03,rice,abc,kg\n"        # unparseable quantity
           "TX106,BEN003,FPS03,not-a-date,rice,3,kg\n"          # invalid date
           "TX107,BEN004,FPS01,2026-08-04,rice,12,kg\n"
       )
       
       # 7 data rows. Valid = 5 (TX101, TX102, TX103, TX104, TX107 — the exact
       # duplicate TX104 is still a valid record, just skipped at import).
       # Invalid = 2 (TX105 bad quantity, TX106 bad date). Duplicates = 1 (TX104).
       # Imported = valid - duplicates = 4. Distribution = 10+5+8+12 = 35 kg.
    1: _VALID = 5
    1: _INVALID = 2
    1: _DUPES = 1
    1: _IMPORTED = 4
    1: _DISTRIBUTION_KG = 35.0
       
       
    1: def _fresh_db():
   12:     tmp = tempfile.NamedTemporaryFile(suffix=".db", delete=False)
   12:     tmp.close()
   12:     os.unlink(tmp.name)
   12:     return tmp.name
       
       
    1: def _import_csv(db_path, csv_text=TRANSACTION_CSV, name="qa.csv"):
           """Full upload -> validate -> confirm pipeline; returns the summary."""
    9:     upload = ingest.handle_upload(csv_text.encode(), name, "text/csv")
    9:     token = upload["token"]
   18:     validated = ingest.validate_step(token, dataset_type="ration_transactions",
    9:                                      db_path=db_path)
    9:     summary = ingest.confirm_step(token, db_path=db_path)
    9:     return validated, summary
       
       
    2: class ImportReconciliationTests(unittest.TestCase):
    1:     """The source -> valid/invalid/duplicates -> imported invariant."""
       
    1:     def setUp(self):
    2:         self.db_path = _fresh_db()
    4:         self.addCleanup(lambda: os.path.exists(self.db_path) and os.unlink(self.db_path))
       
    1:     def test_reconciliation_invariant(self):
    1:         validated, summary = _import_csv(self.db_path)
    1:         total = validated["record_count"]
    1:         valid = validated["valid_records"]
    1:         invalid = validated["invalid_records"]
    1:         dupes = validated["duplicate_records"]
       
               # No silent loss: every source row is accounted for exactly once.
    1:         self.assertEqual(total, valid + invalid, "source must equal valid + invalid")
    1:         self.assertEqual(total, 7)
    1:         self.assertEqual(valid, _VALID)
    1:         self.assertEqual(invalid, _INVALID)
    1:         self.assertEqual(dupes, _DUPES)
    1:         self.assertLessEqual(dupes, valid)
       
               # Imported = valid records minus the exact duplicates skipped at import.
    1:         self.assertEqual(summary["imported"], _IMPORTED)
    1:         self.assertEqual(summary["imported"], valid - dupes)
    1:         self.assertEqual(summary["failed"], invalid)
       
               # And the database must actually contain exactly that many rows.
    1:         conn = db.open_db(self.db_path)
    1:         try:
    3:             inserted = conn.execute(
    2:                 "SELECT COUNT(*) AS n FROM ration_transactions").fetchone()["n"]
               finally:
    1:             conn.close()
    1:         self.assertEqual(inserted, _IMPORTED, "inserted rows must match imported count")
       
    1:     def test_duplicate_file_is_idempotent(self):
    1:         validated, summary = _import_csv(self.db_path)
    1:         self.assertEqual(summary["status"], "PARTIAL")  # 2 invalid rows
    1:         self.assertEqual(summary["imported"], _IMPORTED)
               # Same bytes again -> ALREADY_IMPORTED, no additional rows.
    1:         validated2, summary2 = _import_csv(self.db_path)
    1:         self.assertEqual(summary2["status"], "ALREADY_IMPORTED")
    1:         conn = db.open_db(self.db_path)
    1:         try:
    3:             inserted = conn.execute(
    2:                 "SELECT COUNT(*) AS n FROM ration_transactions").fetchone()["n"]
               finally:
    1:             conn.close()
    1:         self.assertEqual(inserted, _IMPORTED)
       
       
    2: class NormalizationTests(unittest.TestCase):
    1:     """Phase 4 normalization rules: case, whitespace, dates, units."""
       
    1:     def test_commodity_normalization(self):
    1:         from ingestion import validation
    1:         self.assertEqual(validation.normalize_commodity(" rice ")[0], "rice")
    1:         self.assertEqual(validation.normalize_commodity("Rice")[0], "rice")
    1:         self.assertEqual(validation.normalize_commodity("RICE")[0], "rice")
    1:         self.assertEqual(validation.normalize_commodity("wheataata")[0], "wheat")
               # Unknown commodities warn but are never silently guessed.
    1:         key, changed, warning = validation.normalize_commodity("unmapped-crop")
    1:         self.assertEqual(key, "unmapped-crop")
    1:         self.assertIsNotNone(warning)
       
    1:     def test_date_normalization_formats(self):
    1:         from ingestion import validation
    6:         for raw in ("2026-08-01", "2026/08/01", "01-08-2026", "01/08/2026",
                           "1 Aug 2026"):
    5:             self.assertEqual(validation.parse_date(raw), "2026-08-01", raw)
    1:         self.assertIsNone(validation.parse_date("not-a-date"))
       
    1:     def test_numeric_normalization(self):
    1:         from ingestion import validation
    1:         self.assertEqual(validation.parse_number("1,200"), 1200.0)
    1:         self.assertEqual(validation.parse_number("1200 kg"), 1200.0)
    1:         self.assertIsNone(validation.parse_number("abc"))
       
       
