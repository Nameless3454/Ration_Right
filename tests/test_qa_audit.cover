    3:         self.db_path = _fresh_db()
    3:         _import_csv(self.db_path)
    6:         self.addCleanup(lambda: os.path.exists(self.db_path) and os.unlink(self.db_path))
       
    1:     def _count_between(self, from_date, to_date):
    4:         conn = db.open_db(self.db_path)
    4:         try:
    8:             ov = analytics.overview(conn, range_key="custom",
    4:                                     from_date=from_date, to_date=to_date)
    8:             return ov["total_transactions"]
               finally:
