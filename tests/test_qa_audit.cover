    1:     def test_month_boundary(self):
               # Imported TX dates: 08-01, 08-02, 08-01, 08-04 -> 4 rows (the exact
               # duplicate TX104 was skipped at import).
    1:         self.assertEqual(self._count_between("2026-08-01", "2026-08-31"), 4)
    1:         self.assertEqual(self._count_between("2026-07-01", "2026-07-31"), 0)
       
    1:     def test_same_day_range(self):
    1:         self.assertEqual(self._count_between("2026-08-01", "2026-08-01"), 2)
       
    1:     def test_year_boundary(self):
    1:         self.assertEqual(self._count_between("2025-12-31", "2026-01-01"), 0)
       
       
