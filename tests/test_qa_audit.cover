    2: class KpiChainTests(unittest.TestCase):
    1:     """database -> analytics -> command center -> API must agree."""
       
    1:     def setUp(self):
    3:         self.db_path = _fresh_db()
    3:         _validated, summary = _import_csv(self.db_path)
    3:         self.summary = summary
    3:         self._tmp = tempfile.TemporaryDirectory()
    3:         self.addCleanup(self._tmp.cleanup)
    3:         self.httpd = make_server(port=0, db_path=self.db_path)
    3:         self.port = self.httpd.server_address[1]
    3:         threading.Thread(target=self.httpd.serve_forever, daemon=True).start()
    3:         self.addCleanup(self.httpd.shutdown)
    3:         self.addCleanup(self.httpd.server_close)
    6:         self.addCleanup(lambda: os.path.exists(self.db_path) and os.unlink(self.db_path))
       
    1:     def _get(self, path):
    8:         with urllib.request.urlopen(
    8:                 "%s:%d%s" % (BASE, self.port, path), timeout=20) as resp:
    4:             return json.loads(resp.read())
       
    1:     def test_command_center_kpis_match_database(self):
    1:         cc = self._get("/api/command-center")
    1:         ov = self._get("/api/analytics/overview?range=all")
   10:         kpis = {k["key"]: k["value"] for k in cc["kpis"]}
       
               # Imported quantity: 10+5+8+12 = 35 kg (valid rows only).
    1:         self.assertEqual(kpis["distribution"], 35.0)
    1:         self.assertEqual(kpis["distribution"], ov["ration_distributed_kg"])
    1:         self.assertEqual(kpis["transactions"], ov["total_transactions"])
    1:         self.assertEqual(kpis["transactions"], self.summary["imported"])
       
               # Database ground truth, independent of both services.
    1:         conn = db.open_db(self.db_path)
    1:         try:
    3:             ground = conn.execute(
    1:                 "SELECT COALESCE(SUM(quantity), 0) AS qty FROM ration_transactions"
    1:             ).fetchone()["qty"]
               finally:
    1:             conn.close()
    1:         self.assertEqual(kpis["distribution"], round(ground, 2))
       
    1:     def test_filter_isolation_no_cross_scope_leak(self):
    1:         cc = self._get("/api/command-center?commodity=rice")
   10:         kpis = {k["key"]: k["value"] for k in cc["kpis"]}
               # Only rice rows: 10 + 5 + 12 = 27 kg (TX101, TX102, TX107).
    1:         self.assertEqual(kpis["distribution"], 27.0)
               # Wheat must NOT appear in the scoped payload.
    1:         trend = cc["trends"]
    3:         wheat = [b for b in trend.get("by_commodity", []) if b.get("commodity") == "wheat"]
    1:         self.assertFalse(wheat)
       
    1:     def test_district_filter(self):
               # FPS rows carry no district on the upload path, so a district filter
