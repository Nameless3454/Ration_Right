    2: class AnalyticsAPITests(unittest.TestCase):
    1:     @classmethod
    1:     def setUpClass(cls):
    1:         cls._tmp = tempfile.TemporaryDirectory()
    1:         cls.db_path = Path(cls._tmp.name) / "api.db"
    1:         conn = db.open_db(cls.db_path)
    1:         _seed(conn)
    1:         conn.close()
    1:         cls.server = make_server("127.0.0.1", 0, db_path=cls.db_path)
    1:         cls.port = cls.server.server_address[1]
    1:         cls.base = "%s:%d" % (BASE, cls.port)
    1:         cls.thread = threading.Thread(target=cls.server.serve_forever, daemon=True)
    1:         cls.thread.start()
       
    1:     @classmethod
    1:     def tearDownClass(cls):
    1:         cls.server.shutdown()
    1:         cls.server.server_close()
       
    1:     def _get(self, path):
    9:         req = urllib.request.Request(self.base + path)
    9:         try:
    9:             with urllib.request.urlopen(req, timeout=30) as response:
    4:                 return response.status, response.read().decode("utf-8")
    5:         except urllib.error.HTTPError as exc:
    5:             return exc.code, exc.read().decode("utf-8")
       
