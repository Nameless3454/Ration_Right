           # ---- inventory ----
    1:     def test_inventory_risk(self):
    1:         inv = analytics.inventory(self.conn)
    1:         self.assertEqual(inv["total_stock_kg"], 600.0)
    4:         by = {c["commodity"]: c for c in inv["by_commodity"]}
               # rice: 500 * 30 / 300 = 50 days -> HEALTHY
    1:         self.assertEqual(by["rice"]["days_remaining"], 50.0)
    1:         self.assertEqual(by["rice"]["status"], "HEALTHY")
               # wheat: 100 * 30 / 400 = 7.5 days -> CRITICAL
    1:         self.assertEqual(by["wheat"]["days_remaining"], 7.5)
    1:         self.assertEqual(by["wheat"]["status"], "CRITICAL")
    1:         self.assertEqual(len(inv["low_stock_items"]), 1)  # wheat below threshold
    1:         self.assertEqual(inv["low_stock_items"][0]["commodity"], "wheat")
    1:         self.assertIn("critical_days", inv["thresholds"])
       
