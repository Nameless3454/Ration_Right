    2: class ConcurrencySmokeTests(unittest.TestCase):
    1:     """Multiple readers at once must not error or lock up."""
       
    1:     def setUp(self):
    1:         self.db_path = _fresh_db()
    1:         _import_and_seed(self.db_path)
    1:         self.httpd = make_server(port=0, db_path=self.db_path)
    1:         self.port = self.httpd.server_address[1]
    1:         threading.Thread(target=self.httpd.serve_forever, daemon=True).start()
    1:         self.addCleanup(self.httpd.shutdown)
    1:         self.addCleanup(self.httpd.server_close)
    2:         self.addCleanup(lambda: os.path.exists(self.db_path) and os.unlink(self.db_path))
       
    1:     def test_parallel_reads(self):
    1:         paths = ["/api/command-center", "/api/analytics/overview?range=all",
                        "/api/alerts?per_page=10&days=30&page=1",
                        "/api/analytics/distribution?granularity=day&range=all"]
    1:         results = []
    1:         errors = []
       
    1:         def worker(path):
   16:             try:
   32:                 with urllib.request.urlopen(
   32:                         "%s:%d%s" % (BASE, self.port, path), timeout=30) as resp:
   16:                     results.append((path, resp.status))
                   except Exception as exc:  # noqa: BLE001
                       errors.append((path, repr(exc)))
       
   23:         threads = [threading.Thread(target=worker, args=(p,))
   21:                    for p in paths for _ in range(4)]
   17:         for t in threads:
   16:             t.start()
   17:         for t in threads:
   16:             t.join()
    1:         self.assertEqual(errors, [])
    1:         self.assertEqual(len(results), len(paths) * 4)
   18:         self.assertTrue(all(status == 200 for _, status in results))
       
       
    2: class LargeImportTests(unittest.TestCase):
    1:     """20k-row import: counts exact, pagination bounded, dashboard loads."""
       
    1:     def setUp(self):
    1:         self.db_path = _fresh_db()
    2:         self.addCleanup(lambda: os.path.exists(self.db_path) and os.unlink(self.db_path))
       
    1:     def test_large_import_is_bounded_and_exact(self):
               # The dedup natural key is (FPS, date, commodity): vary FPS across
               # 500 centers so all 20,000 rows are genuinely distinct.
    1:         n = 20_000
    1:         lines = ["Transaction ID,Beneficiary ID,FPS Code,Transaction Date,"
                        "Commodity,Quantity,Unit"]
20001:         for i in range(n):
40000:             lines.append("TX%06d,BEN%04d,FPS%04d,2026-08-%02d,%s,%d,kg" % (
20000:                 i + 1, i % 500 + 1, i % 500 + 1, i % 28 + 1,
20000:                 ("rice", "wheat", "pulses")[i % 3], (i % 9) + 1))
    1:         csv_text = "\n".join(lines) + "\n"
       
    1:         up = ingest.handle_upload(csv_text.encode(), "big.csv", "text/csv")
    2:         validated = ingest.validate_step(
    1:             up["token"], dataset_type="ration_transactions", db_path=self.db_path)
    1:         self.assertEqual(validated["record_count"], n)
    1:         self.assertEqual(validated["valid_records"], n)
    1:         summary = ingest.confirm_step(up["token"], db_path=self.db_path)
    1:         self.assertEqual(summary["imported"], n)
       
               # Dashboard reads the import through bounded aggregations (explicit
               # window: the default is a rolling 30 days up to today, which would
               # legitimately exclude future-dated rows).
    2:         cc = command_center.command_center(
    1:             db_path=self.db_path, from_date="2026-08-01", to_date="2026-08-31")
   10:         kpis = {k["key"]: k["value"] for k in cc["kpis"]}
    1:         self.assertEqual(kpis["transactions"], n)
       
               # Pagination returns a bounded page, not all rows.
    1:         conn = db.open_db(self.db_path)
    1:         try:
   53:             page = [dict(r) for r in conn.execute(
    1:                 "SELECT * FROM ration_transactions LIMIT 50 OFFSET 19950")]
               finally:
    1:             conn.close()
    1:         self.assertEqual(len(page), 50)
       
       
    2: class FailureRecoveryTests(unittest.TestCase):
    1:     """AI down / monitoring failure must not break analytics or clear alerts."""
       
    1:     def setUp(self):
    2:         self.db_path = _fresh_db()
    2:         self.imp_id = _import_and_seed(self.db_path)
    4:         self.addCleanup(lambda: os.path.exists(self.db_path) and os.unlink(self.db_path))
       
    1:     def test_ai_down_analytics_still_work(self):
    1:         def boom(kind, context, fallback):
    2:             raise RuntimeError("AI provider unavailable")
       
               # Analysis completes with fallback narratives.
    2:         result = run_analysis(dataset_mode="real", data_import_id=self.imp_id,
    2:                               db_path=self.db_path, types=["inventory_risk",
    1:                                                            "recommendations"])
    1:         self.assertIsNotNone(result)
    1:         self.assertTrue(result["analysis_run"]["analysis_id"].startswith("RA-"))
       
               # Analytics remain fully functional.
    1:         conn = db.open_db(self.db_path)
    1:         try:
    1:             ov = analytics.overview(conn)
    1:             inv = analytics.inventory(conn)
               finally:
    1:             conn.close()
    1:         self.assertEqual(ov["total_transactions"], 6)
    1:         self.assertTrue(inv["by_commodity"])
       
               # Monitoring still detects conditions deterministically.
    1:         outcome = monitoring.run_monitoring(db_path=self.db_path, generator=boom)
    1:         self.assertGreaterEqual(outcome["created"] + outcome["updated"], 1)
       
    1:     def test_monitoring_failure_keeps_existing_alerts(self):
    1:         first = monitoring.run_monitoring(db_path=self.db_path)
    1:         self.assertGreaterEqual(first["created"], 1)
       
               # A hard failure inside the engine (injected) must not delete alerts.
    1:         original = monitoring._inventory_candidates
       
    1:         def boom(conn, rules):
    1:             raise RuntimeError("inventory query exploded")
       
    1:         monitoring._inventory_candidates = boom
    1:         try:
    1:             with self.assertRaises(RuntimeError):
    2:                 monitoring.run_monitoring(db_path=self.db_path)
               finally:
    1:             monitoring._inventory_candidates = original
       
    1:         conn = db.open_db(self.db_path)
    1:         try:
    3:             count = conn.execute(
    2:                 "SELECT COUNT(*) AS n FROM alerts").fetchone()["n"]
    2:             run_row = conn.execute(
    1:                 "SELECT status FROM data_imports WHERE id = ?",
    1:                 (self.imp_id,)).fetchone()
               finally:
    1:             conn.close()
    1:         self.assertGreaterEqual(count, 1)
    1:         self.assertEqual(run_row["status"], "COMPLETED")
       
       
