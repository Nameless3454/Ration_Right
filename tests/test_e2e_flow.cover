    1: def _import_and_seed(db_path):
           """Import the CSV and add low-coverage rice inventory; returns import id."""
    5:     up = ingest.handle_upload(TRANSACTION_CSV.encode(), "e2e.csv", "text/csv")
   10:     ingest.validate_step(up["token"], dataset_type="ration_transactions",
    5:                          db_path=db_path)
    5:     summary = ingest.confirm_step(up["token"], db_path=db_path)
    5:     imp_id = summary["data_import_id"]
    5:     conn = db.open_db(db_path)
    5:     try:
   10:         center = conn.execute(
    5:             "SELECT id FROM fps_centers WHERE fps_code = 'FPS01'").fetchone()
   10:         db.insert_inventory_batch(conn, [
   10:             {"fps_center_id": center["id"], "commodity": "rice",
    5:              "current_stock": 500.0, "monthly_consumption": 1200.0,
    5:              "reorder_threshold": 800.0, "source_import_id": imp_id},
               ])
    5:         conn.commit()
           finally:
    5:         conn.close()
    5:     return imp_id
       
       
