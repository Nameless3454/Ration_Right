    1:     def test_seed_synthetic_round_trip(self):
    1:         summary = db.seed_synthetic(self.conn)
    1:         self.assertEqual(summary["transactions"], 25)
    1:         self.assertEqual(summary["beneficiaries"], 5)
    1:         self.assertEqual(summary["fps_centers"], 0)
    1:         self.assertEqual(summary["inventory"], 0)
    1:         self.assertEqual(summary["ai_insights"], 0)
       
               # agent-contract export equals the source JSON exactly
    1:         agent_rows = db.get_transactions_for_agent(self.conn)
    1:         raw = load_dataset(DEFAULT_DATASET_PATH)["transactions"]
    1:         self.assertEqual(len(agent_rows), len(raw))
   26:         for got, expected in zip(agent_rows, raw):
   25:             self.assertEqual(got["transaction_id"], expected["transaction_id"])
   25:             self.assertEqual(got["beneficiary_id"], expected["beneficiary_id"])
   25:             self.assertEqual(got["timestamp"], expected["timestamp"])
   25:             self.assertEqual(got["latitude"], expected["latitude"])
   25:             self.assertEqual(got["longitude"], expected["longitude"])
   25:             self.assertEqual(got["ration_type"], expected["ration_type"])
   25:             self.assertEqual(got["quantity"], expected["quantity"])
       
               # provenance chain: transaction -> import -> source
    1:         tx = db.get_transaction_by_external_id(self.conn, "TX001")
    1:         self.assertIsNotNone(tx)
    1:         imp = db.get_data_import(self.conn, tx["source_import_id"])
    1:         self.assertEqual(imp["dataset_name"], "rationright-synthetic-transactions")
    1:         src = db.get_data_source(self.conn, imp["data_source_id"])
    1:         self.assertEqual(src["name"], db.SYNTHETIC_SOURCE_NAME)
    1:         self.assertEqual(src["type"], "JSON")
    1:         self.assertEqual(imp["status"], "COMPLETED")
    1:         self.assertEqual(imp["successful_records"], 25)
       
               # all 25 transactions point at the one import
    3:         count = self.conn.execute(
    1:             "SELECT COUNT(*) AS n FROM ration_transactions WHERE source_import_id = :iid",
    1:             {"iid": imp["id"]},
    1:         ).fetchone()["n"]
    1:         self.assertEqual(count, 25)
       
               # beneficiaries exported are exactly BEN001..BEN005
    7:         refs = sorted(b["external_reference"] for b in db.list_beneficiaries(self.conn))
    1:         self.assertEqual(refs, ["BEN001", "BEN002", "BEN003", "BEN004", "BEN005"])
       
    1:     def test_seed_synthetic_is_idempotent(self):
    1:         db.seed_synthetic(self.conn)
