    1:         db.seed_synthetic(self.conn)
    2:         self.assertEqual(
    1:             self.conn.execute("SELECT COUNT(*) AS n FROM data_sources").fetchone()["n"], 1
               )
    2:         self.assertEqual(
    1:             self.conn.execute("SELECT COUNT(*) AS n FROM data_imports").fetchone()["n"], 1
               )
    2:         self.assertEqual(
    1:             self.conn.execute("SELECT COUNT(*) AS n FROM ration_transactions").fetchone()["n"], 25
               )
    2:         self.assertEqual(
    1:             self.conn.execute("SELECT COUNT(*) AS n FROM beneficiaries").fetchone()["n"], 5
               )
       
