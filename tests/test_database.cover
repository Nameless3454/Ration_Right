    2: class SeedDatabaseSmokeTest(unittest.TestCase):
    1:     """End-to-end: seed via the public entry point on a temp file."""
       
    1:     def test_seed_database_entry_point(self):
    1:         with tempfile.TemporaryDirectory() as tmp:
    1:             db_path = Path(tmp) / "seed.db"
    1:             summary = db.seed_database(db_path=db_path)
    1:             self.assertEqual(summary["transactions"], 25)
    1:             conn = db.connect(db_path)
    1:             try:
    1:                 n = conn.execute("SELECT COUNT(*) AS n FROM ration_transactions").fetchone()["n"]
    1:                 self.assertEqual(n, 25)
                   finally:
    1:                 conn.close()
       
       
    1: if __name__ == "__main__":
           unittest.main()
