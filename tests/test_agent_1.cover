    2: class TestAgent1BeneficiaryIsolation(unittest.TestCase):
    1:     """TEST 3 — transactions from different beneficiaries are never compared."""
       
    1:     def test_cross_beneficiary_near_simultaneous_far_apart_is_not_flagged(self):
    1:         transactions = [
    1:             tx("TX200", "BEN900", "2026-08-01T10:00:00", 19.0760, 72.8777),  # Mumbai
    1:             tx("TX201", "BEN901", "2026-08-01T10:05:00", 28.6139, 77.2090),  # Delhi
               ]
    1:         result = Agent1TransactionAnalyst().run(transactions)
    1:         self.assertEqual(result, {"anomalies": []})
       
    1:     def test_same_beneficiary_short_and_far_is_flagged(self):
    1:         transactions = [
    1:             tx("TX202", "BEN900", "2026-08-01T10:00:00", 19.0760, 72.8777),
    1:             tx("TX203", "BEN900", "2026-08-01T10:05:00", 28.6139, 77.2090),
               ]
    1:         result = Agent1TransactionAnalyst().run(transactions)
    1:         self.assertEqual(len(result["anomalies"]), 1)
    1:         self.assertEqual(result["anomalies"][0]["beneficiary_id"], "BEN900")
    1:         self.assertEqual(result["anomalies"][0]["transaction_ids"], ["TX202", "TX203"])
       
       
