    2: class TestAgent1ThresholdBoundary(unittest.TestCase):
    1:     """TEST 7 — behavior around the configured thresholds is deterministic."""
       
    1:     def test_interval_at_threshold_inclusive(self):
               # Exactly 60 minutes apart and ~100.08 km apart: both inclusive bounds hold.
    1:         transactions = [
    1:             tx("TX500", "BEN900", "2026-08-01T10:00:00", 0.0, 0.0),
    1:             tx("TX501", "BEN900", "2026-08-01T11:00:00", 0.9, 0.0),
               ]
    1:         result = Agent1TransactionAnalyst().run(transactions)
    1:         self.assertEqual(len(result["anomalies"]), 1)
       
    1:     def test_distance_just_below_threshold_not_flagged(self):
               # ~99.96 km apart: just under the 100 km inclusive bound.
    1:         transactions = [
    1:             tx("TX502", "BEN900", "2026-08-01T10:00:00", 0.0, 0.0),
    1:             tx("TX503", "BEN900", "2026-08-01T11:00:00", 0.899, 0.0),
               ]
    1:         result = Agent1TransactionAnalyst().run(transactions)
    1:         self.assertEqual(result, {"anomalies": []})
       
    1:     def test_interval_just_above_threshold_not_flagged(self):
               # 60.02 minutes apart: just over the 60 min inclusive bound.
    1:         transactions = [
    1:             tx("TX504", "BEN900", "2026-08-01T10:00:00", 0.0, 0.0),
    1:             tx("TX505", "BEN900", "2026-08-01T11:00:01", 2.0, 0.0),
               ]
    1:         result = Agent1TransactionAnalyst().run(transactions)
    1:         self.assertEqual(result, {"anomalies": []})
       
    1:     def test_thresholds_are_configurable(self):
    1:         transactions = [
    1:             tx("TX506", "BEN900", "2026-08-01T10:00:00", 0.0, 0.0),
    1:             tx("TX507", "BEN900", "2026-08-01T10:45:00", 2.0, 0.0),  # 45 min, ~222 km
               ]
    1:         default = Agent1TransactionAnalyst().run(transactions)
    1:         strict = Agent1TransactionAnalyst(max_interval_minutes=30).run(transactions)
    1:         self.assertEqual(len(default["anomalies"]), 1)
    1:         self.assertEqual(strict, {"anomalies": []})
       
       
