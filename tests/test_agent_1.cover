    2: class TestAgent1NormalData(unittest.TestCase):
    1:     """TEST 2 — normal data produces no false high-risk anomaly."""
       
    1:     def test_real_dataset_without_planted_pair_has_no_anomalies(self):
    1:         dataset = load_dataset(DEFAULT_DATASET_PATH)
   28:         transactions = [
   26:             t for t in dataset["transactions"] if t["transaction_id"] not in ("TX001", "TX002")
               ]
    1:         result = Agent1TransactionAnalyst().run(transactions)
    1:         self.assertEqual(result, {"anomalies": []})
       
    1:     def test_plain_normal_records_have_no_anomalies(self):
