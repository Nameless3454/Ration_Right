    1:         self.assertEqual(upload["record_count"], 3)
    1:         self.assertEqual(upload["dataset_type"], "ration_transactions")
    1:         token = upload["token"]
       
               # 2. validate
    2:         status, body = http_request(
    1:             "POST", self.base + "/api/uploads/%s/validate" % token,
    1:             data=json.dumps({"dataset_type": "ration_transactions"}).encode("utf-8"),
    1:             headers={"Content-Type": "application/json"},
               )
    1:         self.assertEqual(status, 200)
