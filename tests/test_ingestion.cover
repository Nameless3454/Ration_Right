    1:     def test_large_dataset_import(self):
               # Distinct quantities keep every composite key unique (a repeated
               # composite under a different id would be a POSSIBLE duplicate).
    1:         rows = ["id,fps,date,commodity,quantity"]
10003:         rows.extend(
10000:             "T%05d,FPS01,2026-08-01,rice,%d" % (i, (i % 10000) + 1)
10001:             for i in range(1, 10001)
               )
    1:         csv = "\n".join(rows) + "\n"
    1:         upload, validated = self._upload_and_validate(csv.encode("utf-8"), "large.csv")
    1:         self.assertEqual(validated["valid_records"], 10000)
    1:         summary = service.confirm_step(upload["token"], db_path=self.db_path)
    1:         self.assertEqual(summary["status"], "COMPLETED")
    1:         self.assertEqual(summary["imported"], 10000)
    1:         self.assertLess(summary["processing_time_seconds"], 30)
