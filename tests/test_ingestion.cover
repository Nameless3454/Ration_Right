           # 9. Duplicate classification
    1:     def test_duplicate_classification(self):
    1:         headers = ["id", "fps", "date", "commodity", "quantity"]
    2:         mapping = {"id": "external_transaction_id", "fps": "fps_center_id",
    1:                    "date": "transaction_date", "commodity": "commodity", "quantity": "quantity"}
    1:         rows = [
    1:             ["T1", "FPS01", "2026-08-01", "rice", "10"],
    1:             ["T1", "FPS01", "2026-08-01", "rice", "10"],   # EXACT (same id)
    1:             ["T2", "FPS01", "2026-08-01", "rice", "10"],   # POSSIBLE (same content, new id)
    1:             ["T3", "FPS01", "2026-08-02", "wheat", "5"],   # UNIQUE
               ]
    1:         result = validation.classify_duplicates(rows, "ration_transactions", headers, mapping)
    1:         self.assertEqual(result["unique"], 2)
    1:         self.assertEqual(result["exact"], 1)
    1:         self.assertEqual(result["possible"], 1)
       
           # 13. Quality score — transparent, deterministic formula
    1:     def test_quality_score_formula(self):
    1:         self.assertEqual(validation.quality_score(total=100, invalid=0, duplicates=0, warnings=0), 100.0)
    1:         self.assertEqual(validation.quality_score(total=100, invalid=1, duplicates=0, warnings=0), 97.0)
    1:         self.assertEqual(validation.quality_score(total=100, invalid=0, duplicates=1, warnings=0), 98.0)
    1:         self.assertEqual(validation.quality_score(total=100, invalid=0, duplicates=0, warnings=1), 99.5)
    1:         self.assertEqual(validation.quality_score(total=100, invalid=50, duplicates=0, warnings=0), 0.0)  # clamped
               # same input -> same score (deterministic, no randomness)
    2:         self.assertEqual(validation.quality_score(124821, 181, 128, 34),
    1:                          validation.quality_score(124821, 181, 128, 34))
               # 100 - (3*1% invalid + 2*1% duplicates + 0.5*2% warnings) = 94
    1:         report = validation.quality_report(100, invalid=1, duplicates=1, warnings=2)
    1:         self.assertEqual(report["score"], 94.0)
    1:         self.assertEqual(report["valid_pct"], 98.0)
       
       
