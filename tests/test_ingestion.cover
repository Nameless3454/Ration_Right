    1:         cls.db_path = Path(cls._tmp.name) / "api.db"
    1:         cls.server = make_server("127.0.0.1", 0, db_path=cls.db_path)
    1:         cls.port = cls.server.server_address[1]
    1:         cls.base = "%s:%d" % (BASE, cls.port)
    1:         cls.thread = threading.Thread(target=cls.server.serve_forever, daemon=True)
    1:         cls.thread.start()
       
    1:     @classmethod
    1:     def tearDownClass(cls):
    1:         cls.server.shutdown()
    1:         cls.server.server_close()
    1:         cls._tmp.cleanup()
       
    1:     def test_full_api_flow_with_real_csv(self):
               # 1. upload
