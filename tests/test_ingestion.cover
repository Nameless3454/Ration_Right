    1:             data=b"{}", headers={"Content-Type": "application/json"},
               )
    1:         self.assertEqual(status, 200)
    1:         summary = json.loads(body)
    1:         self.assertEqual(summary["status"], "COMPLETED")
    1:         self.assertEqual(summary["imported"], 3)
       
               # 4. history + status
