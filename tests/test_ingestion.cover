    1:     def _upload_and_validate(self, data: bytes, filename: str, dataset_type=None, mapping=None):
   14:         upload = service.handle_upload(data, filename, "application/octet-stream")
   14:         self.addCleanup(cleanup_upload, upload["token"])
   28:         validated = service.validate_step(
   14:             upload["token"], dataset_type=dataset_type or upload["dataset_type"],
   14:             mapping=mapping, db_path=self.db_path,
               )
   14:         return upload, validated
       
