    1:         self.assertEqual(validation.normalize_string("rice")[0], "rice")  # case kept for non-geo
    1:         self.assertEqual(validation.normalize_string(""), (None, False, None))
               # abbreviations are preserved (state codes must not become "Up")
    1:         self.assertEqual(validation.normalize_string("UP", title=True)[0], "UP")
    1:         self.assertEqual(validation.normalize_string("   ")[0], None)
       
