    1:     def test_duplicate_against_existing_database(self):
               # Import once, then import the same file again: idempotent — the
               # second upload of identical bytes (same file hash) is refused and
               # points at the existing import instead of duplicating records.
    1:         csv = "id,fps,date,commodity,quantity\nT1,FPS01,2026-08-01,rice,10\n"
    1:         upload, _ = self._upload_and_validate(csv.encode("utf-8"), "once.csv")
    1:         first = service.confirm_step(upload["token"], db_path=self.db_path)
    1:         self.assertEqual(first["status"], "COMPLETED")
    1:         self.assertEqual(first["imported"], 1)
    1:         upload2, validated2 = self._upload_and_validate(csv.encode("utf-8"), "twice.csv")
               # the validate step already flags the repeated dataset
    1:         self.assertIsNotNone(validated2["already_imported"])
    1:         self.assertEqual(validated2["already_imported"]["data_import_id"], first["data_import_id"])
    1:         summary2 = service.confirm_step(upload2["token"], db_path=self.db_path)
    1:         self.assertEqual(summary2["status"], "ALREADY_IMPORTED")
    1:         self.assertEqual(summary2["existing_import"]["data_import_id"], first["data_import_id"])
    1:         conn = db.open_db(self.db_path)
    1:         try:
    1:             self.assertEqual(len(db.get_transactions_for_agent(conn)), 1)
               finally:
    1:             conn.close()
       
