    2: class TestValidation(unittest.TestCase):
    1:     def test_quantity_with_commas_and_units(self):
    1:         self.assertEqual(validation.parse_number("1,200"), 1200.0)
    1:         self.assertEqual(validation.parse_number("1200 kg"), 1200.0)
    1:         self.assertEqual(validation.parse_number(42), 42.0)
    1:         self.assertIsNone(validation.parse_number("abc"))
       
    1:     def test_dates_iso_and_excel_serial(self):
    1:         self.assertEqual(validation.parse_date("2026-08-01"), "2026-08-01")
    1:         self.assertEqual(validation.parse_date("2026/08/01"), "2026-08-01")
    1:         self.assertEqual(validation.parse_date("01/08/2026"), "2026-08-01")
    1:         self.assertEqual(validation.parse_date("2026-08-01T10:00:00"), "2026-08-01T10:00:00")
    1:         self.assertEqual(validation.parse_date(45200), "2023-10-01")
    1:         self.assertIsNone(validation.parse_date("not-a-date"))
    1:         self.assertIsNone(validation.parse_date(99999999))
       
    1:     def test_validate_transaction_record(self):
    2:         good = {"external_transaction_id": "T1", "beneficiary_id": "B1",
    1:                 "fps_center_id": "FPS01", "transaction_date": "2026-08-01",
    1:                 "commodity": "rice", "quantity": "10"}
    1:         normalized, errors, _ = validation.validate_record(good, "ration_transactions")
    1:         self.assertEqual(errors, [])
    1:         self.assertEqual(normalized["quantity"], 10.0)
    1:         self.assertNotIn("status", normalized)  # absent status is left unset (defaults later)
       
    1:         bad_qty = dict(good, quantity="abc")
    1:         _, errors, _ = validation.validate_record(bad_qty, "ration_transactions")
    2:         self.assertTrue(any("not numeric" in e for e in errors))
       
    1:         bad_date = dict(good, transaction_date="31-13-2020")
    1:         _, errors, _ = validation.validate_record(bad_date, "ration_transactions")
    2:         self.assertTrue(any("not a valid date" in e for e in errors))
       
    8:         missing = {k: v for k, v in good.items() if k != "quantity"}
    1:         _, errors, _ = validation.validate_record(missing, "ration_transactions")
    2:         self.assertTrue(any("missing required" in e for e in errors))
       
    1:     def test_status_validation(self):
    2:         rec = {"fps_center_id": "FPS01", "transaction_date": "2026-08-01",
    1:                "commodity": "rice", "quantity": 1, "status": "REFUNDED"}
    1:         _, errors, _ = validation.validate_record(rec, "ration_transactions")
    2:         self.assertTrue(any("status" in e for e in errors))
    1:         rec2 = dict(rec, status="cancelled")
    1:         normalized, errors, _ = validation.validate_record(rec2, "ration_transactions")
    1:         self.assertEqual(errors, [])
    1:         self.assertEqual(normalized["status"], "CANCELLED")
       
       
