    1: def http_request(method, url, data=None, headers=None):
   14:     headers = dict(headers or {})
   14:     req = urllib.request.Request(url, data=data, method=method, headers=headers)
   14:     try:
   14:         with urllib.request.urlopen(req, timeout=60) as response:
    7:             return response.status, response.read().decode("utf-8")
    7:     except urllib.error.HTTPError as exc:
    7:         return exc.code, exc.read().decode("utf-8")
       
       
    2: class TestIngestionAPI(unittest.TestCase):
