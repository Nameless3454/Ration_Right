    1: def write_temp(data: bytes, suffix: str) -> Path:
   16:     fd, path = tempfile.mkstemp(suffix=suffix)
   16:     with os.fdopen(fd, "wb") as fh:
   16:         fh.write(data)
   16:     return Path(path)
       
       
    1: def _col_letter(index: int) -> str:
   27:     out = ""
   27:     index += 1
   54:     while index:
   27:         index, remainder = divmod(index - 1, 26)
   27:         out = chr(65 + remainder) + out
   27:     return out
       
       
    1: def _cell_xml(ref: str, value):
