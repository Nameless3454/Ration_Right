    2: class Phase4NormalizationTests(unittest.TestCase):
           # 1. Column normalization (extendable alias table)
    1:     def test_column_name_normalization(self):
    1:         fps_aliases = ["FPS Code", "FPS_ID", "FPS Id", "Fair Price Shop Code"]
    1:         district_aliases = ["District", "District Name", "District_Name"]
    1:         qty_aliases = ["Qty", "Quantity", "Quantity Distributed", "Qty Distributed"]
    1:         date_aliases = ["Date", "Transaction Date", "Transaction_Date"]
    5:         for header in fps_aliases:
    4:             mapping = mapmod.detect_mapping([header], "ration_transactions")
    4:             self.assertEqual(mapping["mapping"][0]["internal"], "fps_center_id", header)
    4:         for header in district_aliases:
    3:             mapping = mapmod.detect_mapping([header], "ration_transactions")
    3:             self.assertEqual(mapping["mapping"][0]["internal"], "district", header)
    5:         for header in qty_aliases:
    4:             mapping = mapmod.detect_mapping([header], "ration_transactions")
    4:             self.assertEqual(mapping["mapping"][0]["internal"], "quantity", header)
    4:         for header in date_aliases:
    3:             mapping = mapmod.detect_mapping([header], "ration_transactions")
    3:             self.assertEqual(mapping["mapping"][0]["internal"], "transaction_date", header)
               # each internal field is used at most once — a later alias for an
               # already-mapped field resolves to ignore
    1:         mapping = mapmod.detect_mapping(["FPS Code", "FPS_ID"], "ration_transactions")
    4:         internals = [m["internal"] for m in mapping["mapping"]]
    1:         self.assertEqual(internals, ["fps_center_id", None])
       
