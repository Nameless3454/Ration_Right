    2: class TestAgent3EvidenceConsistency(unittest.TestCase):
    1:     """TEST 5 — Agent 2's numerical evidence is preserved unchanged."""
       
    1:     def test_case_preserves_agent_2_values_exactly(self):
    1:         finding, transactions = real_finding()
