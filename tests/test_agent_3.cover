    1:             {"findings": [finding], "transactions": transactions}
               )
    4:         values = {e["type"]: e["value"] for e in case["evidence"]}
    1:         self.assertEqual(values["time_difference"], finding["evidence"]["time_difference_minutes"])
    1:         self.assertEqual(values["distance"], finding["evidence"]["distance_km"])
       
       
    2: class TestAgent3NoFabrication(unittest.TestCase):
    1:     """TEST 6 — every fact in the case exists in the supplied input."""
       
    1:     def test_summary_facts_come_from_input(self):
    1:         finding, transactions = real_finding()
    2:         case = Agent3EvidenceCaseBuilder().run(
    1:             {"findings": [finding], "transactions": transactions}
               )
    1:         summary_ids = set(re.findall(r"TX\d{3}", case["summary"]))
    1:         self.assertTrue(summary_ids.issubset(set(finding["transaction_ids"])))
    1:         summary_beneficiaries = set(re.findall(r"BEN\d{3}", case["summary"]))
   27:         real_beneficiaries = {t["beneficiary_id"] for t in transactions}
    1:         self.assertTrue(summary_beneficiaries.issubset(real_beneficiaries))
       
       
    2: class TestAgent3MultipleFindings(unittest.TestCase):
    1:     """TEST 7 — multiple findings are aggregated without mixing evidence."""
       
    1:     def test_evidence_from_multiple_findings_stays_separate(self):
    2:         finding_a = make_finding("FIND001", "ANOM001", transaction_ids=("TX001", "TX002"),
    1:                                  evidence={"time_difference_minutes": 12.0, "distance_km": 1148.09})
    2:         finding_b = make_finding("FIND002", "ANOM002", transaction_ids=("TX010", "TX011"),
    1:                                  evidence={"time_difference_minutes": 25.0, "distance_km": 500.5})
    1:         transactions = [
    1:             make_tx("TX001", "BEN001", "2026-08-01T10:00:00", 19.0760, 72.8777),
    1:             make_tx("TX002", "BEN001", "2026-08-01T10:12:00", 28.6139, 77.2090),
    1:             make_tx("TX010", "BEN003", "2026-08-03T09:00:00", 28.6139, 77.2090),
    1:             make_tx("TX011", "BEN003", "2026-08-03T09:25:00", 19.0760, 72.8777),
               ]
    2:         case = Agent3EvidenceCaseBuilder().run(
    1:             {"findings": [finding_a, finding_b], "transactions": transactions}
               )
    1:         self.assertEqual(case["status"], "requires_human_review")
    1:         self.assertEqual(case["finding_ids"], ["FIND001", "FIND002"])
    6:         values = [e["value"] for e in case["evidence"]]
    1:         self.assertEqual(values, [12.0, 1148.09, 25.0, 500.5])
       
       
    2: class TestAgent3Agent2Compatibility(unittest.TestCase):
    1:     """TEST 8 — Agent 3 consumes actual Agent 2 output without rewriting."""
       
    1:     def test_consumes_actual_agent_2_output(self):
    1:         finding, transactions = real_finding()
    1:         self.assertEqual(finding["status"], "verified")
    2:         case = Agent3EvidenceCaseBuilder().run(
    1:             {"findings": [finding], "transactions": transactions}
               )
    1:         self.assertEqual(case["status"], "requires_human_review")
    1:         self.assertEqual(case["finding_ids"], [finding["finding_id"]])
       
    1:     def test_single_finding_input_shape(self):
    1:         finding, transactions = real_finding()
    2:         case = Agent3EvidenceCaseBuilder().run(
    1:             {"finding": finding, "transactions": transactions}
               )
    1:         self.assertEqual(case["status"], "requires_human_review")
       
       
    2: class TestAgent3InvalidInput(unittest.TestCase):
    1:     """Malformed input produces clear validation errors."""
       
    1:     def test_invalid_input_raises(self):
    1:         builder = Agent3EvidenceCaseBuilder()
    1:         with self.assertRaises(ValueError):
    2:             builder.run("not-a-payload")
    1:         with self.assertRaises(ValueError):
    2:             builder.run({})
    1:         with self.assertRaises(ValueError):
    2:             builder.run({"findings": []})
    1:         with self.assertRaises(ValueError):
    2:             builder.run({"findings": ["not-a-dict"]})
    1:         with self.assertRaises(ValueError):
    2:             builder.run({"findings": [make_finding(status="bogus")]})
    1:         with self.assertRaises(ValueError):
    2:             builder.run({"findings": [make_finding(evidence={"time_difference_minutes": "abc", "distance_km": 1})]})
       
       
