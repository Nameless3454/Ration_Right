    1: def make_finding(finding_id="FIND001", anomaly_id="ANOM001", status="verified",
                        transaction_ids=("TX001", "TX002"), evidence=None, evidence_sources=None,
                        explanation="test explanation"):
    7:     return {
    7:         "finding_id": finding_id,
    7:         "anomaly_id": anomaly_id,
    7:         "status": status,
    7:         "transaction_ids": list(transaction_ids),
    7:         "evidence": evidence if evidence is not None
    2:                     else {"time_difference_minutes": 12.0, "distance_km": 1148.09},
    7:         "evidence_sources": list(evidence_sources)
   12:                             if evidence_sources is not None else list(transaction_ids),
    7:         "explanation": explanation,
           }
       
       
    1: def real_finding():
           """Run the real Agent 1 + Agent 2 chain to produce a genuine finding."""
    5:     dataset = load_dataset(DEFAULT_DATASET_PATH)
    5:     transactions = dataset["transactions"]
    5:     anomalies = Agent1TransactionAnalyst().run(transactions)["anomalies"]
   10:     finding = Agent2AnomalyInvestigator().run(
    5:         {"anomaly": anomalies[0], "transactions": transactions}
           )
    5:     return finding, transactions
       
       
    2: class TestAgent3VerifiedFinding(unittest.TestCase):
    1:     """TEST 1 — a real verified finding produces a structured case."""
       
    1:     @classmethod
    1:     def setUpClass(cls):
    1:         cls.finding, cls.transactions = real_finding()
    2:         cls.case = Agent3EvidenceCaseBuilder().run(
    1:             {"findings": [cls.finding], "transactions": cls.transactions}
               )
       
    1:     def test_case_is_created(self):
    1:         self.assertEqual(set(self.case.keys()), CASE_FIELDS)
    1:         self.assertEqual(self.case["case_id"], "CASE001")
    1:         self.assertEqual(self.case["status"], "requires_human_review")
    1:         self.assertEqual(self.case["finding_ids"], ["FIND001"])
       
    1:     def test_evidence_entries(self):
    4:         entries = {e["type"]: e for e in self.case["evidence"]}
    1:         self.assertEqual(entries["time_difference"]["value"], 12.0)
    1:         self.assertEqual(entries["time_difference"]["unit"], "minutes")
    1:         self.assertEqual(entries["distance"]["value"], 1148.09)
    1:         self.assertEqual(entries["distance"]["unit"], "km")
       
    1:     def test_severity_confidence_recommendation(self):
    1:         self.assertEqual(self.case["severity"], "high")
    1:         self.assertEqual(self.case["confidence"], 0.9)
    1:         self.assertEqual(self.case["recommended_action"], "Human verification")
       
    1:     def test_summary_is_factual_and_traceable(self):
    1:         summary = self.case["summary"]
    1:         self.assertIn("TX001", summary)
    1:         self.assertIn("TX002", summary)
    1:         self.assertIn("BEN001", summary)
    1:         lowered = summary.lower()
    1:         self.assertNotIn("guilty", lowered)
    1:         self.assertNotIn("fraud", lowered)
    1:         self.assertIn("human review", lowered)
       
       
    2: class TestAgent3Unverified(unittest.TestCase):
    1:     """TEST 2 — an unverified finding is never presented as a verified case."""
       
    1:     def test_unverified_finding_is_not_ready(self):
    1:         finding = make_finding(status="unverified", evidence={}, evidence_sources=[])
    1:         case = Agent3EvidenceCaseBuilder().run({"findings": [finding], "transactions": []})
    1:         self.assertEqual(case["status"], "not_ready")
    1:         self.assertEqual(case["evidence"], [])
    1:         self.assertEqual(case["confidence"], 0.0)
    1:         self.assertIn("unverified", case["summary"].lower())
       
       
    2: class TestAgent3MissingTransaction(unittest.TestCase):
    1:     """TEST 3 — a missing referenced transaction is reported, not invented."""
       
    1:     def test_missing_referenced_transaction(self):
