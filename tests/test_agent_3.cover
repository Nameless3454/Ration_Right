    1:         transactions = [make_tx("TX001", "BEN001", "2026-08-01T10:00:00", 19.0760, 72.8777)]
    2:         case = Agent3EvidenceCaseBuilder().run(
    1:             {"findings": [finding], "transactions": transactions}
               )
    1:         self.assertEqual(case["status"], "not_ready")
    1:         self.assertIn("TX999", case["summary"])
       
       
    2: class TestAgent3MissingEvidence(unittest.TestCase):
