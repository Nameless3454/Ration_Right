   33:         message = self._build_message(case)
   66:         message = maybe_generate(
   33:             "agent_4_message",
   33:             {
   33:                 "alert_id": "ALERT001",
   33:                 "case_id": case["case_id"],
   33:                 "severity": case["severity"],
   33:                 "finding_ids": case["finding_ids"],
