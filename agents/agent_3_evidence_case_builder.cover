           "evidence",
           "confidence",
           "recommended_action",
       )
       
       # Configured deterministic rules (see module docstring).
    1: VERIFIED_CONFIDENCE = 0.9
    1: NOT_READY_CONFIDENCE = 0.0
    1: NOT_READY_SEVERITY = "low"
    1: DEFAULT_SEVERITY = RAPID_GEOGRAPHIC_SEVERITY
       
       
