  967:         for tx in transactions:
  910:             if not isinstance(tx, dict):
    1:                 skipped.append(("<malformed>", "record is not an object"))
    1:                 continue
  909:             issue = self._record_issue(tx)
  909:             if issue is not None:
   18:                 skipped.append((tx.get("transaction_id", "<unknown>"), issue))
   18:                 continue
  891:             comparable.append(tx)
       
   57:         if skipped:
