   55:         return {"anomalies": candidates}
       
    1:     def _build_candidates(self, pairs: list) -> list:
               """Convert matched pairs into contract-compliant anomaly candidates."""
   55:         candidates = []
   96:         for index, pair in enumerate(pairs, start=1):
   82:             candidates.append(
   41:                 {
   41:                     "anomaly_id": f"ANOM{index:03d}",
   41:                     "anomaly_type": self.anomaly_type,
   41:                     "transaction_ids": list(pair["transaction_ids"]),
   41:                     "beneficiary_id": pair["beneficiary_id"],
                           "reason": (
  205:                         f"Two transactions for beneficiary {pair['beneficiary_id']} occurred "
   41:                         f"{pair['time_difference_minutes']:.1f} minutes apart at locations "
   41:                         f"{pair['distance_km']:.2f} km apart, meeting the "
                               f"rapid-geographic-transaction rule (interval <= "
   41:                         f"{self.max_interval_minutes:g} min, distance >= "
   41:                         f"{self.min_distance_km:g} km)."
                           ),
   41:                     "severity": self.severity,
                       }
                   )
   55:         return candidates
       
    1:     @staticmethod
    1:     def _validate_candidates(candidates: list) -> None:
