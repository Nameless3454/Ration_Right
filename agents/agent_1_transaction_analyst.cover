    1:     def run(self, transactions) -> dict:
               """Analyze transaction records and return structured anomaly candidates."""
   63:         if not isinstance(transactions, list):
    5:             raise ValueError("transactions must be a list of transaction objects")
       
   58:         if not transactions:
