               self,
    1:         max_interval_minutes: float = DEFAULT_MAX_INTERVAL_MINUTES,
    1:         min_distance_km: float = DEFAULT_MIN_DISTANCE_KM,
    1:         anomaly_type: str = ANOMALY_TYPE,
    1:         severity: str = DEFAULT_SEVERITY,
           ):
   67:         if max_interval_minutes <= 0:
                   raise ValueError("max_interval_minutes must be positive")
   67:         if min_distance_km <= 0:
                   raise ValueError("min_distance_km must be positive")
   67:         self.max_interval_minutes = max_interval_minutes
   67:         self.min_distance_km = min_distance_km
   67:         self.anomaly_type = anomaly_type
   67:         self.severity = severity
       
    1:     @staticmethod
    1:     def _record_issue(tx: dict):
               """Return a description of missing/invalid data that prevents safe
