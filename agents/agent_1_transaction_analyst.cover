  909:         beneficiary_id = tx.get("beneficiary_id")
  909:         if not isinstance(beneficiary_id, str) or not beneficiary_id:
    1:             return "missing/invalid beneficiary_id"
  908:         raw_timestamp = tx.get("timestamp")
  908:         if not isinstance(raw_timestamp, str) or not raw_timestamp:
